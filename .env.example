# Referencia conjunta. Cada runtime carga el .env de su propia carpeta.

# api/.env
APP_NAME=Carobra Rewards
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://user:password@host/database?sslmode=require
TEST_DATABASE_URL=postgresql+asyncpg://user:password@host/test_database?sslmode=require
AUTH_SESSION_COOKIE_NAME=carobra_session
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_SAME_SITE=lax
# AUTH_SESSION_COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
LEGACY_CUSTOMER_INTAKE_ENABLED=false

# site-backend/.env
API_BASE_URL=http://127.0.0.1:8000
SITE_BACKEND_HOST=127.0.0.1
SITE_BACKEND_PORT=3001
SESSION_COOKIE_NAME=carobra_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_PATH=/
# SESSION_COOKIE_DOMAIN=
API_REQUEST_TIMEOUT_MS=5000
BONDA_BASE_URL=https://apiv1.cuponstar.com
BONDA_ALLOWED_HOSTS=apiv1.cuponstar.com
BONDA_ALLOWED_IMAGE_HOSTS=cuponstar-ar.s3.amazonaws.com
BONDA_REQUEST_TIMEOUT_MS=5000
BONDA_CATALOG_CACHE_TTL_MS=300000
BONDA_CATALOG_CACHE_MAX_STALE_MS=1800000
BONDA_MICROSITE_ID=
BONDA_COUPON_API_KEY=
BONDA_AFFILIATE_TOKEN=
BONDA_CATALOG_ENABLED=false
BONDA_AFFILIATE_PROVISIONING_ENABLED=false
BONDA_COUPON_REQUESTS_ENABLED=false

# site-frontend/.env
SITE_BACKEND_BASE_URL=http://127.0.0.1:3001
