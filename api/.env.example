APP_NAME="Carobra Rewards"
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://user:password@host/database?sslmode=require
TEST_DATABASE_URL=postgresql+asyncpg://user:password@host/test_database?sslmode=require
LEGACY_CUSTOMER_INTAKE_ENABLED=false
AUTH_SESSION_COOKIE_NAME=carobra_session
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_SAME_SITE=lax
# AUTH_SESSION_COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
SISCA_ADAPTER=simulated
SISCA_BASE_URL=
SISCA_VALIDATION_PATH=/afore/ws/ws_datos_por_curp.php
SISCA_AUTH_MODE=api_key
SISCA_API_KEY_HEADER=X-API-Key
SISCA_RESPONSE_FORMAT=business_envelope
SISCA_TRACE_IDENTIFIER=
SISCA_TRACE_IDENTIFIER_HEADER=X-Rewards-Id
SISCA_API_TOKEN=
# UAT HTTP mode uses only SISCA_UAT_API_TOKEN and requires an explicit host
# allowlist. Production uses SISCA_PRODUCTION_API_TOKEN instead.
SISCA_UAT_API_TOKEN=
SISCA_PRODUCTION_API_TOKEN=
SISCA_UAT_ALLOWED_HOSTS=
SISCA_CA_BUNDLE_PATH=
SISCA_PRODUCTION_ALLOWED_HOSTS=
SISCA_UAT_CONTROL_ENABLED=false
SISCA_UAT_AUTHORIZED_OPERATORS=
SISCA_INTERNAL_API_TOKEN=replace-with-a-secret
SISCA_TIMEOUT_SECONDS=5
SISCA_MAX_RETRIES=2
# Production enables the persistent due-checkpoint poller. It remains disabled
# by default in local development and controlled UAT runs.
SISCA_SCHEDULER_ENABLED=false
SISCA_SCHEDULER_POLL_SECONDS=60
SISCA_SCHEDULER_BATCH_SIZE=100
SISCA_KNOWN_MOVEMENT_TYPES=TRASPASO,Traspaso NAP,Registro NAP
SISCA_ALLOWED_MOVEMENT_TYPES=TRASPASO
SISCA_VALIDATED_STATUSES=Certificado,Aceptada Procesar
SISCA_PENDING_STATUSES=Aceptada Operaciones
SISCA_CANCELLED_STATUSES=Cancelada
SISCA_MINIMUM_TRANSFER_DATE=
