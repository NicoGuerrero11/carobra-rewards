# SISCA UAT integration profile. Copy these values into the deployment's secret
# store or its UAT environment configuration; never commit real values.
SISCA_ADAPTER=http
SISCA_BASE_URL=https://www.sis-ca.com.mx:7863
SISCA_VALIDATION_PATH=/afore/ws/ws_datos_por_curp.php
SISCA_UAT_API_TOKEN=<provisioned-by-sisca>
SISCA_AUTH_MODE=api_key
SISCA_API_KEY_HEADER=X-API-Key
SISCA_RESPONSE_FORMAT=business_envelope
SISCA_TRACE_IDENTIFIER=<rewards-identifier-confirmed-by-sisca>
SISCA_TRACE_IDENTIFIER_HEADER=X-Rewards-Id
# SISCA will authorize controlled tests against its operational API. This
# explicit allowlist prevents calls to any host not approved for the pilot.
SISCA_UAT_ALLOWED_HOSTS=www.sis-ca.com.mx
# SISCA currently omits this public DigiCert intermediate from its TLS chain.
# Keep certificate verification enabled and add only the verified intermediate.
SISCA_CA_BUNDLE_PATH=/app/certs/RapidSSLTLSRSACAG1.pem

# Disabled by default. Enable only in Railway UAT after naming the operators
# allowed to run accelerated synthetic checkpoints.
SISCA_UAT_CONTROL_ENABLED=false
SISCA_UAT_AUTHORIZED_OPERATORS=<opaque-operator-id>

# Controls outbound behavior from Rewards to SISCA.
SISCA_TIMEOUT_SECONDS=5
SISCA_MAX_RETRIES=0
SISCA_SCHEDULER_ENABLED=false
SISCA_SCHEDULER_POLL_SECONDS=60
SISCA_SCHEDULER_BATCH_SIZE=100
SISCA_KNOWN_MOVEMENT_TYPES=TRASPASO
SISCA_ALLOWED_MOVEMENT_TYPES=TRASPASO
SISCA_VALIDATED_STATUSES=Certificado
SISCA_PENDING_STATUSES=
SISCA_CANCELLED_STATUSES=
SISCA_MINIMUM_TRANSFER_DATE=

# Used only by the safe UAT connectivity probe. Provision through the secret
# store; do not add a real CURP to a local .env file or a command line.
SISCA_UAT_PROBE_CURP=<synthetic-curp-provided-by-sisca>
