# FastAPI business API.
API_BASE_URL=http://127.0.0.1:8000
SITE_BACKEND_HOST=127.0.0.1
SITE_BACKEND_PORT=3001
# Must match api/AUTH_SESSION_COOKIE_NAME.
SESSION_COOKIE_NAME=carobra_session
# Local HTTP uses false/lax. Production HTTPS should use true.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_PATH=/
# SESSION_COOKIE_DOMAIN=
API_REQUEST_TIMEOUT_MS=5000

# Bonda remains disabled until the matching credentials and safe environment
# are configured. Never expose these values to site-frontend.
BONDA_BASE_URL=https://apiv1.cuponstar.com
BONDA_ALLOWED_HOSTS=apiv1.cuponstar.com
BONDA_ALLOWED_IMAGE_HOSTS=cuponstar-ar.s3.amazonaws.com
BONDA_REQUEST_TIMEOUT_MS=5000
BONDA_CATALOG_CACHE_TTL_MS=300000
BONDA_CATALOG_CACHE_MAX_STALE_MS=1800000
BONDA_MICROSITE_ID=
BONDA_COUPON_API_KEY=
BONDA_AFFILIATE_TOKEN=
# Optional non-customer affiliate approved by Bonda for catalog/detail reads only.
# It is never used to request a customer coupon code or read customer history.
BONDA_CATALOG_AFFILIATE_CODE=
BONDA_CATALOG_ENABLED=false
BONDA_AFFILIATE_PROVISIONING_ENABLED=false
BONDA_COUPON_REQUESTS_ENABLED=false
BONDA_LOCAL_PREVIEW_ENABLED=false
# Same PostgreSQL database used by FastAPI, with the Node-compatible
# postgresql:// scheme (without +asyncpg).
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Enables the real registration -> Invitado -> SISCA -> Bronce flow only in
# development/test. Production activation remains blocked until approval.
# Required to enable referral-link capture. Use at least 32 random bytes.
# REFERRAL_IDENTITY_HMAC_SECRET=
# Dedicated PostgreSQL database used only by migration/integration tests.
# TEST_DATABASE_URL=postgresql://user:password@host/test_database
