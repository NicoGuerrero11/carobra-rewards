{
  "name": "@carobra-rewards/site-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "npm run build && node dist/src/database/cli.js up",
    "db:rollback": "npm run build && node dist/src/database/cli.js down",
    "rewards:backfill": "npm run build && node dist/src/rewards/accounts/backfill-cli.js",
    "rewards:v2:backfill": "npm run build && node dist/src/rewards/v2/backfill-cli.js",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
