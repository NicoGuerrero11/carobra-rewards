{
  "name": "@carobra-rewards/site-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/verify-runtime.mjs --node && astro check && astro build && node scripts/verify-runtime.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:smoke:live": "node tests/support/live-stack-smoke.mjs",
    "check:runtime": "node scripts/verify-runtime.mjs",
    "test:runtime": "node --test tests/tooling/*.test.mjs",
    "test:ssr": "node --test tests/built/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "11.0.11",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@vimeo/player": "^2.30.4",
    "astro": "7.3.5",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@playwright/test": "^1.53.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "24.19.1",
    "typescript": "^5.6.3",
    "tailwindcss": "3.4.19",
    "autoprefixer": "10.5.2",
    "postcss": "8.5.28"
  }
}
