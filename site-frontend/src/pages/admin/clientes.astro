---
import BaseLayout from "../../layouts/BaseLayout.astro";

const user = Astro.locals.user;

const adminUser = {
  id: user?.id ?? "admin-demo-user",
  firstName: user?.firstName ?? "Administrador",
  lastName: user?.lastName ?? "Demo",
  email: user?.email ?? "admin.demo@carobra.test",
};

const adminDisplayName = `${adminUser.firstName} ${adminUser.lastName}`.trim();
const adminInitial = adminDisplayName.charAt(0).toUpperCase() || "A";
---

<BaseLayout title="Clientes | Carobra" description="Seguimiento de clientes en operación de Carobra Rewards.">
  <main id="admin-customers-root" data-user={JSON.stringify(adminUser)} class="admin-home shell py-10 md:py-12">
    <section class="admin-home__topbar" aria-label="Barra superior admin">
      <a href="/admin" class="admin-home__brand-link" aria-label="Inicio admin Carobra">
        <img
          src="/images/carobra-logo-horizontal-cropped.png"
          alt="Carobra Consultores Especializados"
          class="admin-home__brand-logo"
          loading="eager"
          decoding="async"
        />
      </a>
      <nav class="admin-home__topbar-nav" aria-label="Módulos admin">
        <a href="/admin" class="admin-home__topbar-link">Inicio</a>
        <a href="/admin/clientes" class="admin-home__topbar-link is-active" aria-current="page">Clientes</a>
        <a href="/admin/beneficios" class="admin-home__topbar-link">Beneficios</a>
        <a href="/admin/redenciones" class="admin-home__topbar-link">Redenciones</a>
      </nav>
      <div id="admin-profile-menu" class="admin-home__profile-menu-root">
        <button
          id="admin-profile-toggle"
          class="admin-home__profile-toggle"
          type="button"
          aria-expanded="false"
          aria-label="Abrir menú de perfil admin"
        >
          <span class="admin-home__avatar" aria-hidden="true">{adminInitial}</span>
          <span class="admin-home__profile-copy">
            <span class="admin-home__profile-name">{adminDisplayName}</span>
            <span class="admin-home__profile-email">{adminUser.email}</span>
          </span>
        </button>
        <div id="admin-profile-dropdown" class="admin-home__profile-menu" hidden>
          <a href="/admin/perfil" class="admin-home__profile-menu-link">Ver perfil</a>
          <button id="logout" class="admin-home__profile-menu-button" type="button">Cerrar sesión</button>
        </div>
      </div>
    </section>

    <header class="admin-home__header">
      <div>
        <h1 class="admin-home__title">Seguimiento de clientes</h1>
        <p id="customers-session" class="admin-home__session"></p>
      </div>
    </header>

    <section class="admin-home__panel">
      <div class="admin-home__panel-head admin-home__panel-head--stack">
        <div>
          <p class="admin-home__subhead">Búsqueda operativa</p>
          <h2 class="admin-home__panel-title admin-home__panel-title--section">Lista de clientes</h2>
        </div>
        <label class="admin-home__field-label">
          Buscar por nombre, correo o estado
          <input
            id="customer-search"
            class="admin-home__search-input"
            type="search"
            placeholder="Ej. Diego, @carobra.demo, En riesgo"
          />
        </label>
      </div>

      <p id="customer-count" class="admin-home__helper-text"></p>
      <ul id="customers-list" class="admin-home__module-grid"></ul>
    </section>
  </main>

  <script>
    import { fetchAdminRealCustomers, mergeAdminDashboardStateWithRealCustomers } from "../../lib/admin-customers";
    import { getCustomerStatusLabel, loadAdminDemoState, markAdminRouteVisited, searchCustomers } from "../../lib/admin-demo-state";
    import { attachLogoutHandler, requireElement } from "../../lib/client-page-utils";

    const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:4000";
    const root = requireElement<HTMLElement>("#admin-customers-root");
    const searchInput = requireElement<HTMLInputElement>("#customer-search");
    const logoutButton = requireElement<HTMLButtonElement>("#logout");
    const profileMenuRoot = requireElement<HTMLElement>("#admin-profile-menu");
    const profileMenuToggle = requireElement<HTMLButtonElement>("#admin-profile-toggle");
    const profileMenu = requireElement<HTMLElement>("#admin-profile-dropdown");

    const parsedUser = JSON.parse(root.getAttribute("data-user") ?? "{}") as Partial<{
      id: string;
      firstName: string;
      lastName: string;
      email: string;
    }>;

    const user = {
      id: parsedUser.id ?? "admin-demo-user",
      firstName: parsedUser.firstName ?? "Administrador",
      lastName: parsedUser.lastName ?? "Demo",
      email: parsedUser.email ?? "admin.demo@carobra.test",
    };
    let resolvedState = loadAdminDemoState(user);
    let hybridStateLoaded = false;

    async function hydrateCustomersState() {
      const mockState = loadAdminDemoState(user);
      const realCustomers = await fetchAdminRealCustomers(API_BASE_URL);
      const merged = mergeAdminDashboardStateWithRealCustomers(mockState, realCustomers);

      resolvedState = merged.state;
      hybridStateLoaded = true;
    }

    function closeProfileMenu() {
      profileMenu.hidden = true;
      profileMenuToggle.setAttribute("aria-expanded", "false");
    }

    function getStatusStyles(statusLabel: string) {
      if (statusLabel === "En riesgo") {
        return "admin-home__badge admin-home__badge--warning";
      }

      if (statusLabel === "Nueva") {
        return "admin-home__badge admin-home__badge--info";
      }

      return "admin-home__badge admin-home__badge--ok";
    }

    function render(query: string) {
      const state = hybridStateLoaded ? resolvedState : loadAdminDemoState(user);
      const customers = searchCustomers(state, query);

      const sessionEl = document.querySelector("#customers-session");
      const countEl = document.querySelector("#customer-count");
      const listEl = document.querySelector("#customers-list");

      if (!sessionEl || !countEl || !listEl) {
        return;
      }

      sessionEl.textContent = `Sesión activa: ${user.firstName} ${user.lastName} (${user.email})`;
      countEl.textContent = `${customers.length.toLocaleString("es-MX")} cliente(s) visible(s) en esta vista.`;

      listEl.innerHTML =
        customers.length === 0
          ? '<li class="admin-home__empty">No se encontraron clientes para el criterio de búsqueda.</li>'
          : customers
              .map((customer) => {
                const statusLabel = getCustomerStatusLabel(customer.status);
                return `
                  <li class="admin-home__module-card">
                    <div class="admin-home__module-card-head">
                      <p class="admin-home__module-card-title">${customer.firstName} ${customer.lastName}</p>
                      <span class="${getStatusStyles(statusLabel)}">${statusLabel}</span>
                    </div>
                    <p class="admin-home__module-card-meta">${customer.email}</p>
                    <p class="admin-home__module-card-meta">Nivel ${customer.tier} · Última interacción: ${new Date(customer.lastInteractionAt).toLocaleDateString("es-MX")}</p>
                    <p class="admin-home__module-card-copy">${customer.participationNote}</p>
                    <a href="/admin/clientes/${customer.id}" class="admin-home__inline-link">Ver detalle del cliente</a>
                  </li>
                `;
              })
              .join("");
    }

    searchInput.addEventListener("input", () => {
      const query = searchInput.value;
      const params = new URLSearchParams(window.location.search);

      if (query.trim()) {
        params.set("search", query);
      } else {
        params.delete("search");
      }

      const queryString = params.toString();
      window.history.replaceState({}, "", queryString ? `${window.location.pathname}?${queryString}` : window.location.pathname);
      render(query);
    });

    attachLogoutHandler(logoutButton, API_BASE_URL, "/login");

    profileMenuToggle.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();

      const shouldOpen = profileMenu.hidden;
      if (!shouldOpen) {
        closeProfileMenu();
        return;
      }

      profileMenu.hidden = false;
      profileMenuToggle.setAttribute("aria-expanded", "true");
    });

    profileMenu.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) {
        return;
      }

      if (target.closest("a")) {
        closeProfileMenu();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) {
        return;
      }

      if (!profileMenuRoot.contains(target)) {
        closeProfileMenu();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeProfileMenu();
      }
    });

    const initialQuery = new URLSearchParams(window.location.search).get("search") ?? "";
    searchInput.value = initialQuery;
    markAdminRouteVisited(user, "clientes");
    await hydrateCustomersState();
    render(initialQuery);
  </script>
</BaseLayout>
