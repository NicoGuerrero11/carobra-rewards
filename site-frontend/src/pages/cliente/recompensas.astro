---
import ClientShellLayout from "../../layouts/ClientShellLayout.astro";
import { getSiteBackendBaseUrl } from "../../lib/api";
import type { RewardsCustomerPortal } from "../../lib/rewards-customer-portal-contract";
import {
  levelLabel,
  type RewardsJourneySummary,
  type RewardsV2JourneyState,
  type RewardsV2Level,
  type RewardsV2ProductStatus,
} from "../../lib/rewards-v2-contract";

const user = Astro.locals.user;
const eligibility = Astro.locals.rewardsEligibility;
const cookie = Astro.request.headers.get("cookie") ?? "";

interface ActivityDetailsResponse {
  activities: Array<{
    activity_type: string;
    qualifies: boolean;
    occurred_at: string;
  }>;
}

interface MovementDetailsResponse {
  movements: Array<{
    code: string;
    entry_type: string;
    points_delta: string;
    occurred_at: string;
  }>;
}

interface DisplayProduct {
  productType: string;
  status: RewardsV2ProductStatus;
  activatedAt: string | null;
  guidance: string | null;
  levelImpact: string | null;
}

interface DisplayMovement {
  code: string;
  pointsDelta: string;
  occurredAt: string;
}

let journey: RewardsJourneySummary | null = null;
let portal: RewardsCustomerPortal | null = null;
let activityDetails: ActivityDetailsResponse | null = null;
let movementDetails: MovementDetailsResponse | null = null;
let unavailable = false;

try {
  const portalResponse = await fetch(`${getSiteBackendBaseUrl()}/api/v1/rewards/portal`, {
    headers: { cookie },
  });
  if (portalResponse.status === 401) {
    return Astro.redirect("/login?error=unauthenticated");
  }
  if (portalResponse.ok) {
    portal = (await portalResponse.json()) as RewardsCustomerPortal;
    journey = portal.journey;
    activityDetails = portal.activity_details;
    movementDetails = portal.movement_details;
  } else {
    unavailable = true;
  }
} catch {
  unavailable = true;
}

const derivedState: RewardsV2JourneyState = journey?.journey.state
  ?? (eligibility?.reason === "customer_inactive"
    ? "INACTIVE"
    : eligibility?.eligible ? "ACTIVE" : "INVITED");
const currentLevel: RewardsV2Level | null = journey?.journey.current_level ?? null;
const validationStatus = journey?.journey.validation_status ?? "PENDING";
const registeredAt = journey?.journey.registered_at ?? null;
const availablePoints = journey?.points.available ?? null;
const reservedPoints = journey?.points.reserved ?? "0";
const products: DisplayProduct[] = portal
  ? portal.products.map((product) => ({
      productType: product.product_type,
      status: product.status,
      activatedAt: product.activated_at,
      guidance: product.guidance,
      levelImpact: product.level_impact,
    }))
  : journey
  ? journey.products.map((product) => ({ productType: product.product_type, status: product.status, activatedAt: product.activated_at, guidance: null, levelImpact: null }))
  : [];
const movements: DisplayMovement[] = movementDetails
  ? movementDetails.movements.map((movement) => ({
      code: movement.code,
      pointsDelta: movement.points_delta,
      occurredAt: movement.occurred_at,
    }))
  : journey
  ? journey.recent_movements.map((movement) => ({
      code: movement.code,
      pointsDelta: movement.points_delta,
      occurredAt: movement.occurred_at,
    }))
  : [];
const activeProductCount = products.filter((product) => product.status === "ACTIVE").length;
const hasValidatedProduct = activeProductCount > 0;
const hasCalculatedLevel = currentLevel !== null;
const levelTitle = derivedState === "INVITED"
  ? "Invitado"
  : derivedState === "BLOCKED"
    ? "En revisión"
    : derivedState === "INACTIVE"
      ? "Sin producto activo"
      : currentLevel
        ? levelLabel(currentLevel)
        : "Nivel en actualización";
const stateEyebrow = derivedState === "INVITED"
  ? "Bienvenido a Carobra Rewards"
  : derivedState === "BLOCKED"
    ? "Necesitamos revisar tu validación"
    : derivedState === "INACTIVE"
      ? "Tu historial sigue protegido"
      : "Tu cuenta Rewards está activa";
const stateMessage = derivedState === "INVITED"
  ? "Tu registro ya forma parte de Rewards. Estamos validando tu primer producto para activar tu nivel y las funciones disponibles."
  : derivedState === "BLOCKED"
    ? "Nuestro equipo está revisando la validación de tu primer producto. Conservamos tu avance y te avisaremos cuando exista una actualización."
    : derivedState === "INACTIVE"
      ? "Actualmente no encontramos productos activos. Conservamos tus movimientos y volveremos a calcular tu nivel cuando recibamos una reactivación válida."
      : currentLevel
        ? `Tu nivel ${levelLabel(currentLevel)} se calcula con productos activos, permanencia y actividades de perfilamiento.`
        : "Tus productos ya están validados. Estamos actualizando tu nivel con la nueva lógica de Rewards.";
const points = (value: string | null | undefined) => value === null || value === undefined
  ? "—"
  : new Intl.NumberFormat("es-MX").format(BigInt(value));
const date = (value: string) => new Intl.DateTimeFormat("es-MX", {
  dateStyle: "medium",
}).format(new Date(value));
const productName = (value: string) => ({
  AFORE: "AFORE",
  PPR: "Plan personal de retiro",
  AUTO_POLICY: "Seguro de auto",
  ADDITIONAL_PRODUCT: "Producto Carobra",
}[value] ?? value.replaceAll("_", " "));
const productStatus = (value: RewardsV2ProductStatus) => ({
  ACTIVE: "Activo",
  PENDING: "En validación",
  SIGNED: "Firmado",
  REJECTED: "No aprobado",
  CANCELLED: "Cancelado",
  ENDED: "Finalizado",
}[value]);
const movementName = (code: string) => ({
  V2_INVITED_REGISTRATION: "Bienvenida a Carobra Rewards",
  V2_INITIAL_PRODUCT_ACTIVE: "Primer producto validado",
  REGISTRATION_ACTIVATION: "Bienvenida a Carobra Rewards",
  ISSUANCE: "Puntos obtenidos",
  CONSUMPTION: "Canje de puntos",
  EXPIRATION: "Puntos vencidos",
  ADJUSTMENT: "Ajuste de puntos",
  REFUND: "Reembolso",
}[code] ?? code.replaceAll("_", " "));
const activityName = (code: string) => ({
  QUESTIONNAIRE_COMPLETED: "Cuestionario completado",
  CONTENT_VIEWED: "Contenido consultado",
  DOCUMENT_UPLOADED: "Documento agregado",
  PROFILE_UPDATED: "Perfil actualizado",
}[code] ?? code.replaceAll("_", " "));
const levelSequence: Array<{ code: RewardsV2Level; label: string }> = [
  { code: "BRONZE", label: "Bronce" },
  { code: "SILVER", label: "Plata" },
  { code: "GOLD", label: "Oro" },
  { code: "PLATINUM", label: "Platino" },
  { code: "TITANIUM", label: "Titanio" },
];
---

<ClientShellLayout
  title="Mis Rewards | Carobra"
  description="Consulta tu nivel, puntos y avance en Carobra Rewards."
  currentPath="/cliente/recompensas"
  sectionLabel="Mis Rewards"
>
  <main class="rewards-page">
    <header class="rewards-welcome">
      <div>
        <p>Carobra Rewards</p>
        <h1>Hola, {user?.firstName ?? "cliente"}</h1>
      </div>
    </header>

    {unavailable && !journey ? (
      <section class="rewards-error" role="status">
        <div aria-hidden="true">!</div>
        <div>
          <h2>No pudimos actualizar tu cuenta</h2>
          <p>Tu información sigue protegida. Intenta actualizar la página en unos minutos.</p>
        </div>
      </section>
    ) : (
      <>
        <section id="resumen" class:list={["rewards-hero", `is-${derivedState.toLowerCase()}`]} aria-labelledby="rewards-level-title">
          <div class="rewards-hero__copy">
            <p class="rewards-eyebrow">{stateEyebrow}</p>
            <h2 id="rewards-level-title">{levelTitle}</h2>
            <p>{stateMessage}</p>
            <div class="rewards-tags" aria-label="Estado de Rewards">
              <span>{validationStatus === "VALIDATED" ? "Producto validado" : "Validación en proceso"}</span>
              <span>{activeProductCount} {activeProductCount === 1 ? "producto activo" : "productos activos"}</span>
              {registeredAt && <span>Desde {date(registeredAt)}</span>}
            </div>
            {derivedState === "BLOCKED" && (
              <a class="rewards-support-link" href="mailto:soporte@carobra.mx">Contactar soporte</a>
            )}
          </div>
          <article class="rewards-balance" aria-labelledby="balance-title">
            <p id="balance-title">Saldo disponible</p>
            <strong>{points(availablePoints)} <small>pts</small></strong>
            <span>{availablePoints === null
              ? "Tu saldo aparecerá cuando terminemos de preparar tu cuenta."
              : BigInt(reservedPoints) > 0n
                ? `${points(reservedPoints)} puntos están reservados.`
                : journey?.redemption.eligible
                  ? "Puedes usar tus puntos en las opciones disponibles."
                  : "Puedes consultar tus puntos; el canje aún no está disponible."}</span>
          </article>
        </section>

        <section class="journey-track" aria-label="Etapas de tu experiencia Rewards">
          <article class="is-complete">
            <span aria-hidden="true">✓</span>
            <div><strong>Registro completado</strong><small>Ya formas parte de Rewards</small></div>
          </article>
          <article class:list={[hasValidatedProduct && "is-complete"]}>
            <span aria-hidden="true">{hasValidatedProduct ? "✓" : "2"}</span>
            <div><strong>Producto validado</strong><small>{hasValidatedProduct ? "Confirmado por Carobra" : "Estamos esperando la confirmación"}</small></div>
          </article>
          <article class:list={[hasCalculatedLevel && "is-complete"]}>
            <span aria-hidden="true">{hasCalculatedLevel ? "✓" : "3"}</span>
            <div><strong>Nivel calculado</strong><small>{hasCalculatedLevel ? levelLabel(currentLevel) : "Se actualizará con tu actividad"}</small></div>
          </article>
        </section>

        {portal && (
          <section class="primary-action-panel" aria-labelledby="primary-action-title">
            <div class="primary-action-panel__number" aria-hidden="true">→</div>
            <div>
              <p class="rewards-eyebrow">Tu siguiente acción</p>
              <h2 id="primary-action-title">{portal.primary_action.title}</h2>
              <p>{portal.primary_action.description}</p>
            </div>
            {portal.primary_action.href && <a href={portal.primary_action.href}>Continuar</a>}
          </section>
        )}

        {(derivedState === "INVITED" || derivedState === "BLOCKED") && (
          <section class="validation-dashboard" aria-labelledby="validation-dashboard-title">
            <article class="validation-dashboard__status">
              <p class="rewards-eyebrow">Validación de producto</p>
              <h2 id="validation-dashboard-title">Estamos confirmando tu primer producto</h2>
              <p>
                Puedes entrar a Rewards y consultar tu saldo mientras esperamos la respuesta.
                No necesitas repetir tu registro ni cargar información adicional.
              </p>
              <div class="validation-pulse"><span aria-hidden="true"></span>Validación en curso</div>
            </article>
            <article class="validation-dashboard__access">
              <p class="rewards-eyebrow">Disponible durante la espera</p>
              <ul>
                <li><span aria-hidden="true">✓</span>Consultar tus puntos de bienvenida</li>
                <li><span aria-hidden="true">✓</span>Revisar el estado de tu validación</li>
                <li><span aria-hidden="true">✓</span>Ver los próximos pasos de Rewards</li>
                <li class="is-locked"><span aria-hidden="true">—</span>Canjear beneficios hasta activar un producto</li>
              </ul>
            </article>
          </section>
        )}

        <section class="rewards-grid rewards-grid--summary">
          <article id="nivel" class="rewards-card rewards-progress" aria-labelledby="progress-title">
            <div class="rewards-card__heading">
              <div>
                <p class="rewards-eyebrow">Tu avance</p>
                <h2 id="progress-title">{journey?.progress.target_level
                  ? `Camino a ${levelLabel(journey.progress.target_level)}`
                  : derivedState === "ACTIVE" && currentLevel === "TITANIUM"
                    ? "Alcanzaste el nivel más alto"
                    : "Tu siguiente paso"}</h2>
              </div>
            </div>
            {derivedState === "INVITED" || derivedState === "BLOCKED" ? (
              <div class="next-action">
                <span aria-hidden="true">01</span>
                <div>
                  <strong>Validar tu primer producto</strong>
                  <p>No necesitas hacer nada adicional mientras Carobra completa la revisión.</p>
                </div>
              </div>
            ) : journey?.progress.rule_available ? (
              <ul class="progress-list">
                {journey.progress.remaining_active_products !== null && (
                  <li><strong>{journey.progress.remaining_active_products}</strong><span>productos activos pendientes</span></li>
                )}
                {journey.progress.remaining_registration_months !== null && (
                  <li><strong>{journey.progress.remaining_registration_months}</strong><span>meses de permanencia pendientes</span></li>
                )}
                {journey.progress.remaining_qualifying_activities !== null && (
                  <li><strong>{journey.progress.remaining_qualifying_activities}</strong><span>actividades de perfilamiento pendientes</span></li>
                )}
              </ul>
            ) : currentLevel === "TITANIUM" ? (
              <p class="rewards-card__message">Tu nivel refleja el máximo reconocimiento definido actualmente en Rewards.</p>
            ) : (
              <p class="rewards-card__message">
                Seguimos construyendo tu perfil con productos, permanencia y actividad. Aquí verás únicamente metas confirmadas para tu cuenta.
              </p>
            )}
          </article>

          <article class="rewards-card rewards-profile" aria-labelledby="profile-title">
            <p class="rewards-eyebrow">Tu perfil Rewards</p>
            <h2 id="profile-title">Cada interacción nos ayuda a conocerte</h2>
            <p class="rewards-card__message">
              Cuando haya cuestionarios, contenidos o documentos relevantes para ti, aparecerán aquí y podrás ver cómo contribuyen a tu avance.
            </p>
            <span class="profile-status">{portal?.actions.some((action) => action.status === "PENDING") ? "Tienes actividades disponibles" : "Sin actividades pendientes por ahora"}</span>
          </article>
        </section>

        <section class="level-system" aria-labelledby="level-system-title">
          <div class="section-intro">
            <div>
              <p class="rewards-eyebrow">Niveles Rewards</p>
              <h2 id="level-system-title">Tu relación con Carobra, en un solo lugar</h2>
            </div>
            <p>Los niveles se calculan con productos activos, permanencia y actividades válidas; nunca por gastar tus puntos.</p>
          </div>
          <ol class="level-map">
            {levelSequence.map((level, index) => (
              <li class:list={[
                currentLevel === level.code && "is-current",
                currentLevel && levelSequence.findIndex((item) => item.code === currentLevel) > index && "is-passed",
              ]}>
                <span>{index + 1}</span>
                <div>
                  <strong>{level.label}</strong>
                  <small>{currentLevel === level.code
                    ? "Tu nivel actual"
                    : level.code === "SILVER"
                      ? "Regla de actividad por confirmar"
                      : "Se habilita con la relación correspondiente"}</small>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="rewards-grid rewards-grid--detail">
          <article id="productos" class="rewards-card" aria-labelledby="products-title">
            <div class="rewards-card__heading">
              <div>
                <p class="rewards-eyebrow">Productos</p>
                <h2 id="products-title">Productos vinculados a tu cuenta</h2>
              </div>
              <span>{activeProductCount} activos</span>
            </div>
            {products.length ? (
              <ul class="product-list">
                {products.map((product) => (
                  <li>
                    <span class:list={["product-icon", `is-${product.status.toLowerCase()}`]} aria-hidden="true"></span>
                    <div>
                      <strong>{productName(product.productType)}</strong>
                      <small>{product.activatedAt ? `Activo desde ${date(product.activatedAt)}` : "Información en actualización"}</small>
                      {product.levelImpact && <p>{product.levelImpact}</p>}
                    </div>
                    <span class="status-pill">{productStatus(product.status)}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <div class="rewards-empty">
                <strong>Aún no hay productos confirmados</strong>
                <p>El primero aparecerá aquí cuando la validación haya terminado.</p>
              </div>
            )}
          </article>

          <article id="actividad" class="rewards-card" aria-labelledby="movements-title">
            <div class="rewards-card__heading">
              <div>
                <p class="rewards-eyebrow">Puntos</p>
                <h2 id="movements-title">Movimientos recientes</h2>
              </div>
            </div>
            {movements.length ? (
              <ul class="movement-list">
                {movements.map((movement) => (
                  <li>
                    <div>
                      <strong>{movementName(movement.code)}</strong>
                      <small>{date(movement.occurredAt)}</small>
                    </div>
                    <span class:list={[BigInt(movement.pointsDelta) < 0n && "is-negative"]}>
                      {BigInt(movement.pointsDelta) >= 0n ? "+" : ""}{points(movement.pointsDelta)} pts
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <div class="rewards-empty">
                <strong>Todavía no hay movimientos</strong>
                <p>Tus puntos aparecerán aquí con la fecha y el motivo de cada movimiento.</p>
              </div>
            )}
          </article>
        </section>

        <section class="rewards-grid rewards-grid--activity">
          <article class="rewards-card" aria-labelledby="profile-activity-title">
            <div class="rewards-card__heading">
              <div>
                <p class="rewards-eyebrow">Perfilamiento</p>
                <h2 id="profile-activity-title">Tu actividad Rewards</h2>
              </div>
              <span>{activityDetails?.activities.length ?? 0} registradas</span>
            </div>
            {activityDetails?.activities.length ? (
              <ul class="activity-list">
                {activityDetails.activities.map((activity) => (
                  <li>
                    <span aria-hidden="true">{activity.qualifies ? "✓" : "·"}</span>
                    <div><strong>{activityName(activity.activity_type)}</strong><small>{date(activity.occurred_at)}</small></div>
                    <em>{activity.qualifies ? "Cuenta para tu perfil" : "Registrada"}</em>
                  </li>
                ))}
              </ul>
            ) : (
              <div class="rewards-empty rewards-empty--spacious">
                <strong>Aún no tienes actividades asignadas</strong>
                <p>Cuestionarios, contenidos y documentos aparecerán aquí cuando estén disponibles para tu perfil.</p>
              </div>
            )}
          </article>
          <article class="rewards-card account-care" aria-labelledby="account-care-title">
            <p class="rewards-eyebrow">Estado de cuenta</p>
            <h2 id="account-care-title">Tu historial permanece contigo</h2>
            <p>Si un producto se cancela o reactiva, conservaremos tus movimientos y volveremos a calcular tu nivel con la evidencia más reciente.</p>
            <div class="account-care__status">
              <span aria-hidden="true"></span>
              <div><strong>Cuenta protegida</strong><small>Última información disponible en Rewards</small></div>
            </div>
          </article>
        </section>

        {portal && (
          <section class="customer-center" aria-labelledby="customer-center-title">
            <div class="section-intro">
              <div><p class="rewards-eyebrow">Centro de actividad</p><h2 id="customer-center-title">Todo lo que puedes hacer desde Rewards</h2></div>
              <p>Las actividades aparecen cuando están disponibles para tu cuenta. Nunca te pediremos repetir información sin una solicitud visible.</p>
            </div>
            <div class="customer-action-grid">
              {portal.actions.length ? portal.actions.map((action) => (
                <article>
                  <span>{action.type === "QUESTIONNAIRE" ? "?" : action.type === "DOCUMENT" ? "↑" : "▶"}</span>
                  <div><small>{action.status === "COMPLETED" ? "Completada" : "Disponible"}</small><h3>{action.title}</h3><p>{action.description}</p></div>
                  {action.href && action.status === "PENDING" && <a href={action.href}>Abrir actividad</a>}
                </article>
              )) : (
                <article class="is-empty"><span>✓</span><div><small>Al día</small><h3>No tienes actividades pendientes</h3><p>Te avisaremos aquí cuando exista un cuestionario, contenido o documento para ti.</p></div></article>
              )}
            </div>
          </section>
        )}

        {portal && (
          <section class="rewards-grid rewards-grid--detail">
            <article id="documentos" class="rewards-card" aria-labelledby="documents-title">
              <p class="rewards-eyebrow">Documentos</p><h2 id="documents-title">Solicitudes para tu cuenta</h2>
              {portal.documents.requests.length ? (
                <ul class="portal-simple-list">{portal.documents.requests.map((request) => (
                  <li><div><strong>{request.title}</strong><p>{request.purpose}</p></div><span>{request.upload_available ? "Carga disponible" : "Te contactaremos"}</span></li>
                ))}</ul>
              ) : <div class="rewards-empty"><strong>No tienes documentos pendientes</strong><p>Si Carobra necesita algo, verás aquí el motivo y el estado de la solicitud.</p></div>}
            </article>
            <article class="rewards-card" aria-labelledby="timeline-title">
              <p class="rewards-eyebrow">Historial</p><h2 id="timeline-title">Lo más reciente en tu cuenta</h2>
              <ol class="customer-timeline">{portal.timeline.slice(0, 6).map((entry) => (
                <li><span aria-hidden="true"></span><div><strong>{entry.title}</strong><p>{entry.description}</p><small>{date(entry.occurred_at)}</small></div></li>
              ))}</ol>
            </article>
          </section>
        )}

        {portal && (
          <section class="help-center" aria-labelledby="help-title">
            <div><p class="rewards-eyebrow">Ayuda clara</p><h2 id="help-title">Entiende cómo funciona tu cuenta</h2></div>
            <div>{portal.help.map((item) => <details><summary>{item.title}</summary><p>{item.body}</p></details>)}</div>
          </section>
        )}

        <section id="beneficios" class="benefits-shell" aria-labelledby="benefits-title">
          <div class="benefits-shell__header">
            <div>
              <p class="rewards-eyebrow">Beneficios y recompensas</p>
              <h2 id="benefits-title">Tu espacio para redimir</h2>
              <p>{hasValidatedProduct
                ? "Tu producto ya cumple el requisito de acceso. El catálogo aparecerá aquí cuando la integración de beneficios esté habilitada."
                : "Podrás redimir cuando Carobra confirme tu primer producto y el catálogo de beneficios esté habilitado."}</p>
            </div>
            <div class="benefits-shell__actions">
              <span class:list={["redemption-state", hasValidatedProduct && "is-ready"]}>
                {journey?.redemption.eligible ? "Canje disponible" : hasValidatedProduct ? "Catálogo en preparación" : "Canje bloqueado"}
              </span>
              <a href="/cliente/beneficios">Explorar Recompensas <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <div class="benefit-modules">
            <article>
              <span aria-hidden="true">01</span>
              <div><strong>Beneficios disponibles</strong><p>Aquí se mostrará el catálogo que corresponda a tu nivel.</p></div>
              <small>Próximamente</small>
            </article>
            <article>
              <span aria-hidden="true">02</span>
              <div><strong>Recompensas destacadas</strong><p>Podrás consultar requisitos y puntos antes de confirmar.</p></div>
              <small>Próximamente</small>
            </article>
            <article>
              <span aria-hidden="true">03</span>
              <div><strong>Mis canjes</strong><p>Tus solicitudes y confirmaciones vivirán en esta sección.</p></div>
              <small>Sin movimientos</small>
            </article>
          </div>
        </section>

        {journey?.modules.expiry_policy_approved && journey.points.next_expiration_at && (
          <p class="expiration-note">Tu próximo vencimiento de puntos es el {date(journey.points.next_expiration_at)}.</p>
        )}
      </>
    )}
  </main>

  <script>
    import { attachLogoutHandler, requireElement } from "../../lib/client-page-utils";
    attachLogoutHandler(requireElement<HTMLButtonElement>("#logout"), "");
  </script>

  <style>
    .rewards-page { width: min(1320px, calc(100% - clamp(2rem, 6vw, 6rem))); margin: 0 auto; padding: 2.75rem 0 6.5rem; color: #173b60; }
