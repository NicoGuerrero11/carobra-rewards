---
import ClientShellLayout from '../../layouts/ClientShellLayout.astro';
import CouponCard from '../../components/CouponCard.astro';
import HomeLearningCard from '../../components/HomeLearningCard.astro';
import {getSiteBackendBaseUrl} from '../../lib/api';
import type {RewardsCustomerPortal} from '../../lib/rewards-customer-portal-contract';
import {levelLabel, journeyStateLabel, type RewardsV2Level} from '../../lib/rewards-v2-contract';
import type {BondaCouponCatalog} from '../../lib/bonda-coupon-contract';
import type {CoursesCatalog} from '../../lib/courses';
import {readHomeModule, selectHomeLearning, homeCouponMessage} from '../../lib/customer-home';
import {productOffers} from '../../lib/product-offers';
import '../../styles/customer-home.css';

const cookie = Astro.request.headers.get('cookie') ?? '';
const base = getSiteBackendBaseUrl();
const [accountResult, couponResult, learningResult] = await Promise.all([
  Astro.locals.rewardsPortal !== undefined
    ? Promise.resolve({status:200, data:Astro.locals.rewardsPortal})
    : readHomeModule<RewardsCustomerPortal>(base, '/api/v1/rewards/portal', cookie),
  readHomeModule<BondaCouponCatalog>(base, '/api/v1/rewards/coupons?page_size=4&preview=true', cookie),
  readHomeModule<CoursesCatalog>(base, '/api/v1/rewards/courses', cookie),
]);
if ([accountResult, couponResult, learningResult].some(result => result.status === 401)) return Astro.redirect('/login?error=unauthenticated');
Astro.response.headers.set('Cache-Control', 'private, no-store');
const portal = accountResult.data;
const journey = portal?.journey;
const state = journey?.journey.state;
const currentLevel = journey?.journey.current_level ?? null;
const invited = state === 'INVITED';
const restricted = state === 'BLOCKED' || state === 'INACTIVE';
const levelTitle = invited ? 'Invitado' : currentLevel ? levelLabel(currentLevel) : 'Nivel en actualización';
const catalog = couponResult.data;
const coupons = !invited && !restricted && catalog?.access_state === 'AVAILABLE' ? catalog.items.slice(0,4) : [];
const learning = learningResult.data;
const picks = selectHomeLearning(learning, invited || restricted);
const levels: RewardsV2Level[] = ['BRONZE','SILVER','GOLD','PLATINUM','TITANIUM'];
const target = journey?.progress.target_level;
const approvedTarget = state === 'ACTIVE' && currentLevel && target && journey?.progress.rule_available && levels.indexOf(target) > levels.indexOf(currentLevel);
const requirements = approvedTarget ? [
  {remaining:journey!.progress.remaining_active_products, singular:'producto activo', plural:'productos activos'},
  {remaining:journey!.progress.remaining_registration_months, singular:'mes de permanencia', plural:'meses de permanencia'},
  {remaining:journey!.progress.remaining_qualifying_activities, singular:'actividad válida', plural:'actividades válidas'},
].filter(item => item.remaining !== null && item.remaining > 0) : [];
const points = (value: string | null | undefined) => value == null ? '—' : new Intl.NumberFormat('es-MX').format(BigInt(value));
const date = (value:string) => new Intl.DateTimeFormat('es-MX',{dateStyle:'medium'}).format(new Date(value));
const expiry = journey?.modules.expiry_policy_approved && journey.points.next_expiration_at ? date(journey.points.next_expiration_at) : null;
const recentActivity = portal?.timeline.slice(0, 3) ?? [];
const action = portal?.primary_action;
const pendingHref = action?.status === 'PENDING' && action.href && /^\/cliente\/(perfil|activities|productos|ayuda|cursos)(?:[/?#]|$)/.test(action.href) && !action.href.includes('\\') ? action.href : null;
const learningEmpty = !learning ? 'No pudimos cargar estos contenidos. Puedes volver a intentarlo desde su catálogo.'
  : learning.status === 'DISABLED' ? 'Este catálogo no está habilitado por el momento.'
  : restricted ? 'Revisa el estado de tu cuenta para acceder a estos contenidos.'
  : invited ? 'Los contenidos comienzan en Bronce. Puedes explorar el catálogo y conocer los niveles de acceso.'
  : 'No hay contenidos disponibles para tu cuenta en este momento.';
---
<ClientShellLayout title="Inicio Rewards | Carobra" description="Tus beneficios, aprendizaje y nuevas posibilidades en Carobra Rewards." currentPath="/cliente/recompensas" sectionLabel="Inicio Rewards">
  <main class="customer-home">
    <header class="home-welcome">
      <div><p class="home-eyebrow">Tu espacio Carobra Rewards</p><h1>Hola, {Astro.locals.user?.firstName ?? 'cliente'}<span aria-hidden="true">.</span></h1></div>
      <a class="home-text-link" href="/cliente/perfil">Ver mi cuenta <span aria-hidden="true">↗</span></a>
    </header>

    {journey ? <section class="home-account" aria-label="Resumen de tu cuenta">
      <div class="home-level" data-level={invited ? 'INVITED' : currentLevel ?? 'UNKNOWN'}>
        <div class="home-level__heading"><div><p class="home-eyebrow">{restricted ? 'Estado de tu cuenta' : 'Tu nivel actual'}</p><h2>{restricted ? journeyStateLabel(state!) : levelTitle}</h2></div><span class="home-level__emblem" aria-hidden="true">✦</span></div>
        <p>{invited ? 'Tu próximo paso comienza con un producto confirmado.' : restricted ? 'Consulta tu cuenta o contacta a Ayuda para conocer los siguientes pasos.' : currentLevel === 'TITANIUM' ? 'Llegaste a lo más alto. Disfruta lo que tu nivel tiene para ti.' : 'Haz espacio para aprender, disfrutar y seguir creciendo.'}</p>
        {state === 'ACTIVE' && currentLevel && <ol class="home-levels" aria-label="Niveles del programa">{levels.map(level => <li data-level={level} aria-current={level === currentLevel ? 'step' : undefined}><span class="home-levels__marker" aria-hidden="true">{level === currentLevel ? '✓' : '●'}</span>{levelLabel(level)}</li>)}</ol>}
        {invited ? <a href="/cliente/productos">Descubrir productos <span aria-hidden="true">→</span></a> : restricted && <a href="/cliente/ayuda">Ir a Ayuda <span aria-hidden="true">→</span></a>}
      </div>
      <div class="home-balance">
        <div><p class="home-eyebrow">Tus puntos Rewards</p><p class="home-balance__amount">{points(journey.points.available)} <span>pts</span></p>{expiry && <p class="home-expiry">Próximo vencimiento: {expiry}</p>}<a class="home-text-link" href="/cliente/activities">Ver movimientos <span aria-hidden="true">→</span></a></div>
        {requirements.length > 0 ? <div class="home-next-level"><strong>Tu camino a {levelLabel(target!)}</strong><p>Te faltan:</p><ul>{requirements.map(item => <li>{item.remaining} {item.remaining === 1 ? item.singular : item.plural}</li>)}</ul></div> : <div class="home-balance__note"><span aria-hidden="true">✦</span><p>{state === 'ACTIVE' ? 'Tus cupones y descuentos no consumen puntos.' : 'Consulta el detalle de tu saldo y los movimientos de tu cuenta.'}</p></div>}
      </div>
    </section> : <section class="home-notice" role="status"><h2>No pudimos actualizar tu cuenta</h2><p>No podemos mostrar tu nivel y saldo en este momento. Puedes seguir explorando las secciones disponibles.</p><a class="home-text-link" href="/cliente/recompensas">Volver a intentar →</a></section>}

    {pendingHref && !restricted && <aside class="home-pending"><div><strong>{action!.title}</strong><p>{action!.description}</p></div><a class="home-text-link" href={pendingHref}>Continuar →</a></aside>}

    <section class="home-section" aria-labelledby="home-benefits-title">
      <div class="home-section-heading"><div><p class="home-eyebrow">Más para tu día a día</p><h2 id="home-benefits-title">Aprovecha tus beneficios</h2></div><a class="home-text-link" href="/cliente/beneficios">Ver todos <span aria-hidden="true">→</span></a></div>
      {coupons.length ? <><p class="home-section-intro">Descuentos disponibles para ti, sin usar tus puntos.</p><div class="home-benefits-grid">{coupons.map(item => <CouponCard item={item} />)}</div></> : <div class="home-empty" role="status"><p>{restricted ? 'Revisa el estado de tu cuenta para consultar tus beneficios.' : invited ? 'Tus descuentos comienzan en Bronce, cuando tengas un producto confirmado y un nivel activo.' : homeCouponMessage(catalog)}</p>{invited && <a class="home-text-link" href="/cliente/productos">Descubrir productos →</a>}</div>}
    </section>

    <div class="home-learning-grid">
      <section class="home-section" aria-labelledby="home-courses-title">
        <div class="home-section-heading"><div><p class="home-eyebrow">A tu ritmo</p><h2 id="home-courses-title">Sigue aprendiendo</h2></div><a class="home-text-link" href="/cliente/cursos?tipo=cursos">Ver cursos →</a></div>
        <p class="home-section-intro">{picks.courses.some(c => c.progress?.started && !c.progress.completed) ? 'Retoma lo que empezaste y sigue avanzando.' : 'Nuevas habilidades para lo que viene.'}</p>
        {picks.courses.length ? <div class="home-learning-list">{picks.courses.map(course => <HomeLearningCard course={course} />)}</div> : <div class="home-empty" role="status"><p>{learningEmpty}</p></div>}
        {learning?.progress_available === false && picks.courseCount > 0 && <p class="home-inline-notice" role="status">Tu avance guardado no está disponible en este momento. Puedes seguir explorando cursos.</p>}
      </section>
      <section class="home-section" aria-labelledby="home-wellness-title">
        <div class="home-section-heading"><div><p class="home-eyebrow">Bienestar</p><h2 id="home-wellness-title">Un momento para ti</h2></div><a class="home-text-link" href="/cliente/cursos?tipo=bienestar">Ver bienestar →</a></div>
        <p class="home-section-intro">Videos y lecturas para cuidarte. Desde Bronce.</p>
        {picks.wellness.length ? <div class="home-learning-list">{picks.wellness.map(course => <HomeLearningCard course={course} />)}</div> : <div class="home-empty" role="status"><p>{learningEmpty}</p></div>}
      </section>
    </div>

    <section class="home-section home-products" aria-labelledby="home-products-title">
      <div class="home-section-heading"><div><p class="home-eyebrow">Tu siguiente gran paso</p><h2 id="home-products-title">Haz más por lo que te importa</h2></div><a class="home-text-link" href="/cliente/productos">Ver productos →</a></div>
      <p class="home-section-intro">Tus metas, tu tranquilidad, tu futuro. Descubre las soluciones de Carobra.</p>
      <div class="home-products-grid">{productOffers.map(offer => <article class={`home-product home-product--${offer.id}`} aria-label={offer.name}>
        <a href={`/cliente/productos#producto-${offer.id}`} aria-label={`Descubrir ${offer.name}`}>
          <div class="home-product__brand">{offer.logo ? <img src={offer.logo} width={offer.logoWidth} height={offer.logoHeight} alt={offer.name} loading="lazy" /> : <span class="home-product__service">Modalidad <strong>40.</strong></span>}</div>
          <div class="home-product__copy"><h3>{offer.category}</h3><p>{offer.headline}</p><span class="home-product__points">✦ +{offer.displayRewardPoints} puntos Rewards</span><strong class="home-product__open">Descubrir <span aria-hidden="true">→</span></strong></div>
        </a>
      </article>)}</div>
    </section>

    <section class="home-section home-activity" aria-labelledby="home-activity-title">
      <div class="home-section-heading"><h2 id="home-activity-title">Tu actividad reciente</h2><a class="home-text-link" href="/cliente/activities">Ver actividad →</a></div>
      {recentActivity.length ? <ol>{recentActivity.map(entry => <li><span class="home-activity__dot" aria-hidden="true"></span><div><h3>{entry.title}</h3><p>{entry.description}</p><time datetime={entry.occurred_at}>{date(entry.occurred_at)}</time></div></li>)}</ol> : <p class="home-section-intro">{portal ? 'Aquí aparecerán las confirmaciones y los movimientos de tu cuenta.' : 'No pudimos consultar los movimientos de tu cuenta en este momento.'}</p>}
    </section>
  </main>
  <script>
    import {attachLogoutHandler, requireElement} from '../../lib/client-page-utils';
    attachLogoutHandler(requireElement<HTMLButtonElement>('#logout'), '');
  </script>
</ClientShellLayout>
