---
import ClientShellLayout from "../../layouts/ClientShellLayout.astro";
import { getSiteBackendBaseUrl } from "../../lib/api";

interface ValidationStatusResponse {
  validation_id: string;
  customer_id: string;
  status: string;
  registered_at: string;
  next_checkpoint: string | null;
  next_checkpoint_at: string | null;
  last_checked_at: string | null;
  last_check_outcome: string | null;
}

const user = Astro.locals.user;
let validation: ValidationStatusResponse | null = null;
let validationError: "api_unavailable" | null = null;

try {
  const response = await fetch(`${getSiteBackendBaseUrl()}/api/v1/me/validation-status`, {
    method: "GET",
    headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
  });
  if (response.status === 401) {
    return Astro.redirect("/login?error=unauthenticated");
  }
  if (!response.ok) {
    validationError = "api_unavailable";
  } else {
    validation = (await response.json()) as ValidationStatusResponse;
  }
} catch {
  validationError = "api_unavailable";
}

const normalizedStatus = validation?.status.toUpperCase() ?? "";
const isPending = normalizedStatus === "PENDING" || normalizedStatus === "PENDING_VALIDATION";
const statusTitle = validationError
  ? "No pudimos consultar tu validación"
  : isPending
    ? "Validación AFORE pendiente"
    : normalizedStatus
      ? `Estado de validación: ${normalizedStatus}`
      : "Estado de validación no disponible";
const statusDescription = validationError
  ? "El servicio no está disponible por el momento. Intenta actualizar la página más tarde."
  : isPending
    ? "Tu cuenta ya fue registrada. Estamos a la espera del resultado de validación de tu AFORE."
    : "Consulta aquí las actualizaciones del proceso asociado a tu cuenta.";
const registeredAt = validation?.registered_at
  ? new Intl.DateTimeFormat("es-MX", { dateStyle: "medium", timeStyle: "short" }).format(new Date(validation.registered_at))
  : null;
---

<ClientShellLayout
  title="Estado de mi cuenta | Carobra Rewards"
  description="Consulta el estado de tu registro y validación AFORE."
  currentPath="/cliente"
  sectionLabel="Estado de mi cuenta"
>
  <main class="client-page client-page--soft-separators">
    <section class="client-home-hero client-section--roomy mt-4 py-16">
      <div class="client-home-hero__inner">
        <div>
          <p class="client-home-hero__kicker">Cuenta Carobra Rewards</p>
          <h1 class="client-section-title">
            Hola, {user?.firstName ?? "cliente"}
          </h1>
          <p class="mt-3 max-w-2xl text-sm text-[#3f6286] sm:text-base">
            Desde aquí puedes consultar el estado real de tu registro y de la validación asociada a tu AFORE.
          </p>
        </div>
        <article class="client-card min-w-0 p-5 sm:min-w-[18rem]" aria-labelledby="account-status-title">
          <p id="account-status-title" class="text-xs font-bold uppercase tracking-[0.12em] text-[#587795]">Estado de cuenta</p>
          <p class="mt-2 text-xl font-extrabold text-[#14355f]">
            {user?.customerStatus === "PENDING_VALIDATION" ? "Pendiente de validación" : user?.customerStatus ?? "No disponible"}
          </p>
          <p class="mt-2 text-sm text-[#4f6f90]">Rewards ID: {user?.rewardsId || "No disponible"}</p>
        </article>
      </div>
    </section>

    <section class="client-section--roomy mt-6 grid gap-6 lg:grid-cols-[1.35fr_0.65fr]">
      <article class="client-card p-6 sm:p-8" aria-labelledby="validation-title">
        <div class="flex items-start gap-4">
          <span class:list={[
            "mt-1 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-xl",
            validationError ? "bg-[#fbeaea] text-[#8a2f2f]" : "bg-[#e8f1fb] text-[#0c3d75]",
          ]} aria-hidden="true">{validationError ? "!" : "⌛"}</span>
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-[#587795]">Validación AFORE</p>
            <h2 id="validation-title" class="mt-1 text-2xl font-extrabold text-[#14355f]">{statusTitle}</h2>
            <p class="mt-3 text-sm leading-6 text-[#4f6f90]">{statusDescription}</p>
          </div>
        </div>

        {registeredAt && (
          <dl class="mt-6 grid gap-4 rounded-2xl border border-[#d9e5f0] bg-[#f8fbff] p-4 sm:grid-cols-2">
            <div>
              <dt class="text-xs font-bold uppercase tracking-[0.08em] text-[#587795]">Registro de validación</dt>
              <dd class="mt-1 text-sm font-semibold text-[#244b73]">{registeredAt}</dd>
            </div>
            <div>
              <dt class="text-xs font-bold uppercase tracking-[0.08em] text-[#587795]">Referencia</dt>
              <dd class="mt-1 break-all text-sm font-semibold text-[#244b73]">{validation?.validation_id}</dd>
            </div>
          </dl>
        )}

        {validation?.next_checkpoint && (
          <p class="mt-4 text-sm text-[#4f6f90]">
            Próxima actualización: <strong class="text-[#244b73]">{validation.next_checkpoint}</strong>
          </p>
        )}
      </article>

      <aside class="client-card p-6" aria-labelledby="profile-summary-title">
        <h2 id="profile-summary-title" class="text-xl font-extrabold text-[#14355f]">Resumen de registro</h2>
        <dl class="mt-5 space-y-4 text-sm">
          <div>
            <dt class="font-bold text-[#587795]">Nombre</dt>
            <dd class="mt-1 text-[#244b73]">{`${user?.firstName ?? ""} ${user?.lastName ?? ""}`.trim() || "No disponible"}</dd>
          </div>
          <div>
            <dt class="font-bold text-[#587795]">Email</dt>
            <dd class="mt-1 break-all text-[#244b73]">{user?.email ?? "No disponible"}</dd>
          </div>
          <div>
            <dt class="font-bold text-[#587795]">Registro</dt>
            <dd class="mt-1 text-[#244b73]">{user?.onboardingStatus === "COMPLETED" ? "Completado" : user?.onboardingStatus ?? "No disponible"}</dd>
          </div>
        </dl>
        <p class="mt-6 rounded-xl bg-[#eef5fb] p-4 text-xs leading-5 text-[#4f6f90]">
          Los puntos, niveles, beneficios y redenciones no forman parte de esta versión del sitio.
        </p>
      </aside>
    </section>

    <section class="client-home-support mt-6">
      <h3>¿Necesitas ayuda?</h3>
      <ul>
        <li><a href="mailto:soporte@carobra.mx">Contactar soporte</a></li>
      </ul>
    </section>
  </main>

  <script>
    import { attachLogoutHandler, requireElement } from "../../lib/client-page-utils";
    const logoutButton = requireElement<HTMLButtonElement>("#logout");
    attachLogoutHandler(logoutButton, "");
  </script>
</ClientShellLayout>
