---
import ClientShellLayout from "../../layouts/ClientShellLayout.astro";
import { getSiteBackendBaseUrl } from "../../lib/api";
import type { RewardsCustomerPortal } from "../../lib/rewards-customer-portal-contract";

const user = Astro.locals.user;
const cookie = Astro.request.headers.get("cookie") ?? "";
const portalLoadedWithContext = Astro.locals.rewardsPortal !== undefined;
let portal: RewardsCustomerPortal | null = Astro.locals.rewardsPortal ?? null;
let unavailable = portalLoadedWithContext && !portal;

if (!portalLoadedWithContext) {
  try {
    const response = await fetch(`${getSiteBackendBaseUrl()}/api/v1/rewards/portal`, { headers: { cookie } });
    if (response.status === 401) return Astro.redirect("/login?error=unauthenticated");
    if (response.ok) portal = await response.json() as RewardsCustomerPortal;
    else unavailable = true;
  } catch {
    unavailable = true;
  }
}
const journey = portal?.journey;
const activeProduct = portal?.products.some((product) => product.status === "ACTIVE") ?? false;
const catalogEnabled = journey?.modules.benefits_enabled === true;
const courses = portal?.learning.items ?? [];
const points = journey ? new Intl.NumberFormat("es-MX").format(BigInt(journey.points.available)) : "—";
---

<ClientShellLayout title="Beneficios | Carobra Rewards" description="Descubre beneficios disponibles y próximos en Carobra Rewards." currentPath="/cliente/beneficios" sectionLabel="Beneficios">
  <main class="benefits-page">
    <header class="benefits-page__welcome">
      <div><p class="benefits-page__eyebrow">Tu espacio de valor</p><h1>Beneficios</h1><p>Descubre lo que puedes aprovechar hoy y lo que se habilitará después.</p></div>
      <span>Hola, {user?.firstName ?? "cliente"}</span>
    </header>

    {unavailable && !portal ? (
      <section class="benefits-page__empty" role="status"><span aria-hidden="true">!</span><div><h2>No pudimos cargar tus beneficios</h2><p>Intenta de nuevo en unos minutos. No mostraremos opciones que no estén confirmadas para tu cuenta.</p></div></section>
    ) : portal && (
      <>
        <section class="benefits-page__hero" aria-labelledby="benefits-hero-title">
          <div><p class="benefits-page__eyebrow">Beneficios para ti</p><h2 id="benefits-hero-title">Todo en un solo lugar.</h2><p>{catalogEnabled ? "Tu cuenta tiene opciones de catálogo disponibles para consultar." : activeProduct ? "Tu producto está confirmado. Mientras se prepara el catálogo, puedes aprovechar el contenido asignado a tu cuenta." : "Puedes explorar las categorías desde ahora. Algunas se habilitarán después de confirmar tu primer producto."}</p><div class="benefits-page__tags"><span>{activeProduct ? "Producto confirmado" : "Validación en proceso"}</span><span>{catalogEnabled ? "Catálogo disponible" : "Catálogo en preparación"}</span></div></div>
          <article class="benefits-page__wallet"><span aria-hidden="true">✦</span><p>Tu saldo</p><strong>{points}<small> pts</small></strong><a href="/cliente/activities">Ver movimientos <span aria-hidden="true">→</span></a></article>
        </section>

        <section class="benefits-page__section" aria-labelledby="available-title">
          <div class="benefits-page__section-heading"><div><p class="benefits-page__eyebrow">Disponible hoy</p><h2 id="available-title">Valor que ya puedes consultar</h2></div><p>Solo mostramos contenido y funciones confirmadas por tu cuenta.</p></div>
          <div class="benefits-page__available-grid">
            <a class="benefit-card benefit-card--learning" href="/cliente/cursos"><span aria-hidden="true">▶</span><div><small>Contenido y cursos</small><h3>{courses.length ? `${courses.length} contenido${courses.length === 1 ? "" : "s"} para ti` : "Biblioteca personal"}</h3><p>{courses.length ? "Continúa tus contenidos asignados y consulta tu avance." : "Aquí aparecerán únicamente contenidos aprobados y asignados."}</p></div><strong>{courses.length ? "Ir a mis cursos" : "Conocer la sección"} →</strong></a>
            <article class="benefit-card benefit-card--status"><span aria-hidden="true">✓</span><div><small>Estado de acceso</small><h3>{activeProduct ? "Cuenta preparada" : "Producto pendiente"}</h3><p>{activeProduct ? "Tu cuenta cumple el requisito de producto; cada categoría indicará cuándo esté habilitada." : "Seguimos validando tu primer producto. No necesitas repetir el registro."}</p></div><a href="/cliente/recompensas">Ver mi avance →</a></article>
          </div>
        </section>

        <section class="benefits-page__section" aria-labelledby="families-title">
          <div class="benefits-page__section-heading"><div><p class="benefits-page__eyebrow">Categorías</p><h2 id="families-title">Próximas experiencias</h2></div><p>Sin marcas, precios o condiciones hasta que exista información aprobada.</p></div>
          <div class="benefits-page__family-grid">
            <article><span>01</span><div><small>En preparación</small><h3>Descuentos</h3><p>Ofertas y condiciones aparecerán aquí cuando sean publicadas para tu cuenta.</p></div></article>
            <article><span>02</span><div><small>En preparación</small><h3>Sorteos</h3><p>Las dinámicas, fechas y requisitos se mostrarán únicamente cuando estén aprobados.</p></div></article>
            <a href="/cliente/gift-cards"><span>03</span><div><small>{catalogEnabled ? "Disponible" : "Categoría bloqueada"}</small><h3>Gift Cards</h3><p>{catalogEnabled ? "Consulta las opciones habilitadas para tu cuenta." : activeProduct ? "Tu cuenta está preparada; falta habilitar el catálogo." : "Se habilitarán con un producto confirmado y un catálogo disponible."}</p></div><strong>Ver detalle →</strong></a>
            <article><span>04</span><div><small>Sin movimientos</small><h3>Mis canjes</h3><p>Cuando el canje esté habilitado, aquí podrás consultar solicitudes y confirmaciones.</p></div></article>
          </div>
        </section>
      </>
    )}
  </main>
  <script>
    import { attachLogoutHandler, requireElement } from "../../lib/client-page-utils";
    attachLogoutHandler(requireElement<HTMLButtonElement>("#logout"), "");
  </script>
  <style>
    .benefits-page{width:min(74rem,calc(100% - 2.2rem));margin:0 auto;padding:1.5rem 0 4rem;color:#173f68}.benefits-page__welcome{display:flex;justify-content:space-between;align-items:end;gap:1.5rem;margin-bottom:1.25rem}.benefits-page__welcome h1{margin:.2rem 0 .3rem;font-size:clamp(2.7rem,6vw,4.8rem);line-height:.92;letter-spacing:-.055em}.benefits-page__welcome div>p:last-child{margin:0;color:#627b91}.benefits-page__welcome>span,.benefits-page__tags span{padding:.48rem .72rem;border-radius:999px;font-size:.72rem;font-weight:850}.benefits-page__welcome>span{color:#635087;background:#eee8ff}.benefits-page__eyebrow{margin:0;color:#6d57a1;font-size:.68rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.benefits-page__hero{min-height:23rem;display:grid;grid-template-columns:minmax(0,1fr) 18rem;align-items:end;gap:2rem;padding:clamp(1.5rem,5vw,3.4rem);border-radius:2.1rem;color:#fff;background:radial-gradient(circle at 84% 10%,rgba(255,216,130,.58),transparent 13rem),linear-gradient(125deg,#6352a5,#348fb3 58%,#39b7a7);box-shadow:0 26px 60px rgba(58,78,133,.2);overflow:hidden}.benefits-page__hero .benefits-page__eyebrow{color:#d9d0ff}.benefits-page__hero h2{max-width:42rem;margin:.4rem 0 .8rem;font-size:clamp(2.8rem,7vw,5.6rem);line-height:.87;letter-spacing:-.06em}.benefits-page__hero>div>p:not(.benefits-page__eyebrow){max-width:43rem;margin:0;color:#e7f3f6;line-height:1.65}.benefits-page__tags{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.2rem}.benefits-page__tags span{border:1px solid rgba(255,255,255,.25);background:rgba(255,255,255,.1)}.benefits-page__wallet{padding:1.45rem;border-radius:1.35rem;color:#153b60;background:#fffdf8;box-shadow:0 22px 45px rgba(31,36,78,.22)}.benefits-page__wallet>span{color:#ef8f73;font-size:1.6rem}.benefits-page__wallet p{margin:.9rem 0 .25rem;color:#7e7890;font-size:.68rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.benefits-page__wallet strong{display:block;margin-bottom:1rem;font-size:3rem;line-height:1}.benefits-page__wallet small{font-size:.8rem}.benefits-page__wallet a{color:#6450a0;font-size:.78rem;font-weight:900}.benefits-page__section{margin-top:1rem;padding:clamp(1.4rem,4vw,2.2rem);border-radius:1.6rem;background:linear-gradient(140deg,#fff,#f3efff 62%,#eaf8f5);box-shadow:0 15px 34px rgba(39,52,91,.07)}.benefits-page__section-heading{display:flex;justify-content:space-between;align-items:end;gap:2rem}.benefits-page__section-heading h2{margin:.3rem 0 0;font-size:clamp(1.4rem,3vw,2rem)}.benefits-page__section-heading>p{max-width:31rem;margin:0;color:#627b90;line-height:1.55}.benefits-page__available-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:.8rem;margin-top:1.3rem}.benefit-card{min-height:14rem;display:flex;flex-direction:column;padding:1.25rem;border-radius:1.15rem;background:#fff;box-shadow:0 12px 26px rgba(29,55,86,.06)}.benefit-card>span{width:2.3rem;height:2.3rem;display:grid;place-items:center;border-radius:50%;font-size:.75rem;font-weight:900}.benefit-card>div{margin-top:1rem}.benefit-card small,.benefits-page__family-grid small{color:#39809c;font-size:.68rem;font-weight:900;letter-spacing:.09em;text-transform:uppercase}.benefit-card h3,.benefits-page__family-grid h3{margin:.3rem 0;color:#173f68;font-size:1.35rem}.benefit-card p,.benefits-page__family-grid p{margin:0;color:#607990;font-size:.86rem;line-height:1.55}.benefit-card>strong,.benefit-card>a{margin-top:auto;padding-top:1rem;color:#176f9e;font-size:.8rem;font-weight:900}.benefit-card--learning>span{color:#6754a6;background:#eee8ff}.benefit-card--status>span{color:#16704b;background:#dff7f1}.benefits-page__family-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem;margin-top:1.3rem}.benefits-page__family-grid>article,.benefits-page__family-grid>a{min-height:15rem;display:flex;flex-direction:column;padding:1.15rem;border-radius:1.1rem;background:rgba(255,255,255,.8)}.benefits-page__family-grid>article:nth-child(1){background:#dff7f1}.benefits-page__family-grid>article:nth-child(2){background:#fff0ce}.benefits-page__family-grid>a{background:#ffe8ee}.benefits-page__family-grid>article:nth-child(4){background:#e2f3ff}.benefits-page__family-grid>article>span,.benefits-page__family-grid>a>span{color:#3b7899;font-size:.7rem;font-weight:900}.benefits-page__family-grid>div{margin-top:1rem}.benefits-page__family-grid strong{margin-top:auto;padding-top:1rem;color:#86526f;font-size:.78rem}.benefits-page__empty{display:flex;align-items:center;gap:1rem;padding:1.5rem;border-radius:1.3rem;background:#fff}.benefits-page__empty>span{width:2.5rem;height:2.5rem;display:grid;place-items:center;border-radius:50%;background:#fde7df;font-weight:900}.benefits-page__empty h2{margin:0}.benefits-page__empty p{margin:.3rem 0 0;color:#627b90}@media(max-width:850px){.benefits-page__hero{grid-template-columns:1fr}.benefits-page__wallet{width:min(100%,22rem)}.benefits-page__family-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.benefits-page{width:min(100% - 1.1rem,74rem);padding-top:1rem}.benefits-page__welcome,.benefits-page__section-heading{align-items:flex-start;flex-direction:column}.benefits-page__hero{min-height:auto;padding:1.35rem;border-radius:1.35rem}.benefits-page__hero h2{font-size:3.2rem}.benefits-page__wallet{width:100%}.benefits-page__available-grid,.benefits-page__family-grid{grid-template-columns:1fr}}
  </style>
</ClientShellLayout>
