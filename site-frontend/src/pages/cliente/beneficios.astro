---
import ClientShellLayout from "../../layouts/ClientShellLayout.astro";
import { getSiteBackendBaseUrl } from "../../lib/api";
import {
  couponChannelLabel,
  type BondaCouponCatalog,
  type BondaCouponHistory,
} from "../../lib/bonda-coupon-contract";
import type { RewardsCustomerPortal } from "../../lib/rewards-customer-portal-contract";
import { levelLabel } from "../../lib/rewards-v2-contract";

const user = Astro.locals.user;
const cookie = Astro.request.headers.get("cookie") ?? "";
const portalLoadedWithContext = Astro.locals.rewardsPortal !== undefined;
let portal: RewardsCustomerPortal | null = Astro.locals.rewardsPortal ?? null;
let portalUnavailable = portalLoadedWithContext && !portal;
let catalog: BondaCouponCatalog = emptyCatalog("PARTNER_UNAVAILABLE");
let history: BondaCouponHistory = { items: [] };

if (!portalLoadedWithContext) {
  try {
    const response = await fetch(`${getSiteBackendBaseUrl()}/api/v1/rewards/portal`, { headers: { cookie } });
    if (response.status === 401) return Astro.redirect("/login?error=unauthenticated");
    if (response.ok) portal = await response.json() as RewardsCustomerPortal;
    else portalUnavailable = true;
  } catch {
    portalUnavailable = true;
  }
}

if (portal) {
  try {
    const response = await fetch(`${getSiteBackendBaseUrl()}/api/v1/rewards/coupons?page_size=50`, { headers: { cookie } });
    if (response.status === 401) return Astro.redirect("/login?error=unauthenticated");
    if (response.ok) catalog = await response.json() as BondaCouponCatalog;
    if (catalog.access_state === "AVAILABLE" && catalog.items.length > 0) {
      const historyResponse = await fetch(`${getSiteBackendBaseUrl()}/api/v1/rewards/coupons/history`, { headers: { cookie } });
      if (historyResponse.ok) history = await historyResponse.json() as BondaCouponHistory;
    }
  } catch {
    catalog = emptyCatalog("PARTNER_UNAVAILABLE", portal.journey.journey.current_level);
  }
}

const journey = portal?.journey;
const currentLevel = catalog.current_level ?? journey?.journey.current_level ?? null;
const activeProduct = portal?.products.some((product) => product.status === "ACTIVE") ?? false;
const courses = portal?.learning.items ?? [];
const points = journey ? new Intl.NumberFormat("es-MX").format(BigInt(journey.points.available)) : "—";
const categories = [...new Set(catalog.items.map((item) => item.category).filter(Boolean))] as string[];
const channels = [...new Set(catalog.items.flatMap((item) => item.channels))];
const refreshedAt = catalog.refreshed_at
  ? new Date(catalog.refreshed_at).toLocaleString("es-MX", { dateStyle: "medium", timeStyle: "short" })
  : null;
const stateContent = {
  FEATURE_DISABLED: ["Estamos preparando el catálogo", "La integración está lista, pero los beneficios todavía no han sido aprobados para clientes."],
  NO_LEVEL: ["Tus descuentos comienzan en Bronce", "Cuando tu primer producto esté confirmado y tengas un nivel activo, aparecerán aquí los beneficios que te correspondan."],
  ACCOUNT_UNAVAILABLE: ["Tus beneficios no están disponibles", "Revisa el estado de tu cuenta para volver a consultar el catálogo."],
  AFFILIATE_PENDING: ["Estamos activando tus beneficios", "Tu cuenta funciona normalmente. Volveremos a intentar la activación con Bonda sin que tengas que registrarte otra vez."],
  COUPON_UNAVAILABLE: ["Este beneficio cambió", "Ya no se encuentra disponible en el catálogo actual."],
  PARTNER_UNAVAILABLE: ["No pudimos cargar los beneficios", "Bonda no respondió en este momento. Intenta nuevamente en unos minutos."],
  AVAILABLE: ["Aún no hay beneficios publicados", "No mostraremos marcas ni condiciones hasta que el catálogo haya sido validado."],
}[catalog.access_state];

function emptyCatalog(
  accessState: BondaCouponCatalog["access_state"],
  currentLevel: BondaCouponCatalog["current_level"] = null,
): BondaCouponCatalog {
  return {
    current_level: currentLevel,
    access_state: accessState,
    affiliate_state: "DISABLED",
    items: [],
    refreshed_at: null,
    page: 1,
    page_size: 50,
    total: 0,
    next_page: null,
  };
}
---

<ClientShellLayout title="Beneficios | Carobra Rewards" description="Cupones y descuentos disponibles para tu nivel Carobra Rewards." currentPath="/cliente/beneficios" sectionLabel="Beneficios">
  <main class="benefits-page">
    <header class="benefits-page__welcome">
      <div><p class="benefits-page__eyebrow">Tu espacio de valor</p><h1>Beneficios</h1><p>Explora los descuentos gratuitos que corresponden a tu nivel.</p></div>
      <span>Hola, {user?.firstName ?? "cliente"}</span>
    </header>

    {portalUnavailable && !portal ? (
      <section class="benefits-page__empty" role="status"><span aria-hidden="true">!</span><div><h2>No pudimos cargar tus beneficios</h2><p>Intenta de nuevo en unos minutos. No mostraremos opciones que no estén confirmadas para tu cuenta.</p></div></section>
    ) : portal && (
      <>
        <section class="benefits-page__hero" aria-labelledby="benefits-hero-title">
          <div>
            <p class="benefits-page__eyebrow">Beneficios para ti</p>
            <h2 id="benefits-hero-title">Tu nivel abre nuevas experiencias.</h2>
            <p>Los cupones y descuentos de esta sección no consumen puntos. Cuando subes de nivel, conservas los anteriores y desbloqueas otros nuevos.</p>
            <div class="benefits-page__tags"><span>Nivel {levelLabel(currentLevel)}</span><span>{activeProduct ? "Producto confirmado" : "Validación en proceso"}</span></div>
          </div>
          <article class="benefits-page__wallet"><span aria-hidden="true">✦</span><p>Tu saldo</p><strong>{points}<small> pts</small></strong><small>Tu saldo no cambia al usar estos beneficios.</small><a href="/cliente/activities">Ver movimientos <span aria-hidden="true">→</span></a></article>
        </section>

        {catalog.items.length > 0 ? (
          <section class="benefits-page__section benefits-catalog" aria-labelledby="catalog-title">
            <div class="benefits-page__section-heading catalog-heading">
              <div><p class="benefits-page__eyebrow">Disponible hoy</p><h2 id="catalog-title">{catalog.total === 1 ? "1 beneficio para ti" : `${catalog.total} beneficios para ti`}</h2></div>
              <div class="catalog-filters" aria-label="Filtros de beneficios">
                <label><span>Categoría</span><select id="category-filter"><option value="">Todas</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label>
                <label><span>Cómo usarlo</span><select id="channel-filter"><option value="">Todos</option>{channels.map((channel) => <option value={channel}>{couponChannelLabel(channel)}</option>)}</select></label>
              </div>
            </div>
            {refreshedAt && <p class="catalog-freshness">Catálogo actualizado: <time datetime={catalog.refreshed_at ?? undefined}>{refreshedAt}</time></p>}
            <div class="benefits-grid" id="benefits-grid">
              {catalog.items.map((item) => (
                <article class="coupon-card" data-category={item.category ?? ""} data-channels={item.channels.join(",")}>
                  <div class="coupon-card__visual">
                    {item.imageUrl ? <img src={item.imageUrl} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <span aria-hidden="true">{item.name.slice(0, 1).toUpperCase()}</span>}
                    {item.discount && <strong>{item.discount}</strong>}
                  </div>
                  <div class="coupon-card__body">
                    <div class="coupon-card__meta"><span>{item.category ?? "Beneficio"}</span><span>Desde {levelLabel(item.minimumLevel)}</span></div>
                    <h3>{item.name}</h3><p>{item.shortDescription || "Consulta las condiciones y la forma de uso."}</p>
                    <div class="coupon-card__channels">{item.channels.slice(0, 2).map((channel) => <span>{couponChannelLabel(channel)}</span>)}</div>
                    <button class="coupon-card__open" type="button" data-coupon-id={item.id}>Ver beneficio <span aria-hidden="true">→</span></button>
                  </div>
                </article>
              ))}
            </div>
            <p class="filter-empty" id="filter-empty" hidden>No encontramos beneficios con esos filtros.</p>
          </section>
        ) : (
          <section class="benefits-page__section benefits-state" aria-live="polite">
            <span aria-hidden="true">✦</span><div><p class="benefits-page__eyebrow">Estado del catálogo</p><h2>{stateContent[0]}</h2><p>{stateContent[1]}</p></div>
            {catalog.access_state === "PARTNER_UNAVAILABLE" && <a href="/cliente/beneficios">Volver a intentar</a>}
          </section>
        )}

        <section class="benefits-page__section" aria-labelledby="other-benefits-title">
          <div class="benefits-page__section-heading"><div><p class="benefits-page__eyebrow">Más para tu cuenta</p><h2 id="other-benefits-title">Otras experiencias</h2></div><p>Las Gift Cards permanecen separadas de estos descuentos y todavía no permiten canjes.</p></div>
          <div class="benefits-page__available-grid">
            <a class="benefit-card benefit-card--learning" href="/cliente/cursos"><span aria-hidden="true">▶</span><div><small>Contenido y cursos</small><h3>{courses.length ? `${courses.length} contenido${courses.length === 1 ? "" : "s"} para ti` : "Biblioteca personal"}</h3><p>{courses.length ? "Continúa tus contenidos asignados y consulta tu avance." : "Aquí aparecerán únicamente contenidos aprobados y asignados."}</p></div><strong>{courses.length ? "Ir a mis cursos" : "Conocer la sección"} →</strong></a>
            <article class="benefit-card benefit-card--future"><span aria-hidden="true">◇</span><div><small>Gift Cards · Próximamente</small><h3>Canje con puntos</h3><p>Esta categoría se integrará después. No hay opciones ni controles de canje habilitados por ahora.</p></div><strong>No disponible todavía</strong></article>
          </div>
        </section>

        {history.items.length > 0 && (
          <section class="benefits-page__section coupon-history" aria-labelledby="history-title">
            <div><p class="benefits-page__eyebrow">Tus solicitudes</p><h2 id="history-title">Cupones recientes</h2></div>
            <ul>{history.items.map((item) => <li><div><strong>{item.name}</strong><span>{item.requestedAt ? new Date(item.requestedAt).toLocaleDateString("es-MX") : "Fecha no disponible"}</span></div><code>{item.code ?? "Verificación pendiente"}</code></li>)}</ul>
          </section>
        )}
      </>
    )}
  </main>

  <dialog class="benefit-dialog" id="benefit-dialog" aria-labelledby="dialog-title">
    <button class="dialog-close" type="button" aria-label="Cerrar detalle">×</button>
    <div class="dialog-loading" id="dialog-loading" role="status">Cargando beneficio…</div>
    <div id="dialog-content" hidden>
      <p class="benefits-page__eyebrow" id="dialog-category"></p><h2 id="dialog-title"></h2><strong class="dialog-discount" id="dialog-discount"></strong><p id="dialog-description"></p>
      <dl><div><dt>Vigencia</dt><dd id="dialog-expiration"></dd></div><div><dt>Disponible en</dt><dd id="dialog-channels"></dd></div></dl>
      <section><h3>Cómo usarlo</h3><p id="dialog-instructions"></p></section><details><summary>Términos y condiciones</summary><p id="dialog-legal"></p></details>
      <div class="request-zone">
        <button id="request-start" type="button">Quiero este beneficio</button>
        <div id="request-confirmation" hidden><p>Solicitaremos un código a Bonda. Esta acción no consume puntos.</p><div><button id="request-confirm" type="button">Confirmar solicitud</button><button id="request-cancel" type="button">Cancelar</button></div></div>
        <div id="request-result" role="status" aria-live="polite" hidden><p id="request-message"></p><div id="coupon-code-wrap" hidden><code id="coupon-code"></code><button id="copy-code" type="button">Copiar código</button></div></div>
      </div>
    </div>
  </dialog>

  <script>
    import { attachLogoutHandler, requireElement } from "../../lib/client-page-utils";
    import type { BondaCouponCodeResponse, BondaCouponDetailResponse } from "../../lib/bonda-coupon-contract";

    attachLogoutHandler(requireElement<HTMLButtonElement>("#logout"), "");
    const categoryFilter = document.querySelector<HTMLSelectElement>("#category-filter");
    const channelFilter = document.querySelector<HTMLSelectElement>("#channel-filter");
    const cards = [...document.querySelectorAll<HTMLElement>(".coupon-card")];
    const filterEmpty = document.querySelector<HTMLElement>("#filter-empty");
    const applyFilters = () => {
      let visible = 0;
      for (const card of cards) {
        const categoryMatches = !categoryFilter?.value || card.dataset.category === categoryFilter.value;
        const channelMatches = !channelFilter?.value || card.dataset.channels?.split(",").includes(channelFilter.value);
        card.hidden = !(categoryMatches && channelMatches);
        if (!card.hidden) visible += 1;
      }
      if (filterEmpty) filterEmpty.hidden = visible > 0;
    };
    categoryFilter?.addEventListener("change", applyFilters);
    channelFilter?.addEventListener("change", applyFilters);

    const dialog = requireElement<HTMLDialogElement>("#benefit-dialog");
    const loading = requireElement<HTMLElement>("#dialog-loading");
    const content = requireElement<HTMLElement>("#dialog-content");
    const requestStart = requireElement<HTMLButtonElement>("#request-start");
    const confirmation = requireElement<HTMLElement>("#request-confirmation");
    const requestResult = requireElement<HTMLElement>("#request-result");
    const codeWrap = requireElement<HTMLElement>("#coupon-code-wrap");
    const codeElement = requireElement<HTMLElement>("#coupon-code");
    let selectedCouponId = "";

    document.querySelectorAll<HTMLButtonElement>(".coupon-card__open").forEach((button) => button.addEventListener("click", async () => {
      selectedCouponId = button.dataset.couponId ?? "";
      loading.hidden = false;
      loading.textContent = "Cargando beneficio…";
      content.hidden = true;
      confirmation.hidden = true;
      requestResult.hidden = true;
      requestStart.hidden = false;
      dialog.showModal();
      try {
        const response = await fetch(`/api/v1/rewards/coupons/${encodeURIComponent(selectedCouponId)}`);
        if (!response.ok) throw new Error();
        const result = await response.json() as BondaCouponDetailResponse;
        if (!result.item) throw new Error();
        const item = result.item;
        setText("#dialog-category", item.category ?? "Beneficio");
        setText("#dialog-title", item.name);
        setText("#dialog-discount", item.discount ?? "Beneficio exclusivo");
        setText("#dialog-description", item.description || item.shortDescription);
        setText("#dialog-expiration", item.expirationAt ? new Date(item.expirationAt).toLocaleDateString("es-MX") : "Consulta los términos");
        setText("#dialog-channels", item.channels.map(channelLabel).join(" · ") || "Consulta las condiciones");
        setText("#dialog-instructions", item.usageInstructions || "Consulta las instrucciones al generar el beneficio.");
        setText("#dialog-legal", item.legalTerms || "Sin términos adicionales publicados.");
        loading.hidden = true;
        content.hidden = false;
      } catch {
        loading.textContent = "No pudimos cargar este beneficio. Intenta nuevamente.";
      }
    }));

    document.querySelector<HTMLButtonElement>(".dialog-close")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
    requestStart.addEventListener("click", () => { requestStart.hidden = true; confirmation.hidden = false; });
    requireElement<HTMLButtonElement>("#request-cancel").addEventListener("click", () => { confirmation.hidden = true; requestStart.hidden = false; });
    requireElement<HTMLButtonElement>("#request-confirm").addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      button.disabled = true;
      requestResult.hidden = false;
      codeWrap.hidden = true;
      setText("#request-message", "Solicitando tu beneficio…");
      try {
        const response = await fetch(`/api/v1/rewards/coupons/${encodeURIComponent(selectedCouponId)}/code`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ request_id: crypto.randomUUID() }),
        });
        if (!response.ok) throw new Error();
        const result = await response.json() as BondaCouponCodeResponse;
        setText("#request-message", result.instructions || statusMessage(result.status));
        if (result.status === "ISSUED" && result.code) {
          codeElement.textContent = result.code;
          codeWrap.hidden = false;
        }
      } catch {
        setText("#request-message", "No pudimos solicitar el beneficio. Intenta más tarde.");
      } finally {
        button.disabled = false;
        confirmation.hidden = true;
      }
    });
    requireElement<HTMLButtonElement>("#copy-code").addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(codeElement.textContent ?? "");
        button.textContent = "Copiado";
      } catch {
        button.textContent = "Copia el código manualmente";
      }
    });

    function setText(selector: string, value: string) { requireElement<HTMLElement>(selector).textContent = value; }
    function channelLabel(channel: string) { return ({ ONLINE: "En línea", ONSITE: "En sucursal", EMAIL: "Correo", PHONE: "Teléfono", WHATSAPP: "WhatsApp" } as Record<string, string>)[channel] ?? channel; }
    function statusMessage(status: BondaCouponCodeResponse["status"]) {
      return ({ ISSUED: "Tu beneficio está listo.", LIMIT_REACHED: "Ya alcanzaste el límite temporal de este beneficio.", INVENTORY_UNAVAILABLE: "Este beneficio no tiene códigos disponibles por ahora.", VERIFICATION_REQUIRED: "Estamos verificando si tu código fue generado.", UNAVAILABLE: "No pudimos solicitar el beneficio. Intenta más tarde." })[status];
    }
  </script>

  <style>
    .benefits-page{width:min(74rem,calc(100% - 2.2rem));margin:0 auto;padding:1.5rem 0 4rem;color:#173f68}.benefits-page__welcome{display:flex;justify-content:space-between;align-items:end;gap:1.5rem;margin-bottom:1.25rem}.benefits-page__welcome h1{margin:.2rem 0 .3rem;font-size:clamp(2.7rem,6vw,4.8rem);line-height:.92;letter-spacing:-.055em}.benefits-page__welcome div>p:last-child{margin:0;color:#627b91}.benefits-page__welcome>span,.benefits-page__tags span{padding:.48rem .72rem;border-radius:.55rem;font-size:.72rem;font-weight:850}.benefits-page__welcome>span{color:#004b87;background:#dff5fd}.benefits-page__eyebrow{margin:0;color:#004b87;font-size:.68rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.benefits-page__hero{display:grid;grid-template-columns:minmax(0,1fr) 18rem;align-items:end;gap:2rem;padding:clamp(1.5rem,5vw,3.4rem);border-radius:1.15rem;color:#041c2c;background:#fff;box-shadow:0 8px 18px rgba(4,28,44,.07)}.benefits-page__hero h2{max-width:42rem;margin:.4rem 0 .8rem;font-size:clamp(2.8rem,7vw,5.6rem);line-height:.87;letter-spacing:-.06em}.benefits-page__hero>div>p:not(.benefits-page__eyebrow){max-width:43rem;margin:0;color:#536878;line-height:1.65}.benefits-page__tags{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.2rem}.benefits-page__tags span{border:1px solid #cbd7df;background:#f2f8fc;color:#004b87}.benefits-page__wallet{padding:1.45rem;border-radius:.85rem;color:#153b60;background:#f2f8fc}.benefits-page__wallet>span{color:#b88416;font-size:1.6rem}.benefits-page__wallet p{margin:.9rem 0 .25rem;color:#7e7890;font-size:.68rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.benefits-page__wallet strong{display:block;margin-bottom:.5rem;font-size:3rem;line-height:1}.benefits-page__wallet strong small{font-size:.8rem}.benefits-page__wallet>small{display:block;color:#607990;line-height:1.4}.benefits-page__wallet a{display:inline-block;margin-top:1rem;color:#004b87;font-size:.78rem;font-weight:900}.benefits-page__sectio