---
import ClientShellLayout from "../../layouts/ClientShellLayout.astro";
import CouponCard from "../../components/CouponCard.astro";
import { getSiteBackendBaseUrl } from "../../lib/api";
import {
  carobraCouponCategory,
  couponChannelLabel,
  type BondaCouponCatalog,
  type BondaCouponHistory,
} from "../../lib/bonda-coupon-contract";
import type { RewardsCustomerPortal } from "../../lib/rewards-customer-portal-contract";

const cookie = Astro.request.headers.get("cookie") ?? "";
const portalLoadedWithContext = Astro.locals.rewardsPortal !== undefined;
let portal: RewardsCustomerPortal | null = Astro.locals.rewardsPortal ?? null;
let portalUnavailable = portalLoadedWithContext && !portal;
let catalog: BondaCouponCatalog = emptyCatalog("PARTNER_UNAVAILABLE");
let history: BondaCouponHistory = { items: [] };

if (!portalLoadedWithContext) {
  try {
    const response = await fetch(`${getSiteBackendBaseUrl()}/api/v1/rewards/portal`, { headers: { cookie } });
    if (response.status === 401) return Astro.redirect("/login?error=unauthenticated");
    if (response.ok) portal = await response.json() as RewardsCustomerPortal;
    else portalUnavailable = true;
  } catch {
    portalUnavailable = true;
  }
}

if (portal) {
  try {
    const response = await fetch(`${getSiteBackendBaseUrl()}/api/v1/rewards/coupons?page_size=50`, { headers: { cookie } });
    if (response.status === 401) return Astro.redirect("/login?error=unauthenticated");
    if (response.ok) catalog = await response.json() as BondaCouponCatalog;
    if (catalog.access_state === "AVAILABLE" && catalog.affiliate_state === "ACTIVE" && catalog.items.length > 0) {
      const historyResponse = await fetch(`${getSiteBackendBaseUrl()}/api/v1/rewards/coupons/history`, { headers: { cookie } });
      if (historyResponse.ok) history = await historyResponse.json() as BondaCouponHistory;
    }
  } catch {
    catalog = emptyCatalog("PARTNER_UNAVAILABLE", portal.journey.journey.current_level);
  }
}

const catalogItems = catalog.items.map((item) => ({ ...item, displayCategory: carobraCouponCategory(item.category) }));
const categories = [...new Set(catalogItems.map((item) => item.displayCategory))];
const channels = [...new Set(catalog.items.flatMap((item) => item.channels))];
const refreshedAt = catalog.refreshed_at
  ? new Date(catalog.refreshed_at).toLocaleString("es-MX", { dateStyle: "medium", timeStyle: "short" })
  : null;
const stateContent = {
  FEATURE_DISABLED: ["Estamos preparando el catálogo", "La integración está lista, pero los beneficios todavía no han sido aprobados para clientes."],
  NO_LEVEL: ["Tus descuentos comienzan en Bronce", "Cuando tu primer producto esté confirmado y tengas un nivel activo, aparecerán aquí los beneficios que te correspondan."],
  ACCOUNT_UNAVAILABLE: ["Tus beneficios no están disponibles", "Revisa el estado de tu cuenta para volver a consultar el catálogo."],
  AFFILIATE_PENDING: ["Estamos activando tus beneficios", "Tu cuenta funciona normalmente. Volveremos a intentar la activación con Bonda sin que tengas que registrarte otra vez."],
  COUPON_UNAVAILABLE: ["Este beneficio cambió", "Ya no se encuentra disponible en el catálogo actual."],
  PARTNER_UNAVAILABLE: ["No pudimos cargar los beneficios", "Bonda no respondió en este momento. Intenta nuevamente en unos minutos."],
  AVAILABLE: ["Aún no hay beneficios publicados", "No mostraremos marcas ni condiciones hasta que el catálogo haya sido validado."],
}[catalog.access_state];

function emptyCatalog(
  accessState: BondaCouponCatalog["access_state"],
  currentLevel: BondaCouponCatalog["current_level"] = null,
): BondaCouponCatalog {
  return {
    current_level: currentLevel,
    access_state: accessState,
    affiliate_state: "DISABLED",
    items: [],
    refreshed_at: null,
    page: 1,
    page_size: 50,
    total: 0,
    next_page: null,
  };
}
---

<ClientShellLayout title="Beneficios | Carobra Rewards" description="Cupones y descuentos disponibles para tu nivel Carobra Rewards." currentPath="/cliente/beneficios" sectionLabel="Beneficios">
  <main class="benefits-page">
    {portalUnavailable && !portal ? (
      <section class="benefits-page__empty" role="status"><span aria-hidden="true">!</span><div><h1>No pudimos cargar tus beneficios</h1><p>Intenta de nuevo en unos minutos. No mostraremos opciones que no estén confirmadas para tu cuenta.</p></div></section>
    ) : portal && (
      <>
        {catalog.items.length > 0 ? (
          <section class="benefits-page__section benefits-catalog" aria-labelledby="catalog-title">
            <div class="benefits-page__section-heading catalog-heading">
              <div><p class="benefits-page__eyebrow">Disponible hoy</p><h1 id="catalog-title">{catalog.total === 1 ? "1 beneficio para ti" : `${catalog.total} beneficios para ti`}</h1></div>
              <div class="catalog-filters" aria-label="Filtros de beneficios">
                <label><span>Categoría</span><select id="category-filter"><option value="">Todos</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label>
                <label><span>Cómo usarlo</span><select id="channel-filter"><option value="">Todos</option>{channels.map((channel) => <option value={channel}>{couponChannelLabel(channel)}</option>)}</select></label>
              </div>
            </div>
            {refreshedAt && <p class="catalog-freshness">Catálogo actualizado: <time datetime={catalog.refreshed_at ?? undefined}>{refreshedAt}</time></p>}
            <div class="benefits-grid" id="benefits-grid">
              {catalogItems.map(item => <CouponCard item={item} />)}
            </div>
            <p class="filter-empty" id="filter-empty" hidden>No encontramos beneficios con esos filtros.</p>
          </section>
        ) : (
          <section class="benefits-page__section benefits-state" aria-live="polite">
            <span aria-hidden="true">✦</span><div><p class="benefits-page__eyebrow">Estado del catálogo</p><h1>{stateContent[0]}</h1><p>{stateContent[1]}</p></div>
            {catalog.access_state === "PARTNER_UNAVAILABLE" && <a href="/cliente/beneficios">Volver a intentar</a>}
          </section>
        )}

        {history.items.length > 0 && (
          <section class="benefits-page__section coupon-history" id="historial" aria-labelledby="history-title">
            <div><p class="benefits-page__eyebrow">Tus solicitudes</p><h2 id="history-title">Cupones recientes</h2></div>
            <ul>{history.items.map((item) => <li><div><strong>{item.name}</strong><span>{item.requestedAt ? new Date(item.requestedAt).toLocaleDateString("es-MX") : "Fecha no disponible"}</span></div><code>{item.code ?? "Verificación pendiente"}</code></li>)}</ul>
          </section>
        )}
      </>
    )}
  </main>

  <script>
    import { attachLogoutHandler, requireElement } from "../../lib/client-page-utils";

    attachLogoutHandler(requireElement<HTMLButtonElement>("#logout"), "");
    const categoryFilter = document.querySelector<HTMLSelectElement>("#category-filter");
    const channelFilter = document.querySelector<HTMLSelectElement>("#channel-filter");
    const cards = [...document.querySelectorAll<HTMLElement>(".coupon-card")];
    const filterEmpty = document.querySelector<HTMLElement>("#filter-empty");
    const applyFilters = () => {
      let visible = 0;
      for (const card of cards) {
        const categoryMatches = !categoryFilter?.value || card.dataset.category === categoryFilter.value;
        const channelMatches = !channelFilter?.value || card.dataset.channels?.split(",").includes(channelFilter.value);
        card.hidden = !(categoryMatches && channelMatches);
        if (!card.hidden) visible += 1;
      }
      if (filterEmpty) filterEmpty.hidden = visible > 0;
    };
    categoryFilter?.addEventListener("change", applyFilters);
    channelFilter?.addEventListener("change", applyFilters);

  </script>

  <style>
    .benefits-page{width:min(74rem,calc(100% - 2.2rem));margin:0 auto;padding:1.5rem 0 4rem;color:#173f68}.benefits-page__welcome{display:flex;justify-content:space-between;align-items:end;gap:1.5rem;margin-bottom:1.25rem}.benefits-page__welcome h1{margin:.2rem 0 .3rem;font-size:clamp(2.7rem,6vw,4.8rem);line-height:.92;letter-spacing:-.055em}.benefits-page__welcome div>p:last-child{margin:0;color:#627b91}.benefits-page__welcome>span,.benefits-page__tags span{padding:.48rem .72rem;border-radius:.55rem;font-size:.72rem;font-weight:850}.benefits-page__welcome>span{color:#004b87;background:#dff5fd}.benefits-page__eyebrow{margin:0;color:#004b87;font-size:.68rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.benefits-page__hero{display:grid;grid-template-columns:minmax(0,1fr) 18rem;align-items:end;gap:2rem;padding:clamp(1.5rem,5vw,3.4rem);border-radius:1.15rem;color:#041c2c;background:#fff;box-shadow:0 8px 18px rgba(4,28,44,.07)}.benefits-page__hero h2{max-width:42rem;margin:.4rem 0 .8rem;font-size:clamp(2.8rem,7vw,5.6rem);line-height:.87;letter-spacing:-.06em}.benefits-page__hero>div>p:not(.benefits-page__eyebrow){max-width:43rem;margin:0;color:#536878;line-height:1.65}.benefits-page__tags{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.2rem}.benefits-page__tags span{border:1px solid #cbd7df;background:#f2f8fc;color:#004b87}.benefits-page__wallet{padding:1.45rem;border-radius:.85rem;color:#153b60;background:#f2f8fc}.benefits-page__wallet>span{color:#b88416;font-size:1.6rem}.benefits-page__wallet p{margin:.9rem 0 .25rem;color:#7e7890;font-size:.68rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.benefits-page__wallet strong{display:block;margin-bottom:.5rem;font-size:3rem;line-height:1}.benefits-page__wallet strong small{font-size:.8rem}.benefits-page__wallet>small{display:block;color:#607990;line-height:1.4}.benefits-page__wallet a{display:inline-block;margin-top:1rem;color:#004b87;font-size:.78rem;font-weight:900}.benefits-page__section{margin-top:1rem;padding:clamp(1.4rem,4vw,2.2rem);border-radius:1.15rem;background:#fff;box-shadow:0 15px 34px rgba(39,52,91,.07)}.benefits-page__section-heading{display:flex;justify-content:space-between;align-items:end;gap:2rem}.benefits-page__section-heading h2,.coupon-history h2{margin:.3rem 0 0;font-size:clamp(1.4rem,3vw,2rem)}.benefits-page__section-heading>p{max-width:31rem;margin:0;color:#627b90;line-height:1.55}.catalog-heading{align-items:center}.catalog-filters{display:flex;gap:.65rem}.catalog-filters label{display:grid;gap:.25rem;color:#607990;font-size:.68rem;font-weight:850}.catalog-filters select{min-width:10rem;padding:.65rem 2rem .65rem .7rem;border:1px solid #cbd7df;border-radius:.55rem;color:#173f68;background:#fff}.catalog-freshness{margin:.7rem 0 0;color:#758898;font-size:.72rem}.benefits-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem;margin-top:1.3rem}.filter-empty{padding:1.5rem;text-align:center;background:#f2f8fc}.benefits-state{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1rem}.benefits-state>span{width:2.8rem;height:2.8rem;display:grid;place-items:center;border-radius:50%;color:#004b87;background:#dff5fd}.benefits-state h2{margin:.25rem 0}.benefits-state div>p:last-child{margin:0;color:#627b90}.benefits-state>a{padding:.7rem .9rem;border-radius:.55rem;color:#fff;background:#041c2c;font-size:.8rem;font-weight:850}.benefits-page__available-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:.8rem;margin-top:1.3rem}.benefit-card{min-height:14rem;display:flex;flex-direction:column;padding:1.25rem;border-radius:.85rem;background:#f2f8fc}.benefit-card>span{width:2.3rem;height:2.3rem;display:grid;place-items:center;border-radius:.55rem;font-size:.75rem;font-weight:900}.benefit-card>div{margin-top:1rem}.benefit-card small{color:#39809c;font-size:.68rem;font-weight:900;letter-spacing:.09em;text-transform:uppercase}.benefit-card h3{margin:.3rem 0;color:#173f68;font-size:1.35rem}.benefit-card p{margin:0;color:#607990;font-size:.86rem;line-height:1.55}.benefit-card>strong{margin-top:auto;padding-top:1rem;color:#176f9e;font-size:.8rem;font-weight:900}.benefit-card--learning>span{color:#004b87;background:#dff5fd}.benefit-card--future>span{color:#91622b;background:#fff0d7}.benefit-card--future>strong{color:#8a735a}.coupon-history ul{display:grid;gap:.6rem;margin:1rem 0 0;padding:0;list-style:none}.coupon-history li{display:flex;justify-content:space-between;gap:1rem;padding:.9rem;border-radius:.7rem;background:#f2f8fc}.coupon-history li div{display:grid;gap:.2rem}.coupon-history li span{color:#718698;font-size:.75rem}.coupon-history code{align-self:center;padding:.4rem .6rem;border-radius:.45rem;background:#fff}.benefits-page__empty{display:flex;align-items:center;gap:1rem;padding:1.5rem;border-radius:1.3rem;background:#fff}.benefits-page__empty>span{width:2.5rem;height:2.5rem;display:grid;place-items:center;border-radius:50%;background:#fde7df;font-weight:900}.benefits-page__empty h2{margin:0}.benefits-page__empty p{margin:.3rem 0 0;color:#627b90}.filter-empty[hidden]{display:none}@media(max-width:1050px){.benefits-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:850px){.benefits-page__hero{grid-template-columns:1fr}.benefits-page__wallet{width:min(100%,22rem)}.catalog-heading{align-items:flex-start;flex-direction:column}}@media(max-width:700px){.benefits-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:520px){.benefits-page{width:min(100% - 1.1rem,74rem);padding-top:1rem}.benefits-page__welcome,.benefits-page__section-heading{align-items:flex-start;flex-direction:column}.benefits-page__hero{padding:1.35rem}.benefits-page__hero h2{font-size:3.2rem}.benefits-page__wallet{width:100%}.benefits-grid,.benefits-page__available-grid{grid-template-columns:1fr}.catalog-filters{width:100%;flex-direction:column}.catalog-filters label,.catalog-filters select{width:100%}.benefits-state{grid-template-columns:auto 1fr}.benefits-state>a{grid-column:2;justify-self:start}.coupon-history li{align-items:flex-start;flex-direction:column}}
    .catalog-heading h1{margin:.3rem 0 0;font-size:clamp(1.65rem,3vw,2.25rem)}
    .benefits-state h1,.benefits-page__empty h1{margin:.25rem 0;font-size:clamp(1.45rem,3vw,2rem)}
  </style>
</ClientShellLayout>
