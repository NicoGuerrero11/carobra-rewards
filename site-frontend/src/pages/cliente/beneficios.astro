---
import ClientShellLayout from "../../layouts/ClientShellLayout.astro";
import { getSiteBackendBaseUrl } from "../../lib/api";
import type { RewardsCustomerPortal } from "../../lib/rewards-customer-portal-contract";

const user = Astro.locals.user;
const cookie = Astro.request.headers.get("cookie") ?? "";
const portalLoadedWithContext = Astro.locals.rewardsPortal !== undefined;
let portal: RewardsCustomerPortal | null = Astro.locals.rewardsPortal ?? null;
let unavailable = portalLoadedWithContext && !portal;

if (!portalLoadedWithContext) {
  try {
    const response = await fetch(`${getSiteBackendBaseUrl()}/api/v1/rewards/portal`, { headers: { cookie } });
    if (response.status === 401) return Astro.redirect("/login?error=unauthenticated");
    if (response.ok) portal = await response.json() as RewardsCustomerPortal;
    else unavailable = true;
  } catch {
    unavailable = true;
  }
}
const journey = portal?.journey;
const activeProduct = portal?.products.some((product) => product.status === "ACTIVE") ?? false;
const catalogEnabled = journey?.modules.benefits_enabled === true;
const courses = portal?.learning.items ?? [];
const points = journey ? new Intl.NumberFormat("es-MX").format(BigInt(journey.points.available)) : "—";
const previewBrands = [
  { name: "Amazon", category: "Gift Cards" },
  { name: "Cinépolis", category: "Entretenimiento" },
  { name: "Soriana", category: "Compras" },
  { name: "Uber", category: "Movilidad" },
  { name: "Starbucks", category: "Alimentos" },
];
---

<ClientShellLayout title="Beneficios | Carobra Rewards" description="Descubre beneficios disponibles y próximos en Carobra Rewards." currentPath="/cliente/beneficios" sectionLabel="Beneficios">
  <main class="benefits-page">
    <header class="benefits-page__welcome">
      <div><p class="benefits-page__eyebrow">Tu espacio de valor</p><h1>Beneficios</h1><p>Descubre lo que puedes aprovechar hoy y lo que se habilitará después.</p></div>
      <span>Hola, {user?.firstName ?? "cliente"}</span>
    </header>

    {unavailable && !portal ? (
      <section class="benefits-page__empty" role="status"><span aria-hidden="true">!</span><div><h2>No pudimos cargar tus beneficios</h2><p>Intenta de nuevo en unos minutos. No mostraremos opciones que no estén confirmadas para tu cuenta.</p></div></section>
    ) : portal && (
      <>
        <section class="benefits-page__hero" aria-labelledby="benefits-hero-title">
          <div><p class="benefits-page__eyebrow">Beneficios para ti</p><h2 id="benefits-hero-title">Todo en un solo lugar.</h2><p>{catalogEnabled ? "Tu cuenta tiene opciones de catálogo disponibles para consultar." : activeProduct ? "Tu producto está confirmado. Mientras se prepara el catálogo, puedes aprovechar el contenido asignado a tu cuenta." : "Puedes explorar las categorías desde ahora. Algunas se habilitarán después de confirmar tu primer producto."}</p><div class="benefits-page__tags"><span>{activeProduct ? "Producto confirmado" : "Validación en proceso"}</span><span>{catalogEnabled ? "Catálogo disponible" : "Catálogo en preparación"}</span></div></div>
          <article class="benefits-page__wallet"><span aria-hidden="true">✦</span><p>Tu saldo</p><strong>{points}<small> pts</small></strong><a href="/cliente/activities">Ver movimientos <span aria-hidden="true">→</span></a></article>
        </section>

        {!catalogEnabled && <section class="benefits-unlock" aria-labelledby="benefits-unlock-title"><div><p class="benefits-page__eyebrow">Activa más beneficios</p><h2 id="benefits-unlock-title">{activeProduct ? "Tu cuenta ya cumple el primer paso" : "Desbloquea Gift Cards con tu primer producto"}</h2><p>{activeProduct ? "Estamos preparando el catálogo para tu cuenta. Te avisaremos cuando existan opciones confirmadas." : "Conoce las soluciones de Carobra y habla con un asesor. El acceso se habilitará cuando tu producto y el catálogo estén confirmados."}</p></div><a href="/cliente/productos">Ver productos</a></section>}

        <section class="benefits-page__section" aria-labelledby="available-title">
          <div class="benefits-page__section-heading"><div><p class="benefits-page__eyebrow">Disponible hoy</p><h2 id="available-title">Valor que ya puedes consultar</h2></div><p>Solo mostramos contenido y funciones confirmadas por tu cuenta.</p></div>
          <div class="benefits-page__available-grid">
            <a class="benefit-card benefit-card--learning" href="/cliente/cursos"><span aria-hidden="true">▶</span><div><small>Contenido y cursos</small><h3>{courses.length ? `${courses.length} contenido${courses.length === 1 ? "" : "s"} para ti` : "Biblioteca personal"}</h3><p>{courses.length ? "Continúa tus contenidos asignados y consulta tu avance." : "Aquí aparecerán únicamente contenidos aprobados y asignados."}</p></div><strong>{courses.length ? "Ir a mis cursos" : "Conocer la sección"} →</strong></a>
            <article class="benefit-card benefit-card--status"><span aria-hidden="true">✓</span><div><small>Estado de acceso</small><h3>{activeProduct ? "Cuenta preparada" : "Producto pendiente"}</h3><p>{activeProduct ? "Tu cuenta cumple el requisito de producto; cada categoría indicará cuándo esté habilitada." : "Seguimos validando tu primer producto. No necesitas repetir el registro."}</p></div><a href="/cliente/recompensas">Ver mi avance →</a></article>
          </div>
        </section>

        <section class="benefits-page__section" aria-labelledby="families-title">
          <div class="benefits-page__section-heading"><div><p class="benefits-page__eyebrow">Categorías</p><h2 id="families-title">Próximas experiencias</h2></div><p>Sin marcas, precios o condiciones hasta que exista información aprobada.</p></div>
          <div class="benefits-page__family-grid">
            <article><span>01</span><div><small>2 marcas previstas</small><h3>Descuentos</h3><p>Ofertas y condiciones aparecerán aquí cuando sean publicadas para tu cuenta.</p></div></article>
            <article><span>02</span><div><small>Próximamente</small><h3>Sorteos</h3><p>Las dinámicas, fechas y requisitos se mostrarán únicamente cuando estén aprobados.</p></div></article>
            <a href="/cliente/gift-cards"><span>03</span><div><small>{catalogEnabled ? "Disponible" : "5 marcas previstas"}</small><h3>Gift Cards</h3><p>{catalogEnabled ? "Consulta las opciones habilitadas para tu cuenta." : activeProduct ? "Tu cuenta está preparada; falta habilitar el catálogo." : "Se activa al confirmar tu primer producto y cuando el catálogo esté disponible."}</p></div><strong>Ver cómo se activa</strong></a>
            <article><span>04</span><div><small>0 canjes registrados</small><h3>Mis canjes</h3><p>Cuando el canje esté habilitado, aquí podrás consultar solicitudes y confirmaciones.</p></div></article>
          </div>
        </section>

        <section class="benefits-page__section benefits-preview" aria-labelledby="benefits-preview-title">
          <div class="benefits-page__section-heading"><div><p class="benefits-page__eyebrow">Catálogo próximamente</p><h2 id="benefits-preview-title">Marcas consideradas para el catálogo</h2></div><p>Este adelanto no representa inventario disponible. Los precios en puntos aparecerán cuando Carobra confirme el catálogo.</p></div>
          <ul>{previewBrands.map((brand) => <li><div><strong>{brand.name}</strong><span>{brand.category}</span></div><small class="status-future">Puntos por confirmar</small></li>)}</ul>
        </section>
      </>
    )}
  </main>
  <script>
    import { attachLogoutHandler, requireElement } from "../../lib/client-page-utils";
    attachLogoutHandler(requireElement<HTMLButtonElement>("#logout"), "");
  </script>
  <style>
    .benefits-page{width:min(74rem,calc(100% - 2.2rem));margin:0 auto;padding:1.5rem 0 4rem;color:#173f68}.benefits-page__welcome{display:flex;justify-content:space-between;align-items:end;gap:1.5rem;margin-bottom:1.25rem}.benefits-page__welcome h1{margin:.2rem 0 .3rem;font-size:clamp(2.7rem,6vw,4.8rem);line-height:.92;letter-spacing:-.055em}.benefits-page__welcome div>p:last-child{margin:0;color:#627b91}.benefits-page__welcome>span,.benefits-page__tags span{padding:.48rem .72rem;border-radius:.55rem;font-size:.72rem;font-weight:850}.benefits-page__welcome>span{color:#004b87;background:#dff5fd}.benefits-page__eyebrow{margin:0;color:#004b87;font-size:.68rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.benefits-page__hero{display:grid;grid-template-columns:minmax(0,1fr) 18rem;align-items:end;gap:2rem;padding:clamp(1.5rem,5vw,3.4rem);border-radius:1.15rem;color:#041c2c;background:#fff;box-shadow:0 8px 18px rgba(4,28,44,.07);overflow:hidden}.benefits-page__hero h2{max-width:42rem;margin:.4rem 0 .8rem;font-size:clamp(2.8rem,7vw,5.6rem);line-height:.87;letter-spacing:-.06em}.benefits-page__hero>div>p:not(.benefits-page__eyebrow){max-width:43rem;margin:0;color:#536878;line-height:1.65}.benefits-page__tags{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.2rem}.benefits-page__tags span{border:1px solid #cbd7df;background:#f2f8fc;color:#004b87}.benefits-page__wallet{padding:1.45rem;border-radius:.85rem;color:#153b60;background:#f2f8fc}.benefits-page__wallet>span{color:#b88416;font-size:1.6rem}.benefits-page__wallet p{margin:.9rem 0 .25rem;color:#7e7890;font-size:.68rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.benefits-page__wallet strong{display:block;margin-bottom:1rem;font-size:3rem;line-height:1}.benefits-page__wallet small{font-size:.8rem}.benefits-page__wallet a{color:#004b87;font-size:.78rem;font-weight:900}.benefits-unlock{display:flex;justify-content:space-between;align-items:center;gap:2rem;margin-top:1rem;padding:clamp(1.25rem,3vw,1.8rem);border-left:.35rem solid #b88416;border-radius:.85rem;background:#fff5d8;box-shadow:0 8px 18px rgba(4,28,44,.07)}.benefits-unlock h2{margin:.25rem 0;color:#041c2c;font-size:clamp(1.35rem,3vw,1.85rem)}.benefits-unlock p:last-child{max-width:48rem;margin:0;color:#685c40}.benefits-unlock>a{flex:0 0 auto;padding:.72rem .9rem;border-radius:.55rem;color:#fff;background:#041c2c;font-size:.8rem;font-weight:850}.benefits-page__section{margin-top:1rem;padding:clamp(1.4rem,4vw,2.2rem);border-radius:1.15rem;background:#fff;box-shadow:0 15px 34px rgba(39,52,91,.07)}.benefits-page__section-heading{display:flex;justify-content:space-between;align-items:end;gap:2rem}.benefits-page__section-heading h2{margin:.3rem 0 0;font-size:clamp(1.4rem,3vw,2rem)}.benefits-page__section-heading>p{max-width:31rem;margin:0;color:#627b90;line-height:1.55}.benefits-page__available-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:.8rem;margin-top:1.3rem}.benefit-card{min-height:14rem;display:flex;flex-direction:column;padding:1.25rem;border-radius:.85rem;background:#fff;box-shadow:0 12px 26px rgba(29,55,86,.06)}.benefit-card>span{width:2.3rem;height:2.3rem;display:grid;place-items:center;border-radius:.55rem;font-size:.75rem;font-weight:900}.benefit-card>div{margin-top:1rem}.benefit-card small,.benefits-page__family-grid small{color:#39809c;font-size:.68rem;font-weight:900;letter-spacing:.09em;text-transform:uppercase}.benefit-card h3,.benefits-page__family-grid h3{margin:.3rem 0;color:#173f68;font-size:1.35rem}.benefit-card p,.benefits-page__family-grid p{margin:0;color:#607990;font-size:.86rem;line-height:1.55}.benefit-card>strong,.benefit-card>a{margin-top:auto;padding-top:1rem;color:#176f9e;font-size:.8rem;font-weight:900}.benefit-card--learning>span{color:#004b87;background:#dff5fd}.benefit-card--status>span{color:#19734a;background:#e9f7ef}.benefits-page__family-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem;margin-top:1.3rem}.benefits-page__family-grid>article,.benefits-page__family-grid>a{min-height:15rem;display:flex;flex-direction:column;padding:1.15rem;border:1px solid #cbd7df;border-radius:.85rem;background:#fff}.benefits-page__family-grid>article:nth-child(even),.benefits-page__family-grid>a{background:#f2f8fc}.benefits-page__family-grid>article>span,.benefits-page__family-grid>a>span{color:#3b7899;font-size:.7rem;font-weight:900}.benefits-page__family-grid>article>div,.benefits-page__family-grid>a>div{margin-top:1rem}.benefits-page__family-grid strong{margin-top:auto;padding-top:1rem;color:#004b87;font-size:.78rem}.benefits-preview ul{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.6rem;margin:1.2rem 0 0;padding:0;list-style:none}.benefits-preview li{display:grid;gap:1rem;padding:1rem;border:1px solid #cbd7df;border-radius:.85rem;background:#fff}.benefits-preview li>div{display:grid;gap:.2rem}.benefits-preview li strong{color:#041c2c}.benefits-preview li span{color:#536878;font-size:.72rem}.benefits-preview li small{width:max-content;max-width:100%;padding:.3rem .42rem;border-radius:.4rem;font-size:.62rem;font-weight:750}.benefits-page__empty{display:flex;align-items:center;gap:1rem;padding:1.5rem;border-radius:1.3rem;background:#fff}.benefits-page__empty>span{width:2.5rem;height:2.5rem;display:grid;place-items:center;border-radius:50%;background:#fde7df;font-weight:900}.benefits-page__empty h2{margin:0}.benefits-page__empty p{margin:.3rem 0 0;color:#627b90}@media(max-width:850px){.benefits-page__hero{grid-template-columns:1fr}.benefits-page__wallet{width:min(100%,22rem)}.benefits-page__family-grid{grid-template-columns:repeat(2,1fr)}.benefits-preview ul{grid-template-columns:repeat(3,1fr)}}@media(max-width:600px){.benefits-page{width:min(100% - 1.1rem,74rem);padding-top:1rem}.benefits-page__welcome,.benefits-page__section-heading,.benefits-unlock{align-items:flex-start;flex-direction:column}.benefits-unlock>a{width:100%;text-align:center}.benefits-page__hero{padding:1.35rem}.benefits-page__hero h2{font-size:3.2rem}.benefits-page__wallet{width:100%}.benefits-page__available-grid,.benefits-page__family-grid,.benefits-preview ul{grid-template-columns:1fr}}
  </style>
</ClientShellLayout>
