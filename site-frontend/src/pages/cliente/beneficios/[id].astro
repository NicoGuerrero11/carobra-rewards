---
import ClientShellLayout from "../../../layouts/ClientShellLayout.astro";
import BenefitRichText from "../../../components/BenefitRichText.astro";
import "leaflet/dist/leaflet.css";
import { getSiteBackendBaseUrl } from "../../../lib/api";
import {
  carobraCouponCategory,
  couponChannelLabel,
  type BondaCouponCatalog,
  type BondaCouponDetailResponse,
} from "../../../lib/bonda-coupon-contract";

const couponId = Astro.params.id ?? "";
const cookie = Astro.request.headers.get("cookie") ?? "";
let detail: BondaCouponDetailResponse = {
  access_state: "COUPON_UNAVAILABLE",
  affiliate_state: "DISABLED",
  item: null,
};
let catalog: BondaCouponCatalog | null = null;

try {
  const [detailResponse, catalogResponse] = await Promise.all([
    fetch(`${getSiteBackendBaseUrl()}/api/v1/rewards/coupons/${encodeURIComponent(couponId)}`, { headers: { cookie } }),
    fetch(`${getSiteBackendBaseUrl()}/api/v1/rewards/coupons?page_size=50`, { headers: { cookie } }),
  ]);
  if (detailResponse.status === 401 || catalogResponse.status === 401) {
    return Astro.redirect("/login?error=unauthenticated");
  }
  if (detailResponse.ok) detail = await detailResponse.json() as BondaCouponDetailResponse;
  if (catalogResponse.ok) catalog = await catalogResponse.json() as BondaCouponCatalog;
} catch {
  detail = { access_state: "PARTNER_UNAVAILABLE", affiliate_state: "DISABLED", item: null };
}

const item = detail.item;
const detailImageUrl = item?.heroImageUrl ?? item?.bannerImageUrl ?? item?.imageUrl;
const canRequestCode = detail.affiliate_state === "ACTIVE";
const displayCategory = carobraCouponCategory(item?.category ?? null);
const related = (catalog?.items ?? [])
  .filter((candidate) => candidate.id !== couponId)
  .sort((left, right) => {
    const leftMatch = carobraCouponCategory(left.category) === displayCategory ? 0 : 1;
    const rightMatch = carobraCouponCategory(right.category) === displayCategory ? 0 : 1;
    return leftMatch - rightMatch || left.displayOrder - right.displayOrder;
  })
  .slice(0, 4);
const expiration = item?.expirationAt
  ? new Date(item.expirationAt).toLocaleDateString("es-MX", { day: "numeric", month: "long", year: "numeric" })
  : "Consulta los términos";
const unavailableCopy = detail.access_state === "PARTNER_UNAVAILABLE"
  ? ["No pudimos cargar este beneficio", "Bonda no respondió en este momento. Intenta nuevamente en unos minutos."]
  : ["Este beneficio ya no está disponible", "Puede haber cambiado, vencido o no corresponder a tu cuenta."];
---

<ClientShellLayout title={`${item?.name ?? "Beneficio"} | Carobra Rewards`} description="Detalle de beneficio Carobra Rewards." currentPath="/cliente/beneficios" sectionLabel="Beneficios">
  <main class="coupon-detail-page">
    <a class="back-link" href="/cliente/beneficios"><span aria-hidden="true">←</span> Volver a beneficios</a>

    {item ? (
      <>
        <section class="coupon-detail" aria-labelledby="coupon-title">
          <div class="coupon-detail__main">
            <div class="coupon-detail__visual">
              {detailImageUrl
                ? <img src={detailImageUrl} alt="" referrerpolicy="no-referrer" fetchpriority="high" decoding="async" />
                : <span aria-hidden="true">{item.name.slice(0, 1).toUpperCase()}</span>}
            </div>
            <div class="coupon-detail__copy">
              <p class="eyebrow">{displayCategory}</p>
              <h1 id="coupon-title">{item.name}</h1>
              {item.discount && <strong class="discount">{item.discount}</strong>}
              <BenefitRichText
                class="description"
                text={item.description || item.shortDescription || "Consulta las condiciones para disfrutar este beneficio."}
              />

              <dl class="coupon-facts">
                <div><dt>Vigencia</dt><dd>{expiration}</dd></div>
                <div><dt>Disponible en</dt><dd>{item.channels.map(couponChannelLabel).join(" · ") || "Consulta las condiciones"}</dd></div>
              </dl>

              <section class="instructions" aria-labelledby="instructions-title">
                <h2 id="instructions-title">Cómo usarlo</h2>
                <BenefitRichText text={item.usageInstructions || "Solicita tu beneficio y sigue las instrucciones que recibirás con el código."} />
              </section>

              {item.channels.includes("ONSITE") && (
                <section class="detail-section branches">
                  <button class="branches-trigger" id="branches-trigger" type="button" aria-haspopup="dialog" aria-controls="branches-dialog">
                    <span>Sucursales disponibles</span>
                    <span class="branches-trigger__meta"><span id="branches-trigger-count" hidden></span><span aria-hidden="true">→</span></span>
                  </button>
                  <dialog class="branches-dialog" id="branches-dialog" data-coupon-id={couponId} aria-labelledby="branches-dialog-title">
                    <div class="branches-dialog__panel">
                      <header>
                        <div><p class="eyebrow">Dónde usarlo</p><h2 id="branches-dialog-title">Sucursales habilitadas</h2></div>
                        <button class="branches-dialog__close" type="button" aria-label="Cerrar sucursales"><span aria-hidden="true">×</span></button>
                      </header>
                      <div class="branches-dialog__body">
                        <div class="branches-map-shell">
                          <div id="branches-map" aria-label="Mapa de sucursales habilitadas" hidden></div>
                          <p id="branches-map-empty">Cargando ubicaciones…</p>
                        </div>
                        <div class="branches-list-wrap">
                          <p id="branches-list-status" role="status">Consultando sucursales habilitadas…</p>
                          <ul class="branches-list" id="branches-list"></ul>
                        </div>
                      </div>
                    </div>
                  </dialog>
                </section>
              )}

              <details class="detail-section">
                <summary>Términos y condiciones</summary>
                <BenefitRichText text={item.legalTerms || "Bonda no publicó términos adicionales para este beneficio."} />
              </details>

              {item.brandDescription && (
                <details class="detail-section">
                  <summary>Sobre {item.name}</summary>
                  <BenefitRichText text={item.brandDescription} />
                </details>
              )}
            </div>
          </div>

          <aside class="coupon-action" aria-labelledby="action-title">
            <p class="eyebrow">Beneficio sin puntos</p>
            <h2 id="action-title">¿Quieres usarlo?</h2>
            <p>{canRequestCode ? "Generar el código no descuenta puntos de tu saldo." : "Puedes revisar toda la información mientras terminamos de activar la emisión de códigos para tu cuenta."}</p>
            {canRequestCode ? <button id="request-start" type="button">Quiero este beneficio</button> : <p class="coupon-action__pending" role="status">Código temporalmente no disponible</p>}
            <div id="request-confirmation" hidden>
              <p>Solicitaremos un código único a Bonda. Revisa las condiciones antes de continuar.</p>
              <div><button id="request-confirm" type="button">Confirmar solicitud</button><button id="request-cancel" type="button">Cancelar</button></div>
            </div>
            <div id="request-result" role="status" aria-live="polite" hidden>
              <p id="request-message"></p>
              <div id="coupon-code-wrap" hidden><code id="coupon-code"></code><button id="copy-code" type="button">Copiar código</button></div>
            </div>
            <a class="history-link" href="/cliente/beneficios#historial">Ver mis cupones recientes <span aria-hidden="true">→</span></a>
          </aside>
        </section>

        {related.length > 0 && (
          <section class="related" aria-labelledby="related-title">
            <p class="eyebrow">También disponible para ti</p><h2 id="related-title">Descubre más beneficios</h2>
            <div class="related__grid">
              {related.map((candidate) => {
                const candidateImageUrl = candidate.heroImageUrl ?? candidate.imageUrl;
                return (
                  <article class="related-card">
                    <a
                      class="related-card__link"
                      href={`/cliente/beneficios/${encodeURIComponent(candidate.id)}`}
                      aria-label={`${candidate.name}: ${candidate.discount || "Beneficio"}. Ver beneficio`}
                    >
                      <div class="related-card__visual">
                        {candidateImageUrl && (
                          <img src={candidateImageUrl} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                        )}
                        <span class="related-card__logo" aria-hidden="true">
                          {candidate.logoImageUrl
                            ? <img src={candidate.logoImageUrl} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                            : <strong>{candidate.name.slice(0, 1).toUpperCase()}</strong>}
                        </span>
                      </div>
                      <div class="related-card__body">
                        <span class="related-card__category">{carobraCouponCategory(candidate.category)}</span>
                        <strong class="related-card__discount">{candidate.discount || "Beneficio"}</strong>
                        <p>{candidate.shortDescription || "Consulta las condiciones y la forma de uso."}</p>
                        <div class="related-card__channels">
                          {candidate.channels.slice(0, 2).map((channel) => <span>{couponChannelLabel(channel)}</span>)}
                        </div>
                        <span class="related-card__open">Ver beneficio <span aria-hidden="true">→</span></span>
                      </div>
                    </a>
                  </article>
                );
              })}
            </div>
          </section>
        )}
      </>
    ) : (
      <section class="unavailable" role="status"><span aria-hidden="true">!</span><div><h1>{unavailableCopy[0]}</h1><p>{unavailableCopy[1]}</p><a href="/cliente/beneficios">Ver beneficios disponibles</a></div></section>
    )}
  </main>

  {item && canRequestCode && <script is:inline define:vars={{ couponId }}>
    const requestStart = document.querySelector("#request-start");
    const confirmation = document.querySelector("#request-confirmation");
    const requestResult = document.querySelector("#request-result");
    const codeWrap = document.querySelector("#coupon-code-wrap");
    const codeElement = document.querySelector("#coupon-code");
    const message = document.querySelector("#request-message");
    const confirmButton = document.querySelector("#request-confirm");

    requestStart?.addEventListener("click", () => { requestStart.hidden = true; confirmation.hidden = false; });
    document.querySelector("#request-cancel")?.addEventListener("click", () => { confirmation.hidden = true; requestStart.hidden = false; });
    confirmButton?.addEventListener("click", async () => {
      confirmButton.disabled = true;
      requestResult.hidden = false;
      codeWrap.hidden = true;
      message.textContent = "Solicitando tu beneficio…";
      try {
        const response = await fetch(`/api/v1/rewards/coupons/${encodeURIComponent(couponId)}/code`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ request_id: crypto.randomUUID() }),
        });
        if (!response.ok) throw new Error();
        const result = await response.json();
        const statuses = {
          ISSUED: "Tu beneficio está listo.",
          LIMIT_REACHED: "Ya alcanzaste el límite temporal de este beneficio.",
          INVENTORY_UNAVAILABLE: "Este beneficio no tiene códigos disponibles por ahora.",
          VERIFICATION_REQUIRED: "Estamos verificando si tu código fue generado.",
          UNAVAILABLE: "No pudimos solicitar el beneficio. Intenta más tarde.",
        };
        message.textContent = result.instructions || statuses[result.status] || statuses.UNAVAILABLE;
        if (result.status === "ISSUED" && result.code) {
          codeElement.textContent = result.code;
          codeWrap.hidden = false;
        }
      } catch {
        message.textContent = "No pudimos solicitar el beneficio. Intenta más tarde.";
      } finally {
        confirmButton.disabled = false;
        confirmation.hidden = true;
      }
    });
    document.querySelector("#copy-code")?.addEventListener("click", async (event) => {
      const button = event.currentTarget;
      try {
        await navigator.clipboard.writeText(codeElement?.textContent || "");
        button.textContent = "Copiado";
      } catch {
        button.textContent = "Copia el código manualmente";
      }
    });
  </script>}

  <script>
    type Branch = {
      id: string;
      name: string;
      address: string;
      city: string | null;
      state: string | null;
      latitude: number | null;
      longitude: number | null;
    };

    const dialog = document.querySelector<HTMLDialogElement>("#branches-dialog");
    const trigger = document.querySelector<HTMLButtonElement>("#branches-trigger");
    const closeButton = dialog?.querySelector<HTMLButtonElement>(".branches-dialog__close");
    const mapElement = dialog?.querySelector<HTMLElement>("#branches-map");
    const emptyMapMessage = dialog?.querySelector<HTMLElement>("#branches-map-empty");
    const listElement = dialog?.querySelector<HTMLUListElement>("#branches-list");
    const listStatus = dialog?.querySelector<HTMLElement>("#branches-list-status");
    const triggerCount = document.querySelector<HTMLElement>("#branches-trigger-count");
    let branches: Branch[] = [];
    let branchButtons: HTMLButtonElement[] = [];
    let branchesPromise: Promise<Branch[]> | null = null;
    let leaflet: typeof import("leaflet") | null = null;
    let map: import("leaflet").Map | null = null;
    const markerByIndex = new Map<number, import("leaflet").CircleMarker>();

    function markerStyle(selected = false): import("leaflet").CircleMarkerOptions {
      return {
        radius: selected ? 9 : 7,
        color: "#ffffff",
        weight: 2,
        fillColor: selected ? "#00395f" : "#007aa8",
        fillOpacity: 1,
      };
    }

    function selectBranch(index: number, focusMap = true): void {
      branchButtons.forEach((button) => {
        const selected = Number(button.dataset.branchIndex) === index;
        button.classList.toggle("is-selected", selected);
        button.setAttribute("aria-pressed", String(selected));
      });
      markerByIndex.forEach((marker, markerIndex) => marker.setStyle(markerStyle(markerIndex === index)));
      const marker = markerByIndex.get(index);
      const branch = branches[index];
      if (focusMap && marker && map && branch?.latitude !== null && branch?.longitude !== null) {
        map.flyTo([branch.latitude, branch.longitude], Math.max(map.getZoom(), 14), { duration: .45 });
        marker.openPopup();
      }
    }

    function renderBranches(items: Branch[]): void {
      if (!listElement || !listStatus || !emptyMapMessage) return;
      listElement.replaceChildren();
      if (items.length === 0) {
        listStatus.textContent = "No hay direcciones publicadas para este beneficio.";
        emptyMapMessage.textContent = "Bonda no publicó sucursales para este beneficio.";
        if (mapElement) mapElement.hidden = true;
        return;
      }
      listStatus.textContent = `${items.length} ${items.length === 1 ? "ubicación disponible" : "ubicaciones disponibles"}`;
      if (triggerCount) {
        triggerCount.textContent = String(items.length);
        triggerCount.hidden = false;
      }
      items.forEach((branch, index) => {
        const listItem = document.createElement("li");
        const button = document.createElement("button");
        button.type = "button";
        button.dataset.branchIndex = String(index);
        const name = document.createElement("strong");
        name.textContent = branch.name;
        button.append(name);
        if (branch.address) {
          const address = document.createElement("span");
          address.textContent = branch.address;
          button.append(address);
        }
        const location = [branch.city, branch.state].filter(Boolean).join(", ");
        if (location) {
          const small = document.createElement("small");
          small.textContent = location;
          button.append(small);
        }
        button.addEventListener("click", () => selectBranch(index));
        listItem.append(button);
        listElement.append(listItem);
      });
      branchButtons = Array.from(listElement.querySelectorAll("button"));
    }

    async function loadBranches(): Promise<Branch[]> {
      if (branchesPromise) return branchesPromise;
      const couponId = dialog?.dataset.couponId ?? "";
      branchesPromise = fetch(`/api/v1/rewards/coupons/${encodeURIComponent(couponId)}/branches`, {
        headers: { accept: "application/json" },
      })
        .then(async (response) => {
          if (!response.ok) throw new Error("branches_unavailable");
          const payload = await response.json() as { items?: Branch[] };
          branches = Array.isArray(payload.items) ? payload.items : [];
          renderBranches(branches);
          return branches;
        })
        .catch(() => {
          branches = [];
          if (listStatus) listStatus.textContent = "No pudimos cargar las sucursales. Intenta nuevamente más tarde.";
          if (emptyMapMessage) emptyMapMessage.textContent = "Las ubicaciones no están disponibles en este momento.";
          if (mapElement) mapElement.hidden = true;
          return branches;
        });
      return branchesPromise;
    }

    async function initializeMap(): Promise<void> {
      if (map || !mapElement || branches.length === 0) return;
      const plottedBranches = branches
        .map((branch, index) => ({ branch, index }))
        .filter(({ branch }) => Number.isFinite(branch.latitude) && Number.isFinite(branch.longitude));
      if (plottedBranches.length === 0) {
        mapElement.hidden = true;
        if (emptyMapMessage) {
          emptyMapMessage.hidden = false;
          emptyMapMessage.textContent = "Bonda no publicó coordenadas para estas sucursales. Puedes consultar todas las direcciones en la lista.";
        }
        return;
      }
      leaflet ??= (await import("leaflet")).default;
      const L = leaflet;
      mapElement.hidden = false;
      if (emptyMapMessage) emptyMapMessage.hidden = true;
      map = L.map(mapElement, { zoomControl: true, scrollWheelZoom: false, minZoom: 3 });
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 18,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);
      const bounds: import("leaflet").LatLngExpression[] = [];
      plottedBranches.forEach(({ branch, index }) => {
        const point: import("leaflet").LatLngExpression = [branch.latitude as number, branch.longitude as number];
        bounds.push(point);
        const marker = L.circleMarker(point, markerStyle()).addTo(map as import("leaflet").Map);
        const popupLabel = document.createElement("strong");
        popupLabel.textContent = branch.name;
        marker.bindPopup(popupLabel);
        marker.on("click", () => {
          selectBranch(index, false);
          branchButtons[index]?.scrollIntoView({ behavior: "smooth", block: "nearest" });
        });
        markerByIndex.set(index, marker);
      });
      map.fitBounds(L.latLngBounds(bounds), { padding: [24, 24], maxZoom: 13 });
    }

    trigger?.addEventListener("click", async () => {
      dialog?.showModal();
      await loadBranches();
      await initializeMap();
      window.setTimeout(() => map?.invalidateSize(), 0);
    });
    closeButton?.addEventListener("click", () => dialog?.close());
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog?.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        dialog.close();
      }
    });
    dialog?.addEventListener("close", () => trigger?.focus());

    const prefetchBranches = () => { void loadBranches(); };
    if (trigger) {
      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(prefetchBranches, { timeout: 2_000 });
      } else {
        setTimeout(prefetchBranches, 750);
      }
    }
  </script>

  <style>
