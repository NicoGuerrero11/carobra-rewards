---
import ClientShellLayout from "../../layouts/ClientShellLayout.astro";
import { getSiteBackendBaseUrl } from "../../lib/api";
import type { RewardsCustomerPortal } from "../../lib/rewards-customer-portal-contract";
import { levelLabel } from "../../lib/rewards-v2-contract";

const cookie = Astro.request.headers.get("cookie") ?? "";
let portal: RewardsCustomerPortal | null = null;
let unavailable = false;
try {
  const response = await fetch(`${getSiteBackendBaseUrl()}/api/v1/rewards/portal`, { headers: { cookie } });
  if (response.status === 401) return Astro.redirect("/login?error=unauthenticated");
  if (response.ok) portal = await response.json() as RewardsCustomerPortal;
  else unavailable = true;
} catch {
  unavailable = true;
}
const journey = portal?.journey;
const activities = portal?.activity_details.activities ?? [];
const qualifyingActivities = activities.filter((activity) => activity.qualifies).length;
const actions = portal?.actions ?? [];
const pendingActions = actions.filter((action) => action.status === "PENDING");
const positiveMovements = portal?.movement_details.movements.filter((movement) => BigInt(movement.points_delta) > 0n) ?? [];
const targetLevel = journey?.progress.target_level ? levelLabel(journey.progress.target_level) : null;
const registeredAt = journey?.journey.registered_at ? new Intl.DateTimeFormat("es-MX", { dateStyle: "long" }).format(new Date(journey.journey.registered_at)) : null;
const actionHref = (href: string | null) => href?.startsWith("#") ? null : href;
const actionStatus = (status: "PENDING" | "COMPLETED" | "INFORMATIONAL") => ({ PENDING: "Disponible", COMPLETED: "Completada", INFORMATIONAL: "Próximamente" })[status];
const actionStatusClass = (status: "PENDING" | "COMPLETED" | "INFORMATIONAL") => status === "COMPLETED" ? "status-complete" : status === "PENDING" ? "status-available" : "status-future";
const activeProducts = portal?.products.filter((product) => product.status === "ACTIVE").length ?? 0;
const earningRows = [
  { id: "registration", title: "Registro en Carobra Rewards", description: registeredAt ? `Completado el ${registeredAt}.` : "Tu cuenta ya forma parte de Rewards.", approved_points: null, status: "COMPLETED" as const, href: null },
  ...actions,
  ...(actions.length ? [] : [{ id: "first-product", title: "Confirma tu primer producto", description: "Conoce las soluciones de Carobra y habla con un asesor para activar tu camino Rewards.", approved_points: null, status: activeProducts > 0 ? "COMPLETED" as const : "PENDING" as const, href: "/cliente/productos" }]),
];
const remainingRequirements = journey?.progress.rule_available ? [journey.progress.remaining_active_products, journey.progress.remaining_registration_months, journey.progress.remaining_qualifying_activities].filter((value): value is number => value !== null).reduce((sum, value) => sum + value, 0) : null;
---

<ClientShellLayout title="Ganar puntos | Carobra Rewards" description="Consulta tus formas confirmadas de avanzar y ganar puntos." currentPath="/cliente/ganar-puntos" sectionLabel="Ganar puntos">
  <main class="portal-page earn-page">
    <header class="portal-welcome"><div><p class="portal-eyebrow">Tu avance Rewards</p><h1>Ganar puntos</h1><p>Consulta las actividades y señales reales que construyen tu perfil, sin promesas pendientes de aprobación.</p></div><span>{pendingActions.length} {pendingActions.length === 1 ? "acción pendiente" : "acciones pendientes"}</span></header>

    {unavailable && !portal ? (
      <section class="portal-card portal-empty-state" role="status"><span aria-hidden="true">!</span><div><h2>No pudimos actualizar tu avance</h2><p>Intenta de nuevo en unos minutos. No mostraremos metas o puntos estimados.</p></div></section>
    ) : portal && (
      <>
        <section class="earn-hero" aria-labelledby="earn-title">
          <div><p class="portal-eyebrow">Tu perfil</p><h2 id="earn-title">Cada acción confirmada cuenta.</h2><p>{journey?.journey.state === "INVITED" || journey?.journey.state === "BLOCKED" ? "Empieza con tu primer producto y consulta aquí cada acción disponible para tu cuenta." : targetLevel ? `Tu avance actual se dirige a ${targetLevel}. Cada valor visible corresponde a una regla aprobada.` : "Aquí verás las acciones confirmadas para tu cuenta y su efecto aprobado."}</p></div>
          <aside class="earn-hero__goal"><small>Tu siguiente meta</small><strong>{remainingRequirements === null ? "En actualización" : remainingRequirements === 0 ? "Meta completada" : `${remainingRequirements} requisitos pendientes`}</strong><span>{targetLevel ? `Camino a ${targetLevel}` : `${qualifyingActivities} actividades califican y ${positiveMovements.length} movimientos suman puntos`}</span></aside>
        </section>

        <section class="portal-section" aria-labelledby="action-values-title">
          <div class="portal-section-heading"><div><p class="portal-eyebrow">Acciones y valor</p><h2 id="action-values-title">Cómo puedes ganar puntos</h2></div><p>Los puntos aparecen solo cuando existe una regla aprobada para tu cuenta.</p></div>
          <div class="earning-table" role="table" aria-label="Acciones para ganar puntos">
            <div class="earning-table__head" role="row"><span role="columnheader">Acción</span><span role="columnheader">Valor</span><span role="columnheader">Estado</span><span role="columnheader">Acceso</span></div>
            {earningRows.map((action) => <div class="earning-table__row" role="row"><div role="cell"><strong>{action.title}</strong><p>{action.description}</p></div><span class="points-value" role="cell">{action.approved_points ? `+${action.approved_points} pts` : "Por confirmar"}</span><span class:list={["earning-table__status", actionStatusClass(action.status)]} role="cell">{actionStatus(action.status)}</span><span role="cell">{actionHref(action.href) ? <a href={actionHref(action.href)!}>Abrir</a> : "—"}</span></div>)}
          </div>
        </section>

        <section class="portal-section" aria-labelledby="earning-paths-title">
          <div class="portal-section-heading"><div><p class="portal-eyebrow">Formas de avanzar</p><h2 id="earning-paths-title">Lo que podemos confirmar hoy</h2></div><p>Los valores y requisitos aparecen únicamente cuando existe una regla activa.</p></div>
          <div class="earning-paths">
            <article><span>01</span><div><small>Perfilamiento</small><h3>Actividades asignadas</h3><p>Cuestionarios, contenidos o documentos aparecerán cuando correspondan a tu perfil.</p></div><strong>{activities.length ? `${activities.length} ${activities.length === 1 ? "registrada" : "registradas"}` : "Sin actividades registradas"}</strong></article>
            <article><span>02</span><div><small>Permanencia</small><h3>Tu relación en el tiempo</h3><p>{registeredAt ? `Tu cuenta Rewards está registrada desde ${registeredAt}.` : "La fecha de inicio aparecerá cuando esté disponible."}</p></div><strong>{journey?.progress.rule_available ? "Regla disponible" : "Meta en actualización"}</strong></article>
            <article><span>03</span><div><small>Productos</small><h3>Relación confirmada</h3><p>Los productos activos pueden influir en tu nivel cuando la regla vigente así lo determine.</p></div><a href="/cliente/productos">Ver mis productos →</a></article>
            <article><span>04</span><div><small>Renovaciones</small><h3>Disponibilidad futura</h3><p>No mostraremos puntos o fechas de renovación hasta que la función esté aprobada para tu cuenta.</p></div><strong>{journey?.modules.renewals_enabled ? "Función habilitada" : "En preparación"}</strong></article>
          </div>
        </section>

        <section class="portal-grid earn-page__detail">
          <article class="portal-card" aria-labelledby="assigned-actions-title"><p class="portal-eyebrow">Situación actual</p><h2 id="assigned-actions-title">{pendingActions.length ? `${pendingActions.length} ${pendingActions.length === 1 ? "acción disponible" : "acciones disponibles"}` : "Estás al día"}</h2><p>{pendingActions.length ? "Abre una acción desde la tabla para consultar el detalle y su valor aprobado." : "No hay actividades pendientes en este momento. Te avisaremos cuando aparezca una nueva."}</p></article>
          <article class="portal-card portal-card--dark" aria-labelledby="earning-rules-title"><p class="portal-eyebrow">Reglas claras</p><h2 id="earning-rules-title">Sin cifras inventadas</h2><p>{journey?.progress.rule_available ? "Tu cuenta ya tiene requisitos concretos disponibles; consulta el resumen de avance para verlos." : "Los límites, puntos por acción y requisitos pendientes aparecerán solo cuando estén aprobados y disponibles para tu cuenta."}</p><a class="portal-text-link" href="/cliente/recompensas">Volver a mi resumen</a></article>
        </section>
      </>
    )}
  </main>
  <script>
    import { attachLogoutHandler, requireElement } from "../../lib/client-page-utils";
    attachLogoutHandler(requireElement<HTMLButtonElement>("#logout"), "");
  </script>
  <style>
    .earn-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(16rem,.55fr);align-items:center;gap:2rem;padding:clamp(1.6rem,4vw,3rem);border-radius:1.15rem;background:#fff;box-shadow:0 8px 18px rgba(4,28,44,.07)}.earn-hero h2{margin:.35rem 0 .8rem;font-size:clamp(2.5rem,5vw,4.5rem);line-height:.94;letter-spacing:-.05em}.earn-hero>div>p:not(.portal-eyebrow){max-width:42rem;margin:0;color:#5b778e;line-height:1.65}.earn-hero__goal{display:grid;gap:.45rem;padding:1.2rem;border:1px solid #cbd7df;border-radius:.85rem;background:#f2f8fc}.earn-hero__goal small{color:#004b87;font-size:.68rem;font-weight:850;letter-spacing:.09em;text-transform:uppercase}.earn-hero__goal strong{color:#041c2c;font-size:1.25rem}.earn-hero__goal span{color:#536878;font-size:.78rem;line-height:1.5}.earning-table{margin-top:1.3rem;border:1px solid #cbd7df;border-radius:.85rem;overflow:hidden}.earning-table__head,.earning-table__row{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(7rem,.55fr) minmax(7rem,.55fr) minmax(4rem,.35fr);align-items:center;gap:1rem}.earning-table__head{padding:.7rem 1rem;color:#fff;background:#041c2c;font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.earning-table__row{padding:1rem;background:#fff;border-top:1px solid #dce5eb}.earning-table__row:nth-child(odd){background:#f7fafc}.earning-table__row strong{color:#041c2c}.earning-table__row p{margin:.25rem 0 0;color:#536878;font-size:.8rem}.earning-table__row>span{font-size:.76rem;font-weight:750}.earning-table__row a{color:#004b87;font-weight:800}.earning-table__status{width:max-content;padding:.35rem .55rem;border-radius:.45rem}.earning-paths{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem;margin-top:1.4rem}.earning-paths article{min-height:15rem;display:flex;flex-direction:column;padding:1.15rem;border:1px solid #cbd7df;border-radius:.85rem;background:#fff}.earning-paths article>span{color:#39809c;font-size:.7rem;font-weight:900}.earning-paths article>div{margin-top:1rem}.earning-paths small{color:#3d7c9c;font-size:.67rem;font-weight:900;letter-spacing:.09em;text-transform:uppercase}.earning-paths h3{margin:.3rem 0;color:#173f68;font-size:1.2rem}.earning-paths p{margin:0;color:#607990;font-size:.84rem;line-height:1.55}.earning-paths article>strong,.earning-paths article>a{margin-top:auto;padding-top:1rem;color:#176f9e;font-size:.76rem;font-weight:900}.earn-page__detail{align-items:stretch}@media(max-width:900px){.earning-paths{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.earn-hero{grid-template-columns:1fr;padding:1.35rem}.earning-paths{grid-template-columns:1fr}.earning-table{border:0;overflow:visible}.earning-table__head{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.earning-table__row{grid-template-columns:1fr 1fr;gap:.7rem;margin-bottom:.65rem;border:1px solid #cbd7df;border-radius:.85rem}.earning-table__row>div{grid-column:1/-1}}
  </style>
</ClientShellLayout>
