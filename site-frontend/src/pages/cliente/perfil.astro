---
import ClientShellLayout from "../../layouts/ClientShellLayout.astro";
import { getSiteBackendBaseUrl } from "../../lib/api";
import type { RewardsCustomerPortal } from "../../lib/rewards-customer-portal-contract";
const user = Astro.locals.user;
const cookie = Astro.request.headers.get("cookie") ?? "";
const portalLoadedWithContext = Astro.locals.rewardsPortal !== undefined;
let portal: RewardsCustomerPortal | null = Astro.locals.rewardsPortal ?? null;
if (!portalLoadedWithContext) {
  try {
    const response = await fetch(`${getSiteBackendBaseUrl()}/api/v1/rewards/portal`, { headers: { cookie } });
    if (response.status === 401) return Astro.redirect("/login?error=unauthenticated");
    if (response.ok) portal = await response.json() as RewardsCustomerPortal;
  } catch {}
}
const preferences = portal?.preferences ?? { activity_updates: true, learning_updates: true, product_updates: true };
---
<ClientShellLayout title="Mi cuenta | Carobra" description="Perfil, preferencias y seguridad de tu cuenta." currentPath="/cliente/perfil" sectionLabel="Mi cuenta">
  <main class="portal-page">
    <header class="portal-welcome"><div><p class="portal-eyebrow">Tu espacio personal</p><h1>Mi cuenta</h1><p>Consulta tus datos, elige qué avisos recibir y encuentra ayuda.</p></div><span>Cuenta protegida</span></header>
    <section class="account-grid">
      <article class="portal-card account-card">
        <p class="portal-eyebrow">Datos personales</p><h2>{user?.firstName} {user?.lastName}</h2><p>Estos son los datos asociados a tu sesión.</p>
        <dl><div><dt>Correo</dt><dd>{user?.email}</dd></div><div><dt>Nombre</dt><dd>{user?.firstName} {user?.lastName}</dd></div></dl>
        <a href="mailto:soporte@carobra.mx?subject=Actualizar%20datos%20de%20mi%20cuenta">Solicitar una corrección</a>
      </article>
      <article class="portal-card account-card">
        <p class="portal-eyebrow">Seguridad</p><h2>Protege tu acceso</h2><p>Carobra nunca te pedirá tu contraseña por correo o teléfono.</p>
        <ul><li>Usa una contraseña única.</li><li>Cierra sesión en equipos compartidos.</li><li>Reporta cualquier actividad que no reconozcas.</li></ul>
        <a href="mailto:soporte@carobra.mx?subject=Ayuda%20con%20mi%20acceso">Ayuda con mi acceso</a>
      </article>
    </section>
    <section class="portal-section" aria-labelledby="preferences-title">
      <div class="portal-section-heading"><div><p class="portal-eyebrow">Preferencias</p><h2 id="preferences-title">Elige qué actualizaciones recibir</h2></div><p>Puedes cambiar estas opciones cuando quieras.</p></div>
      <form id="preferences-form" class="preferences-form">
        <label><span><strong>Actividad de Rewards</strong><small>Cuestionarios, documentos y movimientos relevantes.</small></span><input name="activity_updates" type="checkbox" checked={preferences.activity_updates} /></label>
        <label><span><strong>Cursos y contenidos</strong><small>Nuevos aprendizajes asignados y recordatorios de avance.</small></span><input name="learning_updates" type="checkbox" checked={preferences.learning_updates} /></label>
        <label><span><strong>Actualizaciones de productos</strong><small>Confirmaciones y cambios visibles en tu cuenta.</small></span><input name="product_updates" type="checkbox" checked={preferences.product_updates} /></label>
        <div><button type="submit">Guardar preferencias</button><p id="preferences-feedback" role="status"></p></div>
      </form>
    </section>
    <section class="help-center account-support"><div><p class="rewards-eyebrow">Soporte</p><h2>¿Necesitas hablar con nosotros?</h2><p>Explícanos qué necesitas y el equipo de Carobra revisará tu caso.</p></div><a href="mailto:soporte@carobra.mx">Contactar soporte</a></section>
  </main>
  <script>
    import { attachLogoutHandler, requireElement } from "../../lib/client-page-utils";
    attachLogoutHandler(requireElement<HTMLButtonElement>("#logout"), "");
    const form = requireElement<HTMLFormElement>("#preferences-form");
    const feedback = requireElement<HTMLElement>("#preferences-feedback");
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const values = new FormData(form);
      const response = await fetch("/api/v1/rewards/portal/preferences", { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify({ activity_updates: values.has("activity_updates"), learning_updates: values.has("learning_updates"), product_updates: values.has("product_updates") }) });
      feedback.textContent = response.ok ? "Preferencias guardadas." : "No pudimos guardar tus preferencias. Intenta de nuevo.";
    });
  </script>
</ClientShellLayout>
