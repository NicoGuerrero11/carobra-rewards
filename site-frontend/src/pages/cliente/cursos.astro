---
import ClientShellLayout from "../../layouts/ClientShellLayout.astro";
---

<ClientShellLayout title="Cursos | Carobra" description="Próximamente, cursos y contenidos para clientes Carobra." currentPath="/cliente/cursos" sectionLabel="Cursos">
  <main class="courses-coming-soon">
    <section aria-labelledby="courses-coming-soon-title">
      <p>Cursos</p>
      <h1 id="courses-coming-soon-title">Próximamente</h1>
    </section>
  </main>

  <script>
    import { attachLogoutHandler, requireElement } from "../../lib/client-page-utils";
    attachLogoutHandler(requireElement<HTMLButtonElement>("#logout"), "");
  </script>

  <style>
    .courses-coming-soon{width:min(74rem,calc(100% - 2.2rem));min-height:calc(100vh - 4.6rem);display:grid;place-items:center;margin:0 auto;padding:3rem 0}.courses-coming-soon section{text-align:center}.courses-coming-soon p{margin:0 0 .8rem;color:#176f9e;font-size:.78rem;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.courses-coming-soon h1{margin:0;color:#041c2c;font-size:clamp(4rem,12vw,9rem);line-height:.9;letter-spacing:-.065em}@media(max-width:760px){.courses-coming-soon{width:min(100% - 1.1rem,74rem);min-height:calc(100vh - 9rem)}.courses-coming-soon h1{font-size:clamp(3.3rem,17vw,5.5rem)}}
  </style>
</ClientShellLayout>
