---
import ClientShellLayout from "../../layouts/ClientShellLayout.astro";

const user = Astro.locals.user;
const statusLabel = "Miembro invitado";
const validationTitle = "Tu producto está pendiente de confirmación";
const validationMessage = "Tu cuenta Rewards sigue disponible como Invitado. Puedes recorrer todas las secciones mientras Carobra confirma un producto activo; las acciones que requieren validación permanecerán deshabilitadas.";
---

<ClientShellLayout
  title="Validación AFORE | Carobra Rewards"
  description="Consulta el estado de tu validación AFORE."
  currentPath="/cliente/validacion"
  sectionLabel="Validación AFORE"
>
  <main class="client-page client-page--soft-separators">
    <section class="client-home-hero client-section--roomy mt-4 py-16">
      <div class="client-home-hero__inner">
        <div>
          <p class="client-home-hero__kicker">Cuenta Carobra Rewards</p>
          <h1>Hola, {user?.firstName ?? "cliente"}</h1>
          <p class="mt-3 max-w-2xl text-sm text-[#dcecff] sm:text-base">
            Ya puedes consultar tu experiencia Rewards como Invitado mientras confirmamos tu primer producto.
          </p>
        </div>
        <article class="client-card min-w-0 p-5 sm:min-w-[18rem]" aria-label="Estado de cuenta">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-[#587795]">Estado de cuenta</p>
          <p class="mt-2 text-xl font-extrabold text-[#14355f]">{statusLabel}</p>
          <p class="mt-2 text-sm text-[#4f6f90]">Tu historial permanece protegido.</p>
        </article>
      </div>
    </section>

    <section class="grid gap-6 lg:grid-cols-[1.35fr_0.65fr]">
      <article class="client-card p-6 sm:p-8" aria-labelledby="validation-title">
        <p class="text-xs font-bold uppercase tracking-[0.12em] text-[#587795]">Validación AFORE</p>
        <h2 id="validation-title" class="mt-2 text-2xl font-extrabold text-[#14355f]">
          {validationTitle}
        </h2>
        <p class="mt-3 text-sm leading-6 text-[#4f6f90]">
          {validationMessage}
        </p>
        <p class="mt-4 text-sm font-semibold text-[#244b73]">No necesitas repetir tu registro ni proporcionar referencias internas.</p>
      </article>

      <aside class="client-card p-6" aria-labelledby="pending-access-title">
        <h2 id="pending-access-title" class="text-xl font-extrabold text-[#14355f]">Mientras confirmamos tu producto</h2>
        <p class="mt-3 text-sm leading-6 text-[#4f6f90]">
          Puedes consultar tu saldo, productos, beneficios y actividad. El canje y otras acciones que requieren un producto confirmado seguirán protegidos.
        </p>
        <a class="mt-5 inline-flex font-bold text-[#0c5f9e]" href="mailto:soporte@carobra.mx">Contactar soporte</a>
      </aside>
    </section>
  </main>
  <script>
    import { attachLogoutHandler, requireElement } from "../../lib/client-page-utils";
    attachLogoutHandler(requireElement<HTMLButtonElement>("#logout"), "");
  </script>
</ClientShellLayout>
