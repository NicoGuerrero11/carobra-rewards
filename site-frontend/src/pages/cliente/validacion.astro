---
import ClientShellLayout from "../../layouts/ClientShellLayout.astro";
import { getSiteBackendBaseUrl } from "../../lib/api";

interface ValidationStatusResponse {
  validation_id: string;
  status: string;
  registered_at: string;
  next_checkpoint: string | null;
  next_checkpoint_at: string | null;
}

const user = Astro.locals.user;
const eligibility = Astro.locals.rewardsEligibility;
let validation: ValidationStatusResponse | null = null;
let unavailable = false;
try {
  const response = await fetch(`${getSiteBackendBaseUrl()}/api/v1/me/validation-status`, {
    headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
  });
  if (response.status === 401) return Astro.redirect("/login?error=unauthenticated");
  if (response.ok) validation = (await response.json()) as ValidationStatusResponse;
  else unavailable = true;
} catch {
  unavailable = true;
}

const registeredAt = validation?.registered_at
  ? new Intl.DateTimeFormat("es-MX", { dateStyle: "medium", timeStyle: "short" })
      .format(new Date(validation.registered_at))
  : null;
const isInactive = eligibility?.reason === "customer_inactive"
  || user?.customerStatus === "INACTIVE";
const requiresAttention = validation?.status === "REQUIRES_ATTENTION"
  || eligibility?.sisca_validation_status === "REQUIRES_ATTENTION";
const statusLabel = unavailable
  ? "Consulta no disponible"
  : isInactive
    ? "Cuenta inactiva"
    : requiresAttention
      ? "Requiere atención"
      : "Pendiente de validación";
const validationTitle = unavailable
  ? "No pudimos consultar tu validación"
  : isInactive
    ? "Cuenta inactiva"
    : requiresAttention
      ? "Tu validación requiere atención"
      : "Validación AFORE pendiente";
const validationMessage = unavailable
  ? "El servicio no está disponible por el momento. Intenta actualizar la página más tarde."
  : isInactive
    ? "Tu cuenta no está activa actualmente. Contacta a soporte para revisar el estado de tu servicio antes de acceder a Rewards."
    : requiresAttention
      ? "No pudimos completar la validación automáticamente. Nuestro equipo necesita revisar tu caso antes de habilitar Rewards."
      : "Tu cuenta ya fue registrada. Estamos esperando el resultado de validación de tu AFORE.";
---

<ClientShellLayout
  title="Validación AFORE | Carobra Rewards"
  description="Consulta el estado de tu validación AFORE."
  currentPath="/cliente/validacion"
  sectionLabel="Validación AFORE"
>
  <main class="client-page client-page--soft-separators">
    <section class="client-home-hero client-section--roomy mt-4 py-16">
      <div class="client-home-hero__inner">
        <div>
          <p class="client-home-hero__kicker">Cuenta Carobra Rewards</p>
          <h1>Hola, {user?.firstName ?? "cliente"}</h1>
          <p class="mt-3 max-w-2xl text-sm text-[#dcecff] sm:text-base">
            Tu acceso a Rewards se habilitará cuando la validación de tu servicio AFORE quede completada.
          </p>
        </div>
        <article class="client-card min-w-0 p-5 sm:min-w-[18rem]" aria-label="Estado de cuenta">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-[#587795]">Estado de cuenta</p>
          <p class="mt-2 text-xl font-extrabold text-[#14355f]">{statusLabel}</p>
          <p class="mt-2 text-sm text-[#4f6f90]">Rewards ID: {user?.rewardsId || "No disponible"}</p>
        </article>
      </div>
    </section>

    <section class="grid gap-6 lg:grid-cols-[1.35fr_0.65fr]">
      <article class="client-card p-6 sm:p-8" aria-labelledby="validation-title">
        <p class="text-xs font-bold uppercase tracking-[0.12em] text-[#587795]">Validación AFORE</p>
        <h2 id="validation-title" class="mt-2 text-2xl font-extrabold text-[#14355f]">
          {validationTitle}
        </h2>
        <p class="mt-3 text-sm leading-6 text-[#4f6f90]">
          {validationMessage}
        </p>
        {registeredAt && (
          <dl class="mt-6 grid gap-4 rounded-2xl bg-[#f8fbff] p-4 sm:grid-cols-2">
            <div>
              <dt class="text-xs font-bold uppercase tracking-[0.08em] text-[#587795]">Registro</dt>
              <dd class="mt-1 text-sm font-semibold text-[#244b73]">{registeredAt}</dd>
            </div>
            <div>
              <dt class="text-xs font-bold uppercase tracking-[0.08em] text-[#587795]">Referencia</dt>
              <dd class="mt-1 break-all text-sm font-semibold text-[#244b73]">{validation?.validation_id}</dd>
            </div>
          </dl>
        )}
        {validation?.next_checkpoint && (
          <p class="mt-4 text-sm text-[#4f6f90]">
            Próxima revisión: <strong>{validation.next_checkpoint}</strong>
          </p>
        )}
      </article>

      <aside class="client-card p-6" aria-labelledby="pending-access-title">
        <h2 id="pending-access-title" class="text-xl font-extrabold text-[#14355f]">Mientras validamos</h2>
        <p class="mt-3 text-sm leading-6 text-[#4f6f90]">
          Tu saldo, formas de ganar, beneficios y redenciones permanecerán protegidos hasta que cumplas la elegibilidad.
        </p>
        <a class="mt-5 inline-flex font-bold text-[#0c5f9e]" href="mailto:soporte@carobra.mx">Contactar soporte</a>
      </aside>
    </section>
  </main>
  <script>
    import { attachLogoutHandler, requireElement } from "../../lib/client-page-utils";
    attachLogoutHandler(requireElement<HTMLButtonElement>("#logout"), "");
  </script>
</ClientShellLayout>
