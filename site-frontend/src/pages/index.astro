---
import BaseLayout from "../layouts/BaseLayout.astro";

const navLinks = [
  { label: "Beneficios", href: "#beneficios" },
  { label: "Cómo funciona", href: "#experiencia" },
  { label: "Confianza", href: "#confianza" },
];

const soporteLinks = [
  { label: "Términos", href: "#terminos" },
  { label: "Privacidad", href: "#privacidad" },
  { label: "Ayuda", href: "#ayuda" },
  { label: "Contacto", href: "#contacto" },
];

const timelineSteps = [
  {
    number: "01",
    title: "Únete a Rewards",
    text: "Crea tu cuenta para reunir en un solo lugar tu relación y tus avances con Carobra.",
  },
  {
    number: "02",
    title: "Validamos tu relación",
    text: "Confirmamos tus productos Carobra de forma segura para mostrarte el nivel que te corresponde.",
  },
  {
    number: "03",
    title: "Avanza y disfruta",
    text: "Consulta tus puntos, descubre tus siguientes pasos y explora los beneficios habilitados para ti.",
  },
];

---

<BaseLayout>
  <div class="landing-page">
    <header id="inicio" class="landing-header">
      <div class="shell landing-header__inner">
        <a href="/" class="brand">
          <img
            src="/images/carobra-logo-horizontal-cropped.png"
            alt="Carobra Consultores Especializados"
            class="brand__logo"
            loading="eager"
            decoding="async"
          />
        </a>
        <nav class="landing-nav" aria-label="Navegación principal">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
        <div class="landing-header__actions">
          <a href="/login" class="landing-header__signin">Iniciar sesión</a>
          <a href="/registro" class="btn-primary btn-compact">Únete a Rewards</a>
        </div>
      </div>
    </header>

    <main>
      <section class="landing-hero">
        <div class="shell landing-hero__grid">
          <div class="landing-hero__copy">
            <span class="pill">El programa de lealtad de Carobra</span>
            <h1>
              Tu relación con Carobra
              <span>ahora te da más.</span>
            </h1>
            <p>
              Carobra Rewards reconoce tu confianza y cada paso que das con nosotros.
              Consulta tu nivel, suma puntos y descubre beneficios pensados para acompañar tus metas.
            </p>
            <div class="landing-hero__actions">
              <a href="/registro" class="btn-primary">
                Quiero ser parte <span aria-hidden="true">→</span>
              </a>
              <a href="#experiencia" class="btn-secondary">Descubre cómo funciona</a>
            </div>
          </div>

          <aside class="hero-preview" aria-label="Vista del progreso en Carobra Rewards">
            <div class="hero-preview__badge">Tu experiencia Rewards</div>
            <h2>Crece con Carobra</h2>
            <div class="hero-preview__points">
              <p>Tu nivel</p>
              <strong>Siempre visible</strong>
            </div>
            <div class="hero-preview__meta">
              <span>Progreso</span>
              <span>En un solo lugar</span>
            </div>
            <div class="hero-preview__track" role="presentation">
              <span style="width: 66%"></span>
            </div>
            <div class="hero-preview__foot">
              <span>Siguiente meta</span>
              <span>Una experiencia para ti</span>
            </div>
          </aside>
        </div>
      </section>

      <section id="beneficios" class="capabilities">
        <div class="shell">
          <header class="section-heading">
            <h2>Más valor en cada paso con Carobra</h2>
            <p>Una experiencia que reúne tu progreso, tus puntos y las oportunidades disponibles para ti.</p>
          </header>

          <div class="capabilities-grid">
            <article class="capability-card capability-card--wide">
              <div class="capability-card__content">
                <div class="capability-card__icon">▣</div>
                <h3>Tu relación sí cuenta</h3>
                <p>
                  Cada producto confirmado y cada actividad aprobada ayudan a construir tu experiencia dentro de Rewards.
                </p>
                <a href="/registro" class="capability-card__link">Comenzar mi experiencia</a>
              </div>
              <div class="capability-visual" aria-hidden="true">
                <div class="capability-visual__head">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
                <div class="capability-visual__bars">
                  <span style="height: 35%"></span>
                  <span style="height: 52%"></span>
                  <span style="height: 72%"></span>
                  <span style="height: 63%"></span>
                  <span style="height: 84%"></span>
                  <span style="height: 58%"></span>
                </div>
                <div class="capability-visual__line"></div>
              </div>
            </article>

            <article class="capability-card capability-card--dark">
              <div class="capability-card__icon">◉</div>
              <h3>Beneficios para disfrutar</h3>
              <p>Explora las experiencias y opciones que se encuentren habilitadas para tu cuenta.</p>
            </article>

            <article class="capability-card">
              <div class="capability-card__icon">◌</div>
              <h3>Progreso que puedes ver</h3>
              <p>Conoce tu nivel, revisa tus puntos y entiende qué puedes hacer para seguir avanzando.</p>
              <div class="capability-chips" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
                <span class="is-active">Rewards</span>
              </div>
            </article>

            <article class="capability-card capability-card--split">
              <div class="capability-control">
                <div class="capability-card__icon">⛨</div>
                <h3>Todo en un solo lugar</h3>
                <p>Entra de forma segura para consultar tus productos, movimientos y oportunidades Rewards.</p>
                <a href="/login" class="btn-primary btn-compact capability-control__button">Entrar a mi cuenta</a>
              </div>
              <div class="split-stats">
                <div class="split-stats__block">
                  <span>Tu nivel</span>
                  <strong>Claro</strong>
                </div>
                <div class="split-stats__block">
                  <span>Tus puntos</span>
                  <strong>Al día</strong>
                </div>
                <div class="split-stats__status">
                  <span>Tu siguiente paso</span>
                  <strong>Siempre a la vista</strong>
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="experiencia" class="experience">
        <div class="shell experience-grid">
          <aside class="experience-intro">
            <h2>
              Empieza hoy y
              <span>crece con nosotros</span>
            </h2>
            <p>Un camino sencillo para convertir tu relación con Carobra en una experiencia con más valor.</p>
            <blockquote>
              "Tu progreso se construye paso a paso. Nosotros te ayudamos a verlo y aprovecharlo."
            </blockquote>
          </aside>

          <div class="experience-timeline">
            {timelineSteps.map((step, index) => (
              <article class="experience-step">
                <span class="experience-step__dot" data-variant={index}></span>
                <p class="experience-step__number">{step.number}</p>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="confianza" class="trust">
        <div class="shell trust__inner">
          <h2>Un programa que crece contigo</h2>
          <p>
            Tú ves información clara y beneficios disponibles para tu cuenta. Carobra protege tus datos y confirma cada avance antes de mostrarlo.
          </p>
          <div class="trust__actions">
            <a href="/registro" class="btn-primary trust__cta">Únete a Carobra Rewards</a>
            <a href="/login" class="btn-secondary btn-secondary--dark trust__cta-secondary">Iniciar sesión</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="landing-footer">
      <div class="shell landing-footer__grid">
        <section>
          <a href="/" class="landing-footer__brand" aria-label="Carobra inicio">
            <img
              src="/images/carobra-logo-horizontal-cropped.png"
              alt="Carobra Consultores Especializados"
              class="landing-footer__logo"
              loading="lazy"
              decoding="async"
            />
          </a>
          <p>El programa que reconoce tu confianza y te acompaña a avanzar con Carobra.</p>
          <p class="landing-footer__copy">© 2026 Carobra Rewards. Todos los derechos reservados.</p>
        </section>

        <section>
          <h3>Legal</h3>
          <a href="#terminos">Términos de uso</a>
          <a href="#privacidad">Política de privacidad</a>
          <p id="terminos" class="landing-footer__meta">Consulta las condiciones de participación y uso del programa.</p>
          <p id="privacidad" class="landing-footer__meta">Conoce cómo protegemos y utilizamos tus datos.</p>
        </section>

        <section id="ayuda">
          <h3>Soporte</h3>
          <a href="/login">Acceso a cuenta</a>
          <a id="contacto" href="mailto:soporte@carobra.mx">Contacto</a>
        </section>

        <section>
          <h3>Explorar</h3>
          {soporteLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </section>
      </div>
    </footer>
  </div>
</BaseLayout>
