---
import BaseLayout from "../layouts/BaseLayout.astro";
import InstitutionalVideo from "../components/InstitutionalVideo.astro";
import PublicProducts from "../components/PublicProducts.astro";
import PublicCouponBrands from "../components/PublicCouponBrands.astro";
import PublicLearningPreview from "../components/PublicLearningPreview.astro";
import PublicRewardsValue from "../components/PublicRewardsValue.astro";
import PublicHowItWorks from "../components/PublicHowItWorks.astro";
import PublicAbout from "../components/PublicAbout.astro";
import PublicClosingCta from "../components/PublicClosingCta.astro";

const navLinks = [
  { label: "Beneficios", href: "#beneficios" },
  { label: "Productos", href: "#productos" },
  { label: "Cómo funciona", href: "#experiencia" },
  { label: "Quiénes somos", href: "#quienes-somos" },
  { label: "Confianza", href: "#confianza" },
];

const soporteLinks = [
  { label: "Catálogo", href: "#catalogo" },
  { label: "Términos", href: "#terminos" },
  { label: "Privacidad", href: "#privacidad" },
  { label: "Ayuda", href: "#ayuda" },
  { label: "Contacto", href: "#contacto" },
];

---

<BaseLayout>
  <div class="landing-page">
    <header id="inicio" class="landing-header">
      <div class="shell landing-header__inner">
        <a href="/" class="brand">
          <img
            src="/images/carobra-logo-horizontal-cropped.png"
            alt="Carobra Consultores Especializados"
            class="brand__logo"
            loading="eager"
            decoding="async"
          />
        </a>
        <nav class="landing-nav" aria-label="Navegación principal">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
        <div class="landing-header__actions">
          <a href="/login" class="landing-header__signin">Iniciar sesión</a>
          <a href="/registro" class="btn-primary btn-compact">Únete a Rewards</a>
        </div>
      </div>
    </header>

    <main>
      <section class="landing-hero">
        <div class="shell landing-hero__grid">
          <div class="landing-hero__copy">
            <span class="pill">El programa de lealtad de Carobra</span>
            <h1>
              Tu relación con Carobra
              <span>ahora te da más.</span>
            </h1>
            <p>
              Carobra Rewards reconoce tu confianza y cada paso que das con nosotros.
              Consulta tu nivel, suma puntos y descubre beneficios pensados para acompañar tus metas.
            </p>
            <div class="landing-hero__actions">
              <a href="/registro" class="btn-primary">
                Quiero ser parte <span aria-hidden="true">→</span>
              </a>
              <a href="#experiencia" class="btn-secondary">Descubre cómo funciona</a>
            </div>
          </div>

          <InstitutionalVideo />
        </div>
      </section>

      <PublicProducts />

      <PublicCouponBrands />

      <PublicLearningPreview />

      <PublicRewardsValue />

      <PublicHowItWorks />

      <PublicAbout />

      <PublicClosingCta />
    </main>

    <footer class="landing-footer">
      <div class="shell landing-footer__grid">
        <section>
          <a href="/" class="landing-footer__brand" aria-label="Carobra inicio">
            <img
              src="/images/carobra-logo-horizontal-cropped.png"
              alt="Carobra Consultores Especializados"
              class="landing-footer__logo"
              loading="lazy"
              decoding="async"
            />
          </a>
          <p>El programa que reconoce tu confianza y te acompaña a avanzar con Carobra.</p>
          <p class="landing-footer__copy">© 2026 Carobra Rewards. Todos los derechos reservados.</p>
        </section>

        <section>
          <h3>Legal</h3>
          <a href="#terminos">Términos de uso</a>
          <a href="#privacidad">Política de privacidad</a>
          <p id="terminos" class="landing-footer__meta">Consulta las condiciones de participación y uso del programa.</p>
          <p id="privacidad" class="landing-footer__meta">Conoce cómo protegemos y utilizamos tus datos.</p>
        </section>

        <section id="ayuda">
          <h3>Soporte</h3>
          <a href="/login">Acceso a cuenta</a>
          <a id="contacto" href="mailto:soporte@carobra.mx">Contacto</a>
        </section>

        <section>
          <h3>Explorar</h3>
          {soporteLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </section>
      </div>
    </footer>
  </div>
</BaseLayout>
