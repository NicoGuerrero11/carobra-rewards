---
interface Props { id: string; title: string; }
const { id, title } = Astro.props;
---
<details class="help-question" id={id}>
  <summary>
    <span>{title}</span>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
  </summary>
  <div class="help-answer"><slot /></div>
</details>
