---
import BondaPointsBalance from "./BondaPointsBalance.astro";
import RewardsMemberNumber from "./RewardsMemberNumber.astro";
import { giftCardReadiness } from "../lib/rewards-member";
import type { RewardsJourneySummary } from "../lib/rewards-v2-contract";
interface Props { journey?: RewardsJourneySummary | null; rewardsId?: string | null; }
const { journey, rewardsId } = Astro.props;
const state = giftCardReadiness(journey?.journey.state, journey?.journey.current_level, rewardsId);
const visible = state === "level_met" || state === "identity_pending";
// Authorized public destination. Never append identity or session data.
const micrositeUrl = "https://carobrarewards.bonda.com";
---
{visible && <section id="gift-cards" class="gift-access" aria-labelledby="gift-access-title" data-state={state}>
  <div class="gift-access__intro">
    <p class="gift-access__eyebrow"><span aria-hidden="true">✦</span> Gift cards <span class="gift-access__badge">Desde Oro</span></p>
    <h2 id="gift-access-title">Convierte tus puntos en algo para ti</h2>
    <p>Elige del catálogo completo de gift cards y encuentra tu próximo gusto.</p>
    <p class="gift-access__rate">3 puntos <span>=</span> $1 MXN</p>
    <BondaPointsBalance balance={journey?.points.bonda} />
  </div>
  <div class="gift-access__access">
    <p class="gift-access__instructions">Usa tu número de socio para ingresar</p>
    <RewardsMemberNumber rewardsId={rewardsId} />
    {state === "level_met" ? (
      <a class="gift-access__button" href={micrositeUrl} target="_blank" rel="noopener noreferrer">Ver gift cards <span aria-hidden="true">↗</span><span class="sr-only"> (abre en otra pestaña)</span></a>
    ) : (
      <><button class="gift-access__button" type="button" disabled>Ver gift cards <span aria-hidden="true">↗</span></button><p class="gift-access__note">Necesitamos confirmar tu número de socio para continuar.</p></>
    )}
    <p class="gift-access__help">¿Necesitas ayuda para ingresar? <a href="/cliente/ayuda">Te ayudamos</a></p>
  </div>
</section>}
<style>
.gift-access{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:2rem;margin:1.5rem 0;padding:2rem;border:1px solid #d4e3e7;border-radius:1.4rem;background:linear-gradient(120deg,#ecf4f6,#fff 80%);color:#163f56;overflow:hidden}.gift-access__eyebrow{display:flex;align-items:center;gap:.6rem;margin:0 0 1.1rem;font-size:.76rem;font-weight:800}.gift-access__eyebrow>span:first-child{font-size:1.35rem;color:#287d8d}.gift-access__badge{margin-left:auto;border:1px solid #c9b87e;border-radius:999px;padding:.3rem .6rem;background:#fffbef;color:#785d20;font-size:.65rem;font-weight:700}.gift-access h2{max-width:22ch;margin:0 0 .8rem;font-size:clamp(1.5rem,2.8vw,2rem);line-height:1.2;font-weight:750;letter-spacing:-.04em}.gift-access p{font-size:.82rem;line-height:1.6}.gift-access__intro>p:not(.gift-access__eyebrow){max-width:42ch}.gift-access .gift-access__rate{margin:1rem 0 .15rem;font-size:.85rem;font-weight:800}.gift-access__rate span{margin:0 .45rem;font-weight:400}.gift-access__access{align-self:center;min-width:0;padding:1.4rem;border:1px solid #d6e2e8;border-radius:1rem;background:#ffffffd9}.gift-access .gift-access__instructions{margin:0 0 .8rem;font-weight:700;font-size:.8rem}.gift-access__button{display:flex;align-items:center;justify-content:space-between;gap:.8rem;min-height:48px;width:100%;padding:.8rem 1rem;border:0;border-radius:.7rem;background:#17466a;color:#fff;font:inherit;font-size:.84rem;font-weight:800;text-decoration:none;box-sizing:border-box}.gift-access__button:hover{background:#103b5c}.gift-access__button:disabled{background:#e6edf0;color:#687a83;cursor:not-allowed}.gift-access .gift-access__help,.gift-access .gift-access__note{font-size:.68rem;line-height:1.6;margin:.8rem 0 0;color:#526b78}.gift-access__help a{color:#17466a;font-weight:700;text-underline-offset:3px}.gift-access a:focus-visible{outline:3px solid #187e9c;outline-offset:4px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:700px){.gift-access{grid-template-columns:1fr;padding:1.3rem;gap:1rem}.gift-access h2{max-width:24ch}.gift-access__access{padding:1rem}.gift-access__intro>p:not(.gift-access__eyebrow){max-width:none}}
</style>
