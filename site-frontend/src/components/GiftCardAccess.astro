---
import RewardsMemberNumber from "./RewardsMemberNumber.astro";
import { giftCardReadiness } from "../lib/rewards-member";
import type { RewardsJourneySummary } from "../lib/rewards-v2-contract";
interface Props { journey?: RewardsJourneySummary | null; rewardsId?: string | null; }
const { journey, rewardsId } = Astro.props;
const state = giftCardReadiness(journey?.journey.state, journey?.journey.current_level, rewardsId);
const messages = {
  unavailable: ["No pudimos confirmar tu nivel", "Vuelve a consultar tu cuenta para conocer tu avance. El acceso permanece en preparación."],
  restricted: ["Revisa el estado de tu cuenta", "Necesitamos confirmar el estado de tu cuenta antes de continuar. Puedes consultar Ayuda."],
  below_level: ["Tu próximo destino: Oro", "Las gift cards comienzan en Oro. Sigue tu avance desde Inicio para conocer tu nivel actual."],
  identity_pending: ["Tu nivel cumple el requisito", "Tu número de socio no está disponible. Consulta Ayuda antes de acceder a Bonda."],
  level_met: ["Tu nivel cumple el requisito", "El acceso a Bonda está en preparación. Te mostraremos el enlace cuando esté habilitado para tu cuenta."],
};
---
<section id="gift-cards" class="gift-access" aria-labelledby="gift-access-title" data-state={state}>
  <div class="gift-access__intro">
    <p class="gift-access__eyebrow">Gift cards · Bonda</p>
    <h2 id="gift-access-title">Más posibilidades con tus puntos</h2>
    <p>Desde Oro, accede al catálogo completo de gift cards, sin un límite de catálogo por nivel.</p>
    <div class="gift-access__rules"><span>Oro · Platino · Titanio</span><strong>3 puntos = $1 MXN</strong></div>
    <p class="gift-access__note">La conversión es una regla del programa. Tus puntos Rewards no indican un saldo disponible en Bonda.</p>
  </div>
  <div class="gift-access__access">
    <span class="gift-access__badge">Acceso en preparación</span>
    <h3>{messages[state][0]}</h3>
    <p>{messages[state][1]}</p>
    <RewardsMemberNumber rewardsId={rewardsId} />
    <p class="gift-access__instructions">Cuando se habilite el acceso, usarás tu Número de socio Rewards en Bonda y podrás crear allí tu contraseña.</p>
    <!-- No external URL or activation handler until the server and partner access contract is approved. -->
    <button class="gift-access__button" type="button" disabled aria-describedby="gift-access-pending">Ir a Bonda <span aria-hidden="true">↗</span></button>
    <p id="gift-access-pending" class="gift-access__note">Estamos preparando la habilitación de tu cuenta en Bonda.</p>
    <a href={state === "restricted" || state === "identity_pending" ? "/cliente/ayuda" : "/cliente/recompensas"}>{state === "restricted" || state === "identity_pending" ? "Ir a Ayuda" : "Ver mi avance"} <span aria-hidden="true">→</span></a>
  </div>
</section>
<style>
  .gift-access{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin:1.5rem 0;padding:2rem;border:1px solid #d7e1e8;border-radius:1.4rem;background:linear-gradient(115deg,#edf6fa,#fff 65%);color:#173f59}.gift-access__eyebrow{margin:0 0 .7rem;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;font-weight:800;color:#496579}.gift-access h2{margin:0 0 1rem;font-size:clamp(1.5rem,2.7vw,2rem);line-height:1.15;max-width:18ch}.gift-access p{font-size:.86rem;line-height:1.65}.gift-access__rules{display:flex;flex-wrap:wrap;gap:.65rem;margin:1.2rem 0}.gift-access__rules>*{padding:.45rem .7rem;border-radius:.6rem;background:#fff;border:1px solid #d7e1e8;font-size:.75rem}.gift-access .gift-access__note{font-size:.73rem;color:#526d80}.gift-access__access{min-width:0}.gift-access__badge{display:inline-block;padding:.35rem .65rem;border-radius:999px;background:#f3e8cf;color:#71551d;font-size:.68rem;font-weight:800}.gift-access h3{font-size:1rem;margin:1rem 0 .3rem}.gift-access__access>p{margin:.4rem 0 1rem}.gift-access .gift-access__instructions{font-size:.77rem}.gift-access__button{display:flex;align-items:center;justify-content:center;gap:1.5rem;width:100%;min-height:44px;padding:.75rem;border:1px solid #ccd7df;border-radius:.75rem;color:#556979;background:#e8eef2;font:inherit;font-weight:700;font-size:.82rem;cursor:not-allowed}.gift-access a{font-size:.8rem;font-weight:800;text-decoration:underline;text-underline-offset:4px}.gift-access a:focus-visible{outline:3px solid #176f9e;outline-offset:3px}@media(max-width:700px){.gift-access{grid-template-columns:1fr;padding:1.2rem;gap:1.3rem}.gift-access h2{max-width:none}.gift-access__access{padding-top:1.2rem;border-top:1px solid #d7e1e8}}
</style>
