---
const levels = [
  { name: 'Bronce', id: 'BRONZE' },
  { name: 'Plata', id: 'SILVER' },
  { name: 'Oro', id: 'GOLD' },
  { name: 'Platino', id: 'PLATINUM' },
  { name: 'Titanio', id: 'TITANIUM' },
];
const messages = [
  {
    title: 'Tu relación cuenta.',
    text: 'Tus productos confirmados suman a tu experiencia Rewards.',
    icon: 'M8 12.5l2.5 2.5L16 9.5 M12 3l8 3v6c0 4.5-8 9-8 9s-8-4.5-8-9V6l8-3Z',
  },
  {
    title: 'Más posibilidades según tu nivel.',
    text: 'Descubre los beneficios y cursos disponibles para ti.',
    icon: 'M3 9h18v4H3z M5 13v8h14v-8 M12 9v12 M12 9H8a3 3 0 1 1 3-3l1 3Zm0 0h4a3 3 0 1 0-3-3l-1 3Z',
  },
  {
    title: 'Tu progreso, a la vista.',
    text: 'Consulta tus puntos, nivel y movimientos desde tu cuenta.',
    icon: 'M4 4h6v6H4z M14 4h6v6h-6z M4 14h6v6H4z M14 14h6v6h-6z',
  },
];
---

<section id="beneficios" class="rewards-value" aria-labelledby="rewards-value-title">
  <div class="shell">
    <header class="rewards-value__heading">
      <p class="rewards-value__eyebrow">Ser parte tiene valor</p>
      <h2 id="rewards-value-title">Tu confianza te lleva <span>más lejos.</span></h2>
      <p class="rewards-value__intro">Tu relación con Carobra, reconocida con más posibilidades para ti.</p>
    </header>

    <div class="rewards-value__layout">
      <div class="rewards-value__levels" aria-labelledby="rewards-levels-title">
        <p class="rewards-value__eyebrow">Niveles Rewards</p>
        <h3 id="rewards-levels-title">Una experiencia que crece contigo.</h3>
        <div class="rewards-value__path">
          <svg class="rewards-value__connector" viewBox="0 0 500 170" preserveAspectRatio="none" fill="none" aria-hidden="true">
            <path d="M50 125 150 101 250 77 350 53 450 29" stroke="#d7e3eb" stroke-width="2" vector-effect="non-scaling-stroke" />
          </svg>
          <ol class="rewards-value__level-list" role="list" aria-label="Niveles del programa">
            {levels.map((level, index) => (
              <li data-level={level.id} style={`--level-offset: ${(4 - index) * 24}px`}>
                <span class="rewards-value__medal" aria-hidden="true">
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                    <path d="m16 5 10 11-10 11L6 16 16 5Z" stroke-linejoin="round" />
                    <path d="m11 16 5-5 5 5M16 11v11" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span class="rewards-value__level-name">{level.name}</span>
              </li>
            ))}
          </ol>
        </div>
        <p class="rewards-value__level-note">Beneficios y cursos según tu nivel.</p>
      </div>

      <div class="rewards-value__content">
        <ul class="rewards-value__messages" role="list">
          {messages.map(message => (
            <li>
              <span class="rewards-value__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={message.icon} /></svg>
              </span>
              <div><h3>{message.title}</h3><p>{message.text}</p></div>
            </li>
          ))}
        </ul>
        <a class="rewards-value__join" href="/registro">Quiero ser parte <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .rewards-value { padding: 3.2rem 0; scroll-margin-top: 6rem; color: var(--public-navy, #041c2c); background: #f2f7fa; border-block: 1px solid #e4ecf1; }
  .rewards-value__heading { text-align: center; margin-bottom: 2rem; }
  .rewards-value__eyebrow { margin: 0 0 .65rem; font-size: .65rem; letter-spacing: .12em; line-height: 1.5; font-weight: 800; text-transform: uppercase; color: var(--public-blue, #004b87); }
  .rewards-value__heading h2 { margin: 0; font-size: clamp(1.5rem, 2.5vw, 2rem); line-height: 1.25; letter-spacing: -.035em; font-weight: 700; text-wrap: balance; }
  .rewards-value__heading h2 span { color: #386487; }
  .rewards-value__intro { margin: .75rem auto 0; max-width: 58ch; color: #536878; font-size: .86rem; line-height: 1.65; text-wrap: pretty; }
  .rewards-value__layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(1.8rem, 4vw, 3.5rem); align-items: center; }
  .rewards-value__levels { padding: 1.8rem 1.5rem 1.3rem; border: 1px solid #dce6ed; border-radius: 1.1rem; background: linear-gradient(150deg, #fff 40%, #f7fbfd); box-shadow: 0 12px 30px rgb(4 28 44 / 5%); min-width: 0; }
  .rewards-value__levels h3 { margin: 0; font-size: 1.05rem; line-height: 1.5; font-weight: 650; letter-spacing: -.025em; }
  .rewards-value__path { position: relative; margin: 1.8rem 0 1.4rem; }
  .rewards-value__connector { position: absolute; inset: 0; width: 100%; height: 170px; }
  .rewards-value__level-list { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); padding: 0; margin: 0; list-style: none; gap: 0; position: relative; }
  .rewards-value__level-list li { display: flex; align-items: center; flex-direction: column; gap: .75rem; padding-top: var(--level-offset); min-width: 0; color: var(--level-ink); }
  .rewards-value [data-level="BRONZE"] { --level-ink: #85502c; --level-tint: #faf0e7; --level-edge: #d9b69a; }
  .rewards-value [data-level="SILVER"] { --level-ink: #536477; --level-tint: #edf1f5; --level-edge: #b8c5d1; }
  .rewards-value [data-level="GOLD"] { --level-ink: #805c07; --level-tint: #fff5da; --level-edge: #dfc783; }
  .rewards-value [data-level="PLATINUM"] { --level-ink: #356761; --level-tint: #e6f5f4; --level-edge: #a4c8c3; }
  .rewards-value [data-level="TITANIUM"] { --level-ink: #384c68; --level-tint: #e9edf3; --level-edge: #9aacc3; }
  .rewards-value__medal { display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%; border: 1px solid var(--level-edge); background: linear-gradient(140deg, #fff, var(--level-tint) 70%); box-shadow: inset 0 0 0 4px #ffffff90, 0 5px 10px rgb(4 28 44 / 5%); }
  .rewards-value__medal svg { width: 29px; height: 29px; }
  .rewards-value__level-name { font-size: .72rem; font-weight: 700; line-height: 1.5; }
  .rewards-value__level-note { margin: 0; padding-top: 1rem; border-top: 1px solid #e3ebf0; color: #536878; font-size: .74rem; line-height: 1.6; }
  .rewards-value__messages { list-style: none; padding: 0; margin: 0; }
  .rewards-value__messages li { display: flex; align-items: flex-start; gap: .9rem; padding: 1.1rem 0; }
  .rewards-value__messages li:first-child { padding-top: 0; }
  .rewards-value__messages li + li { border-top: 1px solid #dbe5ec; }
  .rewards-value__messages h3 { margin: 0 0 .35rem; font-size: .96rem; line-height: 1.5; font-weight: 700; letter-spacing: -.02em; }
  .rewards-value__messages p { margin: 0; color: #536878; font-size: .8rem; line-height: 1.7; max-width: 43ch; }
  .rewards-value__icon { display: grid; place-items: center; flex: 0 0 36px; width: 36px; height: 36px; border-radius: .65rem; background: #e1f1f9; color: #004b87; }
  .rewards-value__icon svg { width: 20px; height: 20px; }
  .rewards-value__join { display: inline-flex; align-items: center; justify-content: center; gap: .85rem; min-height: 44px; margin: .5rem 0 0 3.15rem; padding: .75rem 1rem; border: 1px solid #004b87; border-radius: .65rem; background: #004b87; color: #fff; font-size: .8rem; font-weight: 700; text-decoration: none; box-shadow: 0 5px 12px rgb(0 75 135 / 10%); }
  .rewards-value__join:hover { background: #043957; border-color: #043957; color: #fff; }
  .rewards-value__join:focus-visible { outline: 2px solid #004b87; outline-offset: 4px; }
  @media(max-width: 900px) {
    .rewards-value__layout { grid-template-columns: 1fr; max-width: 36rem; margin-inline: auto; gap: 1.75rem; }
    .rewards-value__levels { padding: 1.5rem; }
  }
  @media(max-width: 480px) {
    .rewards-value { padding: 2.4rem 0; }
    .rewards-value__heading { margin-bottom: 1.5rem; }
    .rewards-value__levels { padding: 1.25rem; }
    .rewards-value__levels h3 { font-size: .96rem; }
    .rewards-value__path { margin: 1.2rem 0; }
    .rewards-value__connector { display: none; }
    .rewards-value__level-list { grid-template-columns: 1fr; gap: .6rem; }
    .rewards-value__level-list::before { content: ''; position: absolute; top: 20px; bottom: 20px; left: 19px; width: 2px; background: #d7e3eb; }
    .rewards-value__level-list li { flex-direction: row; gap: .9rem; padding: 0; position: relative; }
    .rewards-value__medal { width: 40px; height: 40px; }
    .rewards-value__medal svg { width: 22px; height: 22px; }
    .rewards-value__level-name { font-size: .8rem; }
    .rewards-value__join { margin-left: 0; width: 100%; }
  }
</style>
