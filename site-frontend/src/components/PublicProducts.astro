---
const products = [
  { id: "skandia", name: "Skandia", description: "Ahorro y planeación para tus metas.", logo: "/images/products/skandia.svg", width: 960, height: 200 },
  { id: "qualitas", name: "Quálitas", description: "Protección para tu auto.", logo: "/images/products/qualitas.png", width: 322, height: 108 },
  { id: "modalidad", name: "Modalidad 40", description: "Orientación para tu retiro.", logo: null, width: 0, height: 0 },
  { id: "infinity", name: "Infinity", description: "Alternativas para tus objetivos de inversión.", logo: null, width: 0, height: 0 },
];
---

<section id="productos" class="public-products" aria-labelledby="public-products-title">
  <div class="shell">
    <header class="public-products__heading">
      <span>Soluciones Carobra</span>
      <h2 id="public-products-title">Conoce lo que puedes contratar</h2>
      <p>Opciones para tus metas, tu tranquilidad y tu futuro.</p>
    </header>
    <ul class="public-products__grid">
      {products.map((product) => (
        <li>
          <a class:list={["public-offer", `public-offer--${product.id}`]} href="/registro" aria-label={`${product.name}: ir al registro para conocer esta solución`}>
            <h3 class="public-offer__mark">
              {product.logo ? (
                <img src={product.logo} alt={product.name} width={product.width} height={product.height} loading="lazy" decoding="async" />
              ) : product.id === "modalidad" ? (
                <span class="public-offer__service">Modalidad <strong>40<span aria-hidden="true">.</span></strong></span>
              ) : (
                <span class="public-offer__name">{product.name}</span>
              )}
            </h3>
            <p>{product.description}<span class="public-offer__arrow" aria-hidden="true">↗</span></p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .public-products {
    padding: 3.5rem 0;
    background: #fff;
    scroll-margin-top: 6rem;
  }

  .public-products__heading { margin-bottom: 1.65rem; }
  .public-products__heading > span { color: #004b87; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .public-products__heading h2 { margin: 0.5rem 0 0.65rem; color: #041c2c; font-size: clamp(1.65rem, 2.6vw, 2.25rem); font-weight: 700; line-height: 1.2; letter-spacing: -0.035em; }
  .public-products__heading p { margin: 0; color: #536878; font-size: 0.9rem; line-height: 1.6; }

  .public-products__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .public-products__grid > li { min-width: 0; }
  .public-offer--skandia { --offer-tint: #f2faef; --offer-accent: #008545; }
  .public-offer--qualitas { --offer-tint: #f7f2fa; --offer-accent: #682e79; }
  .public-offer--modalidad { --offer-tint: #eef8fd; --offer-accent: #004b87; }
  .public-offer--infinity { --offer-tint: #f4f7fa; --offer-accent: #004b87; }

  .public-offer {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.35rem 1.2rem 1rem;
    border: 1px solid #d9e4ec;
    border-radius: 0.9rem;
    background: linear-gradient(180deg, var(--offer-tint), #fff);
    color: #041c2c;
    box-shadow: 0 4px 14px rgb(4 28 44 / 3%);
    text-decoration: none;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .public-offer:hover { border-color: var(--offer-accent); box-shadow: 0 8px 24px rgb(4 28 44 / 8%); }
  .public-offer:focus-visible { outline: 3px solid #004b87; outline-offset: 4px; }
  .public-offer__mark { display: flex; align-items: center; justify-content: center; min-height: 5rem; margin: 0 0 1rem; }
  .public-offer__mark img { width: 100%; max-width: 180px; height: auto; max-height: 64px; object-fit: contain; }
  .public-offer__service { display: flex; align-items: center; gap: 0.3rem; color: #004b87; font-size: 1.1rem; font-weight: 650; letter-spacing: -0.04em; }
  .public-offer__service strong { font-size: 3rem; font-weight: 800; line-height: 1; letter-spacing: -0.07em; }
  .public-offer__service strong > span { color: #00a3e0; }
  .public-offer__name { font-size: 1.9rem; font-weight: 650; letter-spacing: -0.035em; }
  .public-offer p { display: flex; align-items: center; gap: 0.7rem; min-height: 3.4rem; margin: auto 0 0; padding-top: 0.9rem; border-top: 1px solid #e0e9ef; color: #536878; font-size: 0.78rem; font-weight: 500; line-height: 1.55; }
  .public-offer__arrow { margin-left: auto; color: var(--offer-accent); font-size: 1.1rem; flex-shrink: 0; }

  @media (max-width: 900px) {
    .public-products__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 520px) {
    .public-products { padding: 2.5rem 0; }
    .public-products__grid { gap: 0.75rem; }
    .public-offer { padding: 1rem 0.8rem; }
    .public-offer__mark { min-height: 4rem; }
    .public-offer__service { font-size: 0.9rem; }
    .public-offer__service strong { font-size: 2.45rem; }
    .public-offer__name { font-size: 1.65rem; }
  }

  @media (max-width: 359px) {
    .public-products__grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .public-offer { transition: none; }
  }
</style>
