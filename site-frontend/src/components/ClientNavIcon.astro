---
interface Props {
  name: "home" | "benefits" | "earn" | "courses" | "products" | "activity" | "help";
}

const { name } = Astro.props as Props;
---

<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {name === "home" && <><path d="m4 10.5 8-6.5 8 6.5" /><path d="M6.5 9.5V20h11V9.5" /><path d="M10 20v-6h4v6" /></>}
  {name === "benefits" && <><path d="M4 9h16v11H4z" /><path d="M12 9v11M3 6.5h18V9H3z" /><path d="M12 6.5H7.8a2.3 2.3 0 1 1 2.3-2.3C10.1 5.5 12 6.5 12 6.5Zm0 0h4.2a2.3 2.3 0 1 0-2.3-2.3C13.9 5.5 12 6.5 12 6.5Z" /></>}
  {name === "earn" && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5v9M7.5 12h9" /></>}
  {name === "courses" && <><path d="M4.5 5.5h6.2c.8 0 1.3.5 1.3 1.3V20c0-1-.8-1.8-1.8-1.8H4.5z" /><path d="M19.5 5.5h-6.2c-.8 0-1.3.5-1.3 1.3V20c0-1 .8-1.8 1.8-1.8h5.7z" /></>}
  {name === "products" && <><path d="M4 8.5h16V20H4z" /><path d="M8 8.5V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2.5M4 12.5h16" /></>}
  {name === "activity" && <><path d="M4 12a8 8 0 1 0 2.35-5.65L4 8.7" /><path d="M4 4.5v4.2h4.2M12 7.5V12l3 2" /></>}
  {name === "help" && <><circle cx="12" cy="12" r="8.5" /><path d="M9.7 9.4a2.5 2.5 0 1 1 3.4 2.35c-.75.35-1.1.8-1.1 1.55v.35" /><path d="M12 17.25h.01" /></>}
</svg>

<style>
  svg { width: 1rem; height: 1rem; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
</style>
