---
import previews from '../data/public-learning.json';
import {courseLevels} from '../lib/courses';
const spaces = [{id: 'cursos', title: 'Cursos'}, {id: 'bienestar', title: 'Bienestar'}];
---

<section id="aprendizaje" class="learning-preview" aria-labelledby="learning-preview-title" data-learning-preview>
  <div class="shell">
    <header class="learning-preview__header">
      <div>
        <p class="learning-preview__eyebrow">Cursos y bienestar</p>
        <h2 id="learning-preview-title">Aprende algo nuevo.<br /><span>Dedica tiempo a ti.</span></h2>
        <p class="learning-preview__intro">Conocimientos para crecer. Contenidos para cuidarte.</p>
      </div>
      <div class="learning-preview__tabs" data-learning-tabs aria-label="Explora cursos y bienestar">
        {spaces.map(space => <a id={`learning-tab-${space.id}`} href={`#learning-panel-${space.id}`} data-learning-tab={space.id}>{space.title}</a>)}
      </div>
    </header>

    {spaces.map(space => (
      <div class="learning-preview__group" data-learning-group={space.id}>
        <h3 class="learning-preview__group-title">{space.title}</h3>
        <div class="learning-preview__roll">
          <button class="learning-preview__arrow" type="button" data-learning-prev hidden disabled
            aria-label={`Ver ${space.id === 'cursos' ? 'cursos' : 'contenidos de bienestar'} anteriores`} aria-controls={`learning-panel-${space.id}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m14 6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <div id={`learning-panel-${space.id}`} class="learning-preview__viewport" data-learning-viewport
            tabindex="0" role="group" aria-label={`Selección de ${space.title.toLowerCase()}`} aria-describedby="learning-preview-instructions">
            <ul class="learning-preview__list" role="list">
              {previews.filter(item => item.space === space.id).map(item => (
                <li class="learning-preview__card">
                  <div class="learning-preview__cover">
                    <svg class="learning-preview__placeholder" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path d="M24 14c-5-4-11-5-17-4v25c6-1 12 0 17 4m0-25c5-4 11-5 17-4v25c-6-1-12 0-17 4V14Z" stroke-linejoin="round" />
                    </svg>
                    <img src={item.image} alt="" width="640" height="360" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  </div>
                  <div class="learning-preview__copy">
                    <div class="learning-preview__meta">
                      <span>{item.category}</span>
                      <span class="learning-preview__level" data-level={item.minimumLevel}>Desde {courseLevels[item.minimumLevel]}</span>
                    </div>
                    <h3>{item.title}</h3>
                  </div>
                </li>
              ))}
            </ul>
          </div>
          <button class="learning-preview__arrow" type="button" data-learning-next hidden
            aria-label={`Ver más ${space.id === 'cursos' ? 'cursos' : 'contenidos de bienestar'}`} aria-controls={`learning-panel-${space.id}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m10 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </div>
      </div>
    ))}

    <p id="learning-preview-instructions" class="learning-preview__sr-only">Desliza para explorar. En la lista puedes usar las flechas izquierda y derecha, Inicio o Fin.</p>
    <footer class="learning-preview__footer">
      <p>Una muestra de lo que te espera en Rewards.<br /><span>Cursos según tu nivel. Bienestar desde Bronce. Acceso con cuenta activa.</span></p>
      <a class="learning-preview__join" href="/registro">Únete a Rewards <span aria-hidden="true">→</span></a>
    </footer>
  </div>
</section>

<style>
  .learning-preview { padding: 3rem 0; background: #fff; scroll-margin-top: 6rem; color: #041c2c; }
  .learning-preview [hidden] { display: none !important; }
  .learning-preview__header { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.1rem; margin-bottom: 1.2rem; }
  .learning-preview__eyebrow { margin: 0 0 .6rem; font-size: .68rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #004b87; }
  .learning-preview__header h2 { margin: 0; font-size: clamp(1.45rem, 2.4vw, 1.85rem); line-height: 1.22; letter-spacing: -.035em; font-weight: 700; }
  .learning-preview__header h2 span { color: #386487; }
  .learning-preview__intro { margin: .65rem 0 0; color: #536878; font-size: .84rem; line-height: 1.6; }
  .learning-preview__tabs { display: flex; flex-shrink: 0; align-items: center; gap: .25rem; padding: .3rem; border: 1px solid #dae6ee; border-radius: 999px; background: #f3f8fb; }
  .learning-preview__tabs a { display: grid; place-items: center; min-height: 44px; padding: .65rem 1.4rem; border-radius: 999px; font-size: .81rem; font-weight: 700; color: #436175; text-decoration: none; transition: none; }
  .learning-preview__tabs a:hover { color: #004b87; background: #e3f2f9; }
  .learning-preview__tabs a[aria-selected="true"] { background: #004b87; color: white; box-shadow: 0 3px 10px #004b8715; }
  .learning-preview__group + .learning-preview__group { margin-top: 1.5rem; }
  .learning-preview__group-title { font-size: 1rem; }
  [data-learning-ready] .learning-preview__group-title { display: none; }
  [data-learning-ready] .learning-preview__group { margin-top: 0; }
  .learning-preview__roll { display: grid; align-items: center; gap: .7rem; min-width: 0; }
  [data-learning-ready] .learning-preview__roll { grid-template-columns: 44px minmax(0, 1fr) 44px; }
  .learning-preview__viewport { overflow-x: auto; min-width: 0; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; border-radius: .8rem; scrollbar-width: thin; scrollbar-color: #b8cddd transparent; scroll-margin-top: 6rem; }
  [data-learning-ready] .learning-preview__viewport { scrollbar-width: none; }
  [data-learning-ready] .learning-preview__viewport::-webkit-scrollbar { display: none; }
  .learning-preview__list { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 2rem) / 3); gap: 1rem; list-style: none; padding: .3rem 0; margin: 0; }
  .learning-preview__card { scroll-snap-align: start; min-width: 0; overflow: hidden; background: #fff; border: 1px solid #dbe5ec; border-radius: .85rem; }
  .learning-preview__cover { display: grid; place-items: center; position: relative; aspect-ratio: 16 / 9; background: linear-gradient(130deg, #e7f3f9, #f4f8fb); overflow: hidden; }
  .learning-preview__cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .learning-preview__placeholder { width: 48px; height: 48px; color: #7297ad; }
  .learning-preview__copy { padding: .85rem 1rem 1rem; }
  .learning-preview__meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .4rem; color: #436175; font-size: .64rem; font-weight: 600; }
  .learning-preview__level { display: inline-flex; align-items: center; gap: .3rem; border-radius: 999px; padding: .25rem .45rem; font-size: .6rem; white-space: nowrap; background: #f2f5f7; color: #405460; }
  .learning-preview__level::before { content: ''; width: .35rem; height: .35rem; border-radius: 50%; background: currentColor; }
  .learning-preview__level[data-level="BRONZE"] { background: #faf0e7; color: #85502c; }
  .learning-preview__level[data-level="SILVER"] { background: #edf1f5; color: #536477; }
  .learning-preview__level[data-level="GOLD"] { background: #fff5da; color: #805c07; }
  .learning-preview__level[data-level="PLATINUM"] { background: #e6f5f4; color: #356761; }
  .learning-preview__level[data-level="TITANIUM"] { background: #e9edf3; color: #384c68; }
  .learning-preview__copy h3 { margin: .65rem 0 0; font-size: .94rem; font-weight: 700; line-height: 1.45; letter-spacing: -.015em; overflow-wrap: anywhere; }
  .learning-preview__arrow { width: 44px; height: 44px; padding: 0; place-items: center; border: 1px solid rgb(0 75 135 / 12%); border-radius: 50%; background: rgb(241 248 252 / 55%); color: #386487; backdrop-filter: blur(8px); box-shadow: 0 3px 12px rgb(4 28 44 / 4%); cursor: pointer; transition: background .18s; }
  .learning-preview__arrow:not([hidden]) { display: grid; }
  .learning-preview__arrow svg { width: 22px; height: 22px; }
  .learning-preview__arrow:hover:not(:disabled) { background: #eaf5fb; }
  .learning-preview__arrow:disabled { opacity: .3; cursor: default; box-shadow: none; }
  .learning-preview__footer { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin: 1.25rem 3.45rem 0; }
  .learning-preview__footer p { margin: 0; font-size: .78rem; line-height: 1.7; color: #365269; }
  .learning-preview__footer p span { color: #5c7181; font-size: .69rem; }
  .learning-preview__join { display: inline-flex; align-items: center; gap: 1rem; flex-shrink: 0; padding: .75rem 1rem; min-height: 44px; border: 1px solid #c4d8e6; border-radius: .65rem; color: #004b87; font-size: .78rem; font-weight: 700; text-decoration: none; background: #f6fbfe; }
  .learning-preview__join:hover { background: #e3f3fb; border-color: #7eacc9; }
  .learning-preview a:focus-visible, .learning-preview button:focus-visible, .learning-preview__viewport:focus-visible { outline: 2px solid #004b87; outline-offset: 3px; }
  .learning-preview__sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media(max-width: 1000px) { .learning-preview__list { grid-auto-columns: calc((100% - 1rem) / 2); } }
  @media(max-width: 650px) {
    .learning-preview { padding: 2.4rem 0; }
    .learning-preview__header { gap: 1rem; }
    .learning-preview__list { grid-auto-columns: 100%; }
    .learning-preview__roll { gap: .3rem; }
    .learning-preview__footer { margin: 1.1rem 0 0; flex-direction: column; text-align: center; }
    .learning-preview__copy { padding: .75rem; }
    .learning-preview__copy h3 { font-size: .88rem; }
  }
  @media(prefers-reduced-motion: reduce) { .learning-preview__arrow { transition: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-learning-preview]').forEach(section => {
    if (section.dataset.learningReady) return;
    const tablist = section.querySelector<HTMLElement>('[data-learning-tabs]');
    const tabs = [...section.querySelectorAll<HTMLAnchorElement>('[data-learning-tab]')];
    const groups = [...section.querySelectorAll<HTMLElement>('[data-learning-group]')];
    if (!tablist || tabs.length !== groups.length) return;
    const refreshers: (() => void)[] = [];
    section.dataset.learningReady = 'true';
    tablist.setAttribute('role', 'tablist');

    groups.forEach((group, index) => {
      const viewport = group.querySelector<HTMLElement>('[data-learning-viewport]')!;
      const previous = group.querySelector<HTMLButtonElement>('[data-learning-prev]')!;
      const next = group.querySelector<HTMLButtonElement>('[data-learning-next]')!;
      tabs[index].setAttribute('role', 'tab');
      tabs[index].setAttribute('aria-controls', viewport.id);
      viewport.setAttribute('role', 'tabpanel');
      viewport.setAttribute('aria-labelledby', tabs[index].id);
      viewport.removeAttribute('aria-label');
      previous.hidden = next.hidden = false;
      const update = () => {
        if (group.hidden) return;
        previous.disabled = viewport.scrollLeft <= 2;
        next.disabled = viewport.scrollLeft >= viewport.scrollWidth - viewport.clientWidth - 2;
      };
      const move = (left: number, instant = false) => {
        viewport.scrollTo({left: Math.max(0, Math.min(left, viewport.scrollWidth - viewport.clientWidth)),
          behavior: instant || matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'});
        update();
      };
      const step = () => viewport.clientWidth + 16;
      previous.addEventListener('click', () => move(viewport.scrollLeft - step()));
      next.addEventListener('click', () => move(viewport.scrollLeft + step()));
      viewport.addEventListener('scroll', update, {passive: true});
      viewport.addEventListener('keydown', event => {
        if (event.altKey || event.ctrlKey || event.metaKey || event.target !== viewport) return;
        const targets: Record<string, number> = {ArrowLeft: viewport.scrollLeft - step(), ArrowRight: viewport.scrollLeft + step(), Home: 0, End: viewport.scrollWidth};
        if (!(event.key in targets)) return;
        event.preventDefault();
        move(targets[event.key], event.key === 'Home' || event.key === 'End');
      });
      new ResizeObserver(update).observe(viewport);
      refreshers.push(update);
    });

    const activate = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        groups[i].hidden = i !== index;
      });
      refreshers[index]();
      if (focus) tabs[index].focus({preventScroll: true});
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', event => {event.preventDefault(); activate(index);});
      tab.addEventListener('keydown', event => {
        if (event.altKey || event.ctrlKey || event.metaKey) return;
        const targets: Record<string, number> = {ArrowLeft: (index + tabs.length - 1) % tabs.length, ArrowRight: (index + 1) % tabs.length, Home: 0, End: tabs.length - 1, ' ': index};
        if (!(event.key in targets)) return;
        event.preventDefault();
        activate(targets[event.key], true);
      });
    });
    const hashIndex = groups.findIndex(group => `#learning-panel-${group.dataset.learningGroup}` === location.hash);
    activate(hashIndex >= 0 ? hashIndex : 0);
    section.querySelectorAll<HTMLImageElement>('.learning-preview__cover img').forEach(img => {
      const fallback = () => { img.hidden = true; };
      img.addEventListener('error', fallback, {once: true});
      if (img.complete && img.naturalWidth === 0) fallback();
    });
  });
</script>
