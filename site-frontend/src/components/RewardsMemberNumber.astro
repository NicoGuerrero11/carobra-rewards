---
import { memberNumber } from "../lib/rewards-member";
interface Props { rewardsId?: string | null; }
const number = memberNumber(Astro.props.rewardsId);
---
<rewards-member-number class="member-number">
  <div class="member-number__identity"><span>Número de socio Rewards</span><strong>{number?.display ?? "No disponible"}</strong></div>
  {number && <button type="button" data-copy={number.canonical} aria-label="Copiar Número de socio Rewards">Copiar <span aria-hidden="true">⧉</span></button>}
  <p class="member-number__feedback" role="status" aria-live="polite" aria-atomic="true">{!number && "Consulta Ayuda si necesitas tu número de socio."}</p>
  {number && <label class="member-number__manual" hidden>Copia tu número sin espacios<input readonly value={number.canonical} aria-label="Número de socio Rewards sin espacios" /></label>}
</rewards-member-number>
<script>
  class RewardsMemberNumber extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";
      const button = this.querySelector<HTMLButtonElement>("[data-copy]");
      const feedback = this.querySelector<HTMLElement>("[role=status]")!;
      const manual = this.querySelector<HTMLLabelElement>("label");
      const input = manual?.querySelector("input");
      let copying = false;
      button?.addEventListener("click", async () => {
        if (copying || !input || !manual) return;
        copying = true;
        button.disabled = true;
        feedback.textContent = "Copiando número…";
        let copied = false;
        try { await navigator.clipboard.writeText(button.dataset.copy!); copied = true; }
        catch {
          manual.hidden = false;
          input.focus();
          input.select();
          input.setSelectionRange(0, input.value.length);
          try { copied = document.execCommand("copy"); } catch { /* Manual selection remains available. */ }
        }
        manual.hidden = copied;
        feedback.textContent = copied ? "Número de socio copiado sin espacios." : "No pudimos copiar automáticamente. Selecciona y copia el número de abajo.";
        button.disabled = false;
        copying = false;
        if (copied) button.focus({ preventScroll: true });
      });
    }
  }
  if (!customElements.get("rewards-member-number")) customElements.define("rewards-member-number", RewardsMemberNumber);
</script>
<style>
  .member-number{display:flex;align-items:center;flex-wrap:wrap;gap:.35rem 1rem;margin:.5rem 0 1rem;color:#244f69;font-size:.78rem}.member-number__identity{display:flex;align-items:baseline;flex-wrap:wrap;gap:.3rem .75rem}.member-number__identity>span{color:#526d80}.member-number strong{font-size:.95rem;font-variant-numeric:tabular-nums;letter-spacing:.06em;white-space:nowrap}.member-number button{min-height:44px;padding:.45rem .8rem;border:1px solid #b8cdd8;border-radius:.7rem;background:#fff;font:inherit;font-weight:700;cursor:pointer}.member-number button:focus-visible,.member-number input:focus-visible{outline:3px solid #176f9e;outline-offset:3px}.member-number__feedback{flex-basis:100%;margin:0;font-size:.75rem}.member-number__feedback:empty{display:none}.member-number__manual{flex-basis:100%}.member-number__manual[hidden]{display:none}.member-number input{display:block;max-width:100%;padding:.5rem;border:1px solid #b8cdd8;border-radius:.4rem;font:inherit}
</style>
