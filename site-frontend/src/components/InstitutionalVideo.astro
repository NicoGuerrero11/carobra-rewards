---
const videoId = "BZD93x4dmt4";
const watchUrl = `https://www.youtube.com/watch?v=${videoId}`;
const embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&playsinline=1&rel=0&hl=es`;
---

<figure class="institutional-video" aria-label="Video institucional de Carobra" data-institutional-video data-embed-url={embedUrl}>
  <div class="institutional-video__frame" data-video-frame>
    <img
      src={`https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`}
      data-fallback-src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`}
      data-video-poster
      width="1280"
      height="720"
      alt=""
      loading="eager"
      decoding="async"
    />
    <button class="institutional-video__play" type="button" aria-label="Reproducir video institucional de Carobra" data-video-play hidden>
      <span class="institutional-video__play-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="m8 5 11 7-11 7z" /></svg>
      </span>
      <span class="institutional-video__play-label">Reproducir video</span>
    </button>
    <noscript>
      <a class="institutional-video__no-script" href={watchUrl} target="_blank" rel="noopener noreferrer">Ver video en YouTube ↗</a>
    </noscript>
  </div>
  <span class="sr-only" role="status" data-video-status></span>
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-institutional-video]").forEach((root) => {
    const frame = root.querySelector<HTMLElement>("[data-video-frame]");
    const button = root.querySelector<HTMLButtonElement>("[data-video-play]");
    const poster = root.querySelector<HTMLImageElement>("[data-video-poster]");
    const embedUrl = root.dataset.embedUrl;
    if (!frame || !button || !poster || !embedUrl) return;

    const fallbackPoster = () => {
      const fallback = poster.dataset.fallbackSrc;
      if (fallback) {
        delete poster.dataset.fallbackSrc;
        poster.src = fallback;
      } else {
        poster.hidden = true;
      }
    };
    poster.addEventListener("error", fallbackPoster);
    if (poster.complete && !poster.naturalWidth) fallbackPoster();

    button.hidden = false;
    button.addEventListener("click", () => {
      if (root.dataset.started) return;
      root.dataset.started = "true";
      const player = document.createElement("iframe");
      player.src = embedUrl;
      player.title = "Video institucional de Carobra";
      player.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      player.allowFullscreen = true;
      player.referrerPolicy = "strict-origin-when-cross-origin";
      frame.replaceChildren(player);
      player.focus({ preventScroll: true });
      const status = root.querySelector<HTMLElement>("[data-video-status]");
      if (status) status.textContent = "Reproductor de YouTube abierto.";
    });
  });
</script>

<style>
  .institutional-video {
    width: 100%;
    max-width: 40rem;
    min-width: 0;
    margin: 0 auto;
  }

  .institutional-video__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 200px;
    overflow: hidden;
    border-radius: 1.1rem;
    background: linear-gradient(125deg, #041c2c, #004b87);
    box-shadow:
      0 22px 44px -18px rgb(4 28 44 / 34%),
      0 8px 20px -12px rgb(0 75 135 / 22%),
      0 0 0 1px rgb(255 255 255 / 50%);
  }

  .institutional-video__frame > img,
  .institutional-video__frame > :global(iframe) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .institutional-video__frame > img {
    /* The approved thumbnail contains side bars; keep this crop off the player. */
    transform: scale(1.07);
  }

  .institutional-video__play,
  .institutional-video__no-script {
    position: absolute;
    inset: auto auto 0.9rem 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid rgb(255 255 255 / 45%);
    border-radius: 2rem;
    background: rgb(4 28 44 / 55%);
    backdrop-filter: blur(6px);
    color: #fff;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .institutional-video__play-icon {
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    place-items: center;
  }

  .institutional-video__play:hover { background: rgb(4 28 44 / 75%); }
  .institutional-video__play:focus-visible,
  .institutional-video__no-script:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .institutional-video [hidden] { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
</style>
