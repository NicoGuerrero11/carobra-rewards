---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Carobra Rewards | Registro y validación AFORE",
  description = "Registra tu cuenta de Carobra Rewards y consulta el estado de tu validación AFORE.",
} = Astro.props as Props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
