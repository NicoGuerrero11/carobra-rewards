---
import BaseLayout from "./BaseLayout.astro";
import ClientNavIcon from "../components/ClientNavIcon.astro";

interface NavItem {
  id: "home" | "benefits" | "earn" | "products" | "activity" | "help";
  label: string;
  href: string;
  activePaths: string[];
  icon: NavItem["id"];
}

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  sectionLabel?: string;
}

const {
  title = "Dashboard Cliente | Carobra",
  description = "Experiencia cliente con navegación lateral y flujo operativo claro.",
  currentPath = "/cliente",
  sectionLabel = "Cliente",
} = Astro.props as Props;

const navItems: NavItem[] = [
  { id: "home", label: "Inicio", href: "/cliente/recompensas", activePaths: ["/cliente/recompensas"], icon: "home" },
  { id: "benefits", label: "Beneficios", href: "/cliente/beneficios", activePaths: ["/cliente/beneficios", "/cliente/gift-cards", "/cliente/cursos"], icon: "benefits" },
  { id: "earn", label: "Ganar puntos", href: "/cliente/ganar-puntos", activePaths: ["/cliente/ganar-puntos"], icon: "earn" },
  { id: "products", label: "Productos", href: "/cliente/productos", activePaths: ["/cliente/productos"], icon: "products" },
  { id: "activity", label: "Actividad", href: "/cliente/activities", activePaths: ["/cliente/activities"], icon: "activity" },
  { id: "help", label: "Ayuda", href: "/cliente/ayuda", activePaths: ["/cliente/ayuda"], icon: "help" },
];

const mobileNavItems = navItems.filter((item) => item.id !== "help");
const unreadCount = Astro.locals.rewardsPortal?.notifications.unread_count ?? 0;

function isActive(item: NavItem) {
  return item.activePaths.some((path) => currentPath === path || currentPath.startsWith(`${path}/`));
}
---

<BaseLayout title={title} description={description}>
  <div id="client-shell" class="client-shell">
    <header class="client-shell__topnav">
      <div class="client-shell__topnav-inner">
        <div class="client-shell__left">
          <a href="/cliente/recompensas" class="client-shell__brand-link" aria-label="Carobra inicio cliente">
            <img
              src="/images/carobra-logo-horizontal-cropped.png"
              alt="Carobra Consultores Especializados"
              class="client-shell__brand-logo"
              loading="eager"
              decoding="async"
            />
          </a>
        </div>

        <nav class:list={["client-shell__nav", "client-shell__nav--center"]} aria-label={`Navegación cliente · ${sectionLabel}`}>
          {
            navItems.map((item) =>
              isActive(item) ? (
                <span class:list={["client-shell__nav-link", "is-active"]} aria-current="page">
                  <span class="client-shell__nav-icon"><ClientNavIcon name={item.icon} /></span>
                  <span>{item.label}</span>
                </span>
              ) : (
                <a href={item.href} class="client-shell__nav-link">
                  <span class="client-shell__nav-icon"><ClientNavIcon name={item.icon} /></span>
                  <span>{item.label}</span>
                </a>
              ),
            )
          }
        </nav>

        <div class="client-shell__right">
          <a
            class:list={["client-shell__notification-link", currentPath === "/cliente/notificaciones" && "is-active"]}
            href="/cliente/notificaciones"
            aria-label={unreadCount > 0 ? `Ver notificaciones, ${unreadCount} sin leer` : "Ver notificaciones"}
            aria-current={currentPath === "/cliente/notificaciones" ? "page" : undefined}
            title="Notificaciones"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6.8 10.2a5.2 5.2 0 0 1 10.4 0c0 5.8 2.3 6.3 2.3 6.3H4.5s2.3-.5 2.3-6.3Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M10 19h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
            </svg>
            {unreadCount > 0 && <span class="client-shell__notification-count" aria-hidden="true">{unreadCount > 99 ? "99+" : unreadCount}</span>}
          </a>
          <div id="client-shell-user" class="client-shell__user">
            <button id="client-shell-user-toggle" class="client-shell__user-toggle" type="button" aria-expanded="false" aria-label="Abrir menú de cuenta">
              <span class="client-shell__user-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" role="presentation">
                  <circle cx="12" cy="8" r="3.4" stroke="currentColor" stroke-width="1.7"></circle>
                  <path d="M5.6 18.2C6.9 15.8 9.2 14.6 12 14.6C14.8 14.6 17.1 15.8 18.4 18.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                </svg>
              </span>
              <span class="client-shell__user-label">Cuenta</span>
            </button>

            <div id="client-shell-user-menu" class="client-shell__user-menu" hidden>
              <a class="client-shell__user-menu-link" href="/cliente/perfil">Mi cuenta</a>
              <a class="client-shell__user-menu-link" href="/cliente/ayuda">Ayuda y soporte</a>
              <button id="logout" class="client-shell__user-menu-button" type="button">Cerrar sesión</button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <nav class="client-shell__bottom-nav" aria-label={`Navegación móvil cliente · ${sectionLabel}`}>
          {
            mobileNavItems.map((item) =>
              isActive(item) ? (
                <span class:list={["client-shell__bottom-link", "is-active"]} aria-current="page">
                  <span class="client-shell__nav-icon"><ClientNavIcon name={item.icon} /></span>
                  <span>{item.label}</span>
                </span>
              ) : (
                <a href={item.href} class="client-shell__bottom-link">
                  <span class="client-shell__nav-icon"><ClientNavIcon name={item.icon} /></span>
                  <span>{item.label}</span>
                </a>
              ),
            )
          }
    </nav>

    <div class="client-shell__content">
      <slot />
    </div>
  </div>

  <script>
    const userMenuRoot = document.querySelector<HTMLElement>("#client-shell-user");
    const userMenuToggle = document.querySelector<HTMLButtonElement>("#client-shell-user-toggle");
    const userMenu = document.querySelector<HTMLElement>("#client-shell-user-menu");

    const closeUserMenu = () => {
      if (!userMenu || !userMenuToggle) {
        return;
      }

      userMenu.hidden = true;
      userMenuToggle.setAttribute("aria-expanded", "false");
    };

    if (userMenuRoot && userMenuToggle && userMenu) {
      userMenuToggle.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();

        const shouldOpen = userMenu.hidden;
        if (!shouldOpen) {
          closeUserMenu();
          return;
        }

        userMenu.hidden = false;
        userMenuToggle.setAttribute("aria-expanded", "true");
      });

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Node)) {
          return;
        }

        if (!userMenuRoot.contains(target)) {
          closeUserMenu();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeUserMenu();
        }
      });
    }
  </script>
</BaseLayout>
